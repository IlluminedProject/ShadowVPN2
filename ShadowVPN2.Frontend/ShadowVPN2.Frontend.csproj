<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <AssemblyName>ui</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <PackageReference Include="Blazilla" Version="2.4.2"/>
    <PackageReference Include="QRCoder" Version="1.8.1"/>
    <ProjectReference Include="..\ShadowVPN2.Contracts\ShadowVPN2.Contracts.csproj"/>
    <PackageReference Include="RandomFriendlyNameGenerator" Version="1.0.9"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\docker-compose.ghcr.yml" LogicalName="ShadowVPN2.Frontend.NodeCompose.yaml"/>
  </ItemGroup>
</Project>
