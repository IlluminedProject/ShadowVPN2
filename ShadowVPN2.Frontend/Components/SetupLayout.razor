@inherits LayoutComponentBase

<HeadContent>
    <link rel="stylesheet" href="_content/ShadowVPN2.Frontend/css/app.css"/>
</HeadContent>

<div class="d-flex align-items-center justify-content-center vh-100 bg-light">
    <div class="card shadow-sm p-4" style="max-width: 600px; width: 100%;">
        <h2>ShadowVPN2 Setup</h2>
        <p class="muted">Welcome! Let's get your VPN server configured.</p>
        @Body
