@implements IDisposable
@inject IApplicationUpdateService Updates

@if (_available)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link text-warning" href="/admin/updates">
            <span class="bi bi-arrow-up-circle-fill" aria-hidden="true"></span> Update available
        </NavLink>
    </div>
}

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private bool _available;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Updates.CheckAsync(_cancellation.Token);
            if (!_cancellation.IsCancellationRequested)
                _available = response.Enabled && response.UpdateAvailable;
        }
        catch (ApplicationServiceException)
        {
            _available = false;
        }
    }

    public void Dispose()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
    }

}
