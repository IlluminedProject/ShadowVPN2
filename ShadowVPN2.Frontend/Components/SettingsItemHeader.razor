<div class="settings-item-header">
    <div class="settings-item-accent bg-primary"></div>
    <div class="settings-item-heading">
        <div class="form-check form-switch mb-0">
            <InputCheckbox id="@_enabledId" class="form-check-input" @bind-Value:get="Enabled"
                           @bind-Value:set="EnabledChanged" disabled="@Busy"/>
            <label class="visually-hidden" for="@_enabledId">Enable @Title</label>
        </div>
        <h2>@Title</h2>
        <div class="settings-item-publication form-switch" title="Publish direct connection in subscriptions">
            <InputCheckbox id="@_publishDirectId" class="form-check-input" @bind-Value:get="PublishDirectConnection"
                           @bind-Value:set="PublishDirectConnectionChanged" disabled="@Busy"/>
            <label class="visually-hidden" for="@_publishDirectId">Publish direct @Title connection in
                subscriptions</label>
        </div>
        <div class="settings-item-port">
            @if (RangeAllowed)
            {
                <label class="visually-hidden" for="@_portId">Port or range for @Title</label>
                <InputPortBinding id="@_portId" class="form-control form-control-sm" @bind-Value:get="PortBinding"
                                  @bind-Value:set="PortBindingChanged" disabled="@Busy"
                                  title="Port (4443) or range (4443-4450)"/>
                <ValidationMessage For="() => PortBinding"/>
            }
            else if (AllowUnsetPort)
            {
                <label class="visually-hidden" for="@_portId">Port for @Title</label>
                <InputNumber id="@_portId" class="form-control form-control-sm" @bind-Value="OptionalPort"
                             disabled="@Busy" min="1" max="65535" required placeholder="Port"/>
            }
            else
            {
                <label class="visually-hidden" for="@_portId">Port for @Title</label>
                <InputNumber id="@_portId" class="form-control form-control-sm" @bind-Value:get="ListenPort"
                             @bind-Value:set="ListenPortChanged" disabled="@Busy" min="1" max="65535"/>
                <ValidationMessage For="() => ListenPort"/>
            }
        </div>
        <button class="btn btn-sm btn-outline-danger ms-auto" type="button"
                aria-label="Remove @Title" title="Remove @Title" @onclick="OnRemove" disabled="@Busy">
            <span class="bi bi-trash" aria-hidden="true"></span>
        </button>
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public bool RangeAllowed { get; set; }
    [Parameter] public int ListenPort { get; set; }
    [Parameter] public bool AllowUnsetPort { get; set; }

    private int? OptionalPort
    {
        get => ListenPort == 0 ? null : ListenPort;
        set => ListenPortChanged.InvokeAsync(value ?? 0);
    }
    [Parameter] public EventCallback<int> ListenPortChanged { get; set; }
    [Parameter] public PortBinding PortBinding { get; set; }
    [Parameter] public EventCallback<PortBinding> PortBindingChanged { get; set; }
    [Parameter] public bool Enabled { get; set; }
[Parameter] public bool PublishDirectConnection { get; set; } = true;
[Parameter] public EventCallback<bool> PublishDirectConnectionChanged { get; set; }
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public bool Busy { get; set; }
    private readonly string _enabledId = $"enabled-{Guid.NewGuid():N}";
private readonly string _publishDirectId = $"publish-direct-{Guid.NewGuid():N}";
    private readonly string _portId = $"port-{Guid.NewGuid():N}";
}
