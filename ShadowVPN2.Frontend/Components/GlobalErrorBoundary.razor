@inherits ErrorBoundary
@inject ILogger<GlobalErrorBoundary> Logger

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div class="alert alert-danger" role="alert">
        <h1 class="h4">Something went wrong</h1>
        <p>The operation could not be completed. Try again or reload the page.</p>
        <button type="button" class="btn btn-outline-secondary" @onclick="Recover">Try again</button>

        <ExceptionDetails Exception="CurrentException"/>
    </div>
}

@code {

    protected override Task OnErrorAsync(Exception exception)
    {
        Logger.LogError(exception, "Unhandled exception in Blazor component");
        return Task.CompletedTask;
    }

}
