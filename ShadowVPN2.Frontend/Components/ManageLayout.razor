@inherits LayoutComponentBase
@layout MainLayout
@inject IAuthApplicationService AuthApplicationService
@inject NavigationManager Navigation

<h1>Manage your account</h1>
@if (_options is null)
{
    <p role="status">Loading account settings...</p>
}
else
{
    <CascadingValue Value="_options" IsFixed="true">
        <div class="row g-4">
            <div class="col-lg-3">
                <nav class="nav flex-column app-subnav" aria-label="Account settings">
                    <NavLink class="nav-link" href="/Account/Manage" Match="NavLinkMatch.All">Profile</NavLink>
                    @if (_options.LocalLoginEnabled)
                    {
                        <NavLink class="nav-link" href="/Account/Manage/Email">Email</NavLink>
                        <NavLink class="nav-link" href="/Account/Manage/ChangePassword">Password</NavLink>
                    }
                    @if (_options.ExternalProviders.Count > 0)
                    {
                        <NavLink class="nav-link" href="/Account/Manage/ExternalLogins">External logins</NavLink>
                    }
                    @if (_options.LocalLoginEnabled)
                    {
                        <NavLink class="nav-link" href="/Account/Manage/TwoFactorAuthentication">Two-factor
                            authentication
                        </NavLink>
                        <NavLink class="nav-link" href="/Account/Manage/Passkeys">Passkeys</NavLink>
                    }
                    <NavLink class="nav-link" href="/Account/Manage/PersonalData">Personal data</NavLink>
                </nav>
            </div>
            <div class="col-lg-9">
                <div class="settings-frame">
                    @if (!_options.LocalLoginEnabled && IsLocalAccountPage)
                    {
                        <p class="text-body-secondary">Local sign-in is disabled. Manage your sign-in credentials and
                            authentication security with your identity provider.</p>
                    }
                    else
                    {
                        @Body
                    }
                </div>
            </div>
        </div>
    </CascadingValue>
}

@code {
    private AuthOptionsResponse? _options;

    private bool IsLocalAccountPage
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            return path.Split('/').ElementAtOrDefault(3)?.ToLowerInvariant() is
                    "email" or "changepassword" or "setpassword" or "twofactorauthentication" or
                    "enableauthenticator" or "disable2fa" or "resetauthenticator" or
                    "generaterecoverycodes" or "passkeys" or "renamepasskey";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _options = await AuthApplicationService.GetOptionsAsync(new Uri(Navigation.Uri).Host);
    }

}
