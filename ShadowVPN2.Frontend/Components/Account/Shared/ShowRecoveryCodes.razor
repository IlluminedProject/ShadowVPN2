<StatusMessage Message="@StatusMessage"/>
<h2>Recovery codes</h2>
@if (RecoveryCodes.Length == 0)
{
    <p class="text-body-secondary">No recovery codes are available.</p>
}
else
{
    <div class="alert alert-warning" role="alert">
        <p><strong>Put these codes in a safe place.</strong></p>
        <p class="mb-0">If you lose your device and do not have the recovery codes, you will lose access to your
            account.</p>
    </div>
    <ul class="list-unstyled d-flex flex-column gap-2" aria-label="Recovery codes">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <li><code class="recovery-code text-break">@recoveryCode</code></li>
        }
    </ul>
}

@code {
    [Parameter] public string[] RecoveryCodes { get; set; } = [];

    [Parameter] public string? StatusMessage { get; set; }
}
