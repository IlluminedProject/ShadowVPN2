@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var statusClass = Severity == StatusSeverity.Error ? "danger" : Severity == StatusSeverity.Warning ? "warning" : "success";
    var role = Severity == StatusSeverity.Error ? "alert" : "status";
    <div class="alert alert-@statusClass" role="@role">@DisplayMessage</div>
}

@code {
    private string? _messageFromCookie;

    [Parameter] public string? Message { get; set; }
    [Parameter] public StatusSeverity Severity { get; set; } = StatusSeverity.Success;

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? DisplayMessage => Message ?? _messageFromCookie;

    protected override void OnInitialized()
    {
        if (HttpContext is null) return;
        _messageFromCookie = HttpContext.Request.Cookies[IdentityStatusCookie.Name];
        if (_messageFromCookie is not null && !HttpContext.Response.HasStarted)
        {
            HttpContext.Response.Cookies.Delete(IdentityStatusCookie.Name);
        }
    }

    public enum StatusSeverity
    {
        Success,
        Warning,
        Error
    }

}

