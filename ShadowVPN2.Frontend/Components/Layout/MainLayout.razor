@inherits LayoutComponentBase

<HeadContent>
    <link rel="stylesheet" href="_content/ShadowVPN2.Frontend/css/app.css"/>
</HeadContent>

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <article class="content">
            <GlobalErrorBoundary>
                @Body
            </GlobalErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
