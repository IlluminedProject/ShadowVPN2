@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">ShadowVPN2</a>
    </div>
</div>

<button type="button" class="navbar-toggler" aria-label="Navigation menu" aria-controls="app-navigation"
        aria-expanded="@_expanded" @onclick="() => _expanded = !_expanded">
    <span class="bi bi-list" aria-hidden="true"></span>
</button>

<div id="app-navigation" class="nav-scrollable @(_expanded ? "is-expanded" : null)">
    <nav class="nav flex-column" aria-label="Main navigation">
        <AuthorizeView Context="authContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                        <span class="bi bi-person-vcard-fill" aria-hidden="true"></span> Devices
                    </NavLink>
                </div>
                <AuthorizeView Policy="Nodes.View">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/nodes">
                            <span class="bi bi-hdd-network-fill" aria-hidden="true"></span> Nodes
                        </NavLink>
                    </div>
                </AuthorizeView>
                <AuthorizeView Policy="Settings.View">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/admin/protocols">
                            <span class="bi bi-diagram-3-fill" aria-hidden="true"></span> Protocols
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/admin/transports">
                            <span class="bi bi-shuffle" aria-hidden="true"></span> Transports
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/admin/settings">
                            <span class="bi bi-gear-fill" aria-hidden="true"></span> Settings
                        </NavLink>
                    </div>
                </AuthorizeView>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/Account/Manage">
                        <span class="bi bi-person-fill" aria-hidden="true"></span> @authContext.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="/api/auth/logout" method="post">
                        <AntiforgeryToken/>
                        <input type="hidden" name="ReturnUrl" value="@_currentUrl"/>
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/Account/Login">
                        <span class="bi bi-person-badge" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? _currentUrl;
    private bool _expanded;

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        _expanded = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}
