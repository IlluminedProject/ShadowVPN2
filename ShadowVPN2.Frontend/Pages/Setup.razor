@page "/setup"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout SetupLayout
@inject ISetupApplicationService SetupApi
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject ILogger<Setup> Logger
@using System.Net
@using System.Net.Sockets
@using RandomFriendlyNameGenerator
@implements IAsyncDisposable

<PageTitle>Initial setup - ShadowVPN2</PageTitle>

<div>
    <div class="page-header">
        <h1>Initial setup</h1>
        <span class="text-body-secondary">Step @_step of 3</span>
    </div>
    <div class="progress mb-4" role="progressbar" aria-label="Setup progress"
         aria-valuenow="@(_step == 3 ? 100 : (_step - 1) * 50)" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar"
             style="width: @(_step == 3 ? 100 : (_step - 1) * 50)%">@(_step == 3 ? 100 : (_step - 1) * 50)%
        </div>
    </div>
    @if (_step == 1)
    {
        <section>
            <h2>Network information</h2>
            <p class="text-body-secondary">Configure this node's name and optional public domain.</p>
            <EditForm Model="_node" OnValidSubmit="SaveNodeAsync">
                <DataAnnotationsValidator/>
                <ValidationSummary/>
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }
                <div class="field">
                    <label class="form-label" for="node-domain">Node address</label>
                    <div class="input-group" id="setup-address-dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-dropdown-trigger
                                aria-expanded="false" aria-controls="setup-address-options" disabled="@_busy">Select
                            address
                        </button>
                        <ul id="setup-address-options" class="dropdown-menu" data-dropdown-popup>
                            <li>
                                <button class="dropdown-item" type="button"
                                        @onclick="() => SelectAddress(_browserAddress)">Browser hostname
                                    (@_browserAddress)
                                </button>
                            </li>
                            @if (_publicAddress is not null)
                            {
                                <li>
                                    <button class="dropdown-item" type="button"
                                            @onclick="() => SelectAddress(_publicAddress)">Public IP (@_publicAddress)
                                    </button>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <button class="dropdown-item" type="button" disabled>Public IP
                                        (@(_refreshing ? "loading…" : "unavailable"))
                                    </button>
                                </li>
                            }
                        </ul>
                        <InputHostName @key="_addressSelectionVersion" id="node-domain" class="form-control"
                                       @bind-Value="_node.Domain" @bind-Value:after="UpdateNodeNamePlaceholder"
                                       DisplayName="Node address" aria-describedby="node-domain-hint node-domain-error"
                                       placeholder="e.g. vpn.mydomain.com or 203.0.113.1" disabled="@_busy"/>
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => LookupIpAsync()"
                                disabled="@_busy">@(_refreshing ? "Refreshing…" : "Refresh IP")</button>
                    </div>
                    <div id="node-domain-hint" class="form-text">This address will be used by devices to connect. Choose
                        an address or enter a custom value.
                    </div>
                    <div id="node-domain-error">
                        <ValidationMessage For="() => _node.Domain"/>
                    </div>
                </div>
                <div class="field">
                    <label class="form-label" for="node-name">Node name</label>
                    <div class="input-group">
                        <InputText id="node-name" class="form-control" @bind-Value="_node.NodeName"
                                   placeholder="@_nodeNamePlaceholder" disabled="@_busy"
                                   aria-describedby="node-name-hint"/>
                        <button class="btn btn-outline-secondary" type="button" @onclick="GenerateRandomNodeName"
                                disabled="@_busy">Random name
                        </button>
                    </div>
                    <div id="node-name-hint" class="form-text">A friendly name for this server in your cluster.</div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit"
                            disabled="@_busy">@(_busy && !_refreshing ? "Saving…" : "Continue")</button>
                </div>
            </EditForm>
        </section>
    }
    else if (_step == 2)
    {
        <section>
            <h2>Authentication</h2>
            <p class="text-body-secondary">Choose local administrator login or an OpenID Connect provider.</p>
            <div class="nav nav-tabs mb-4" aria-label="Authentication method">
                <button class="nav-link @(!_useOidc ? "active" : "")" type="button"
                        aria-current="@(!_useOidc ? "true" : null)" disabled="@_busy" @onclick="() => _useOidc = false">
                    Local login
                </button>
                <button class="nav-link @(_useOidc ? "active" : "")" type="button"
                        aria-current="@(_useOidc ? "true" : null)" disabled="@_busy" @onclick="() => _useOidc = true">
                    OpenID Connect
                </button>
            </div>
            <EditForm Model="@(_useOidc ? _oidc : _localAuth)" OnValidSubmit="SaveAuthenticationAsync">
                <DataAnnotationsValidator/>
                <ValidationSummary/>
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }
                <fieldset disabled="@_busy">
                    <legend class="visually-hidden">Administrator authentication</legend>
                    @if (!_useOidc)
                    {
                        <div class="field"><label class="form-label" for="email">Administrator email</label>
                            <InputText id="email" type="email" autocomplete="email" class="form-control"
                                       @bind-Value="_localAuth.Email"/>
                        </div>
                        <div class="field"><label class="form-label" for="password">Password</label>
                            <InputText id="password" type="password" autocomplete="new-password" class="form-control"
                                       @bind-Value="_localAuth.Password"/>
                        </div>
                        <div class="field">
                            <label class="form-label" for="confirm-password">Confirm password</label>
                            <InputText id="confirm-password" type="password" autocomplete="new-password"
                                       class="form-control" @bind-Value="_confirmPassword"
                                       aria-describedby="confirm-password-error"
                                       aria-invalid="@(_passwordMismatch ? "true" : "false")"/>
                            @if (_passwordMismatch)
                            {
                                <div id="confirm-password-error" class="text-danger small mt-1">Passwords do not match.
                                    Enter the same password in both fields.
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="field"><label class="form-label" for="oidc-name">Provider display name</label>
                            <InputText id="oidc-name" class="form-control" @bind-Value="_oidc.DisplayName"/>
                        </div>
                        <div class="field"><label class="form-label" for="authority">Issuer URL</label>
                            <InputText id="authority" type="url" class="form-control" @bind-Value="_oidc.Authority"/>
                        </div>
                        <div class="field"><label class="form-label" for="client-id">Client ID</label>
                            <InputText id="client-id" class="form-control" @bind-Value="_oidc.ClientId"/>
                        </div>
                        <div class="field"><label class="form-label" for="client-secret">Client secret</label>
                            <InputText id="client-secret" type="password" autocomplete="off" class="form-control"
                                       @bind-Value="_oidc.ClientSecret"/>
                        </div>
                        <dl class="app-details field">
                            <dt>Redirect URI</dt>
                            <dd><code class="text-break">@Navigation.ToAbsoluteUri("/signin-OIDC")</code></dd>
                        </dl>
                        <div class="actions">
                            <button class="btn btn-outline-secondary" type="button" @onclick="TestOidcAsync"
                                    disabled="@_busy">@(_testing ? "Testing…" : "Test provider")</button>
                        </div>
                        @if (_oidcTestResult is not null)
                        {
                            <div class="alert @(_oidcTestResult.Value ? "alert-success" : "alert-danger") mt-3"
                                 role="@(_oidcTestResult.Value ? "status" : "alert")">@_oidcTestMessage</div>
                        }
                    }
                    <div class="form-actions">
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => _step = 1"
                                disabled="@_busy">Back
                        </button>
                        <button class="btn btn-primary" type="submit"
                                disabled="@_busy">@(_busy && !_testing ? "Saving…" : "Continue")</button>
                    </div>
                </fieldset>
            </EditForm>
        </section>
    }
    else
    {
        <section>
            <h2>Finish setup</h2>
            <p class="text-body-secondary">Your node and administrator login are configured.</p>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }
            <div class="form-actions">
                <button class="btn btn-primary" type="button" @onclick="FinishAsync"
                        disabled="@_busy">@(_busy ? "Finishing…" : "Finish setup")</button>
            </div>
        </section>
    }
</div>

@code {
    private int _step = 1;
    private bool _busy;
    private bool _useOidc;
    private HostName? _publicAddress;
    private HostName _browserAddress;
    private int _addressSelectionVersion;
    private string _nodeNamePlaceholder = "primary-node";
    private IJSObjectReference? _dropdownModule;
    private bool _testing;
    private bool _refreshing;
    private bool _passwordMismatch;
    private string? _error;
    private bool? _oidcTestResult;
    private string? _oidcTestMessage;
    private string _confirmPassword = string.Empty;
    private readonly NodeSetupRequest _node = new();
    private readonly LocalAuthSetupRequest _localAuth = new();
    private readonly OidcAuthSetupRequest _oidc = new() { DisplayName = "Login with OAuth" };


    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.BaseUri);
        _browserAddress = HostName.Parse(uri.IdnHost);
        SetNodeAddress(_browserAddress);
        await LookupIpAsync(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_step != 1)
        {
            if (_dropdownModule is not null) await _dropdownModule.InvokeVoidAsync("dispose", "setup-address-dropdown");
            return;
        }

        _dropdownModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/ShadowVPN2.Frontend/js/dropdown.js");
        await _dropdownModule.InvokeVoidAsync("initialize", "setup-address-dropdown");
    }

    public async ValueTask DisposeAsync()
    {
        if (_dropdownModule is null) return;
        try
        {
            await _dropdownModule.InvokeVoidAsync("dispose", "setup-address-dropdown");
            await _dropdownModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void SelectAddress(HostName? address)
    {
        SetNodeAddress(address);
    }

    private void SetNodeAddress(HostName? address)
    {
        _node.Domain = address;
        _addressSelectionVersion++;
        UpdateNodeNamePlaceholder();
    }

    private void UpdateNodeNamePlaceholder()
    {
        if (_node.Domain is not { } address)
            return;

        var host = address.ToString();
        if (!IPAddress.TryParse(host, out _)
            && !string.Equals(host, "localhost", StringComparison.OrdinalIgnoreCase))
        {
            _nodeNamePlaceholder = host.Split('.', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()
                                   ?? CreateRandomNodeName();
        }
        else if (string.IsNullOrEmpty(_nodeNamePlaceholder) || _nodeNamePlaceholder == _browserAddress.ToString())
        {
            _nodeNamePlaceholder = CreateRandomNodeName();
        }
    }

    private void GenerateRandomNodeName()
    {
        _node.NodeName = CreateRandomNodeName();
    }

    private static string CreateRandomNodeName()
    {
        return NameGenerator.Identifiers.Get(1, separator: "-").FirstOrDefault()?.ToLowerInvariant()
               ?? "primary-node";
    }

    private async Task LookupIpAsync(bool manualRefresh = true)
    {
        _busy = true;
        _refreshing = true;
        _error = null;
        try
        {
            _publicAddress = HostName.ParseOptional(await SetupApi.GetPublicIpAsync());
            if (!manualRefresh && _node.Domain == _browserAddress && IsPrivateIpOrLocalhost(_browserAddress.ToString())
                && _publicAddress is not null)
                SetNodeAddress(_publicAddress);
        }
        catch (ApplicationServiceException exception)
        {
            Logger.LogError(exception, "Unable to look up public IP during setup");
            _error = "Could not look up the public IP. Enter an address or try refreshing again.";
        }
        finally
        {
            _busy = false;
            _refreshing = false;
        }
    }

    private static bool IsPrivateIpOrLocalhost(string host)
    {
        if (string.Equals(host, "localhost", StringComparison.OrdinalIgnoreCase))
            return true;

        if (!IPAddress.TryParse(host, out var address))
            return false;

        if (address.AddressFamily == AddressFamily.InterNetwork)
        {
            var bytes = address.GetAddressBytes();
            return bytes[0] == 10
                   || bytes[0] == 127
                   || (bytes[0] == 192 && bytes[1] == 168)
                   || (bytes[0] == 172 && bytes[1] is >= 16 and <= 31)
                   || (bytes[0] == 169 && bytes[1] == 254);
        }

        return address.AddressFamily == AddressFamily.InterNetworkV6
               && (address.IsIPv6LinkLocal || address.IsIPv6SiteLocal || address.Equals(IPAddress.IPv6Loopback));
    }

    private async Task SaveNodeAsync()
    {
        await RunAsync(async () =>
        {
            var request = new NodeSetupRequest
            {
                Domain = _node.Domain,
                NodeName = string.IsNullOrWhiteSpace(_node.NodeName) ? _nodeNamePlaceholder : _node.NodeName.Trim()
            };
            await SetupApi.ConfigureNodeAsync(request);
            _step = 2;
        });
    }

    private async Task SaveAuthenticationAsync()
    {
        _passwordMismatch = false;
        if (!_useOidc && _localAuth.Password != _confirmPassword)
        {
            _passwordMismatch = true;
            return;
        }

        await RunAsync(async () =>
        {
            if (_useOidc)
                await SetupApi.ConfigureOidcAsync(_oidc);
            else
                await SetupApi.ConfigureLocalAuthAsync(_localAuth);
            _step = 3;
        });
    }

    private async Task TestOidcAsync()
    {
        _testing = true;
        _oidcTestResult = null;
        await RunAsync(async () =>
        {
            _oidcTestResult = await SetupApi.TestOidcConnectionAsync(_oidc.Authority);
            _oidcTestMessage = _oidcTestResult.Value
                ? "Connected to the OIDC discovery endpoint."
                : "Could not connect to the OIDC discovery endpoint.";
        });
        _testing = false;
    }

    private async Task FinishAsync()
    {
        await RunAsync(async () =>
        {
            await SetupApi.FinishSetupAsync();
            Navigation.NavigateTo(Navigation.BaseUri, true);
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (ApplicationServiceException exception)
        {
            Logger.LogError(exception, "Unable to complete setup operation");
            _error = "Could not complete setup. Check the entered settings and try again.";
        }
        finally
        {
            _busy = false;
        }
    }

}
