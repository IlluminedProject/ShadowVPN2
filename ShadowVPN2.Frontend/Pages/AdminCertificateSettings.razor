@page "/admin/settings/certificates"
@using System.Net
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Settings.View")]
@inject IAdminSettingsService AdminApi
@inject ILogger<AdminCertificateSettings> Logger

<PageTitle>Certificate settings - ShadowVPN2</PageTitle>

<AdminSettingsNav/>
<div class="page-header"><h1>Certificates</h1></div>
@if (_loading)
{
    <div class="app-status text-body-secondary" role="status"><span class="spinner-border spinner-border-sm"
                                                                    aria-hidden="true"></span> Loading certificate
        settings…
    </div>
}
else if (!_loaded)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
else
{
    <EditForm Model="_settings" OnValidSubmit="SaveAsync" class="settings-frame">
        <DataAnnotationsValidator/>
        <ValidationSummary/>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }
        <fieldset disabled="@_busy">
            <legend class="visually-hidden">Certificate settings</legend>
            <div class="form-check form-switch field">
                <InputCheckbox id="acme-enabled" class="form-check-input" @bind-Value="_settings.Enabled"/>
                <label class="form-check-label" for="acme-enabled">Enable automatic Let's Encrypt certificates</label>
            </div>
            <div class="field">
                <label class="form-label" for="acme-email">Account email</label>
                <InputText id="acme-email" type="email" autocomplete="email" class="form-control"
                           @bind-Value="_settings.Email"/>
            </div>
            <div class="settings-grid mb-3">
                <div>
                    <label class="form-label" for="http-port">HTTP-01 listen port</label>
                    <InputNumber id="http-port" class="form-control" inputmode="numeric"
                                 @bind-Value="_settings.HttpPort"/>
                </div>
                <div>
                    <label class="form-label" for="renewal-days">Renewal threshold (days)</label>
                    <InputNumber id="renewal-days" class="form-control" inputmode="numeric"
                                 @bind-Value="_settings.RenewalThresholdDays"/>
                </div>
            </div>
            <div class="form-check form-switch field">
                <InputCheckbox id="acme-staging" class="form-check-input" @bind-Value="_settings.UseStaging"/>
                <label class="form-check-label" for="acme-staging">Use staging CA</label>
            </div>
            <section class="mt-4">
                <h2>Local node certificate</h2>
                @if (_certificate is null)
                {
                    <p class="text-body-secondary">No certificate has been issued.</p>
                }
                else
                {
                    <dl class="app-details">
                        <dt>Expires</dt>
                        <dd>@_certificate.NotAfter.ToLocalTime().ToString("g")</dd>
                        <dt>Domains</dt>
                        <dd>
                            @if (_certificate.Domains.Count == 0)
                            {
                                <span>No certificate domains.</span>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var domain in _certificate.Domains)
                                    {
                                        <li><code class="text-break">@domain</code></li>
                                    }
                                </ul>
                            }
                        </dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_certificate.LastError))
                    {
                        <div class="alert alert-danger" role="alert">@_certificate.LastError</div>
                    }
                }
            </section>
            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="alert alert-success app-status" role="status">@_message</div>
            }
            <div class="form-actions">
                <button class="btn btn-outline-secondary" type="button" @onclick="RenewAsync"
                        disabled="@_busy">@(_renewing ? "Issuing…" : "Issue / renew now")</button>
                <button class="btn btn-primary" type="submit"
                        disabled="@_busy">@(_busy && !_renewing ? "Saving…" : "Save settings")</button>
            </div>
        </fieldset>
    </EditForm>
}

@code {
    private AcmeSettingsResponse _settings = new();
    private ManagedCertificateResponse? _certificate;
    private bool _loading = true;
    private bool _loaded;
    private bool _renewing;
    private bool _busy;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settingsTask = AdminApi.GetCertificateSettingsAsync();
            var certificateTask = AdminApi.GetLocalCertificateAsync();
            await Task.WhenAll(settingsTask, certificateTask);
            _settings = await settingsTask;
            _certificate = await certificateTask;
            _loaded = true;
        }
        catch (ApplicationServiceException ex)
        {
            Logger.LogWarning(ex, "Could not load certificate settings");
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to view settings."
                : "Could not load certificate settings.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task SaveAsync()
    {
        return RunAsync(async () =>
        {
            await AdminApi.SaveCertificateSettingsAsync(new UpdateAcmeSettingsRequest
            {
                Enabled = _settings.Enabled,
                Email = _settings.Email,
                UseStaging = _settings.UseStaging,
                HttpPort = _settings.HttpPort,
                RenewalThresholdDays = _settings.RenewalThresholdDays
            });
            _message = "Certificate settings saved.";
        });
    }

    private async Task RenewAsync()
    {
        _renewing = true;
        await RunAsync(async () =>
        {
            await AdminApi.SaveCertificateSettingsAsync(new UpdateAcmeSettingsRequest
            {
                Enabled = _settings.Enabled,
                Email = _settings.Email,
                UseStaging = _settings.UseStaging,
                HttpPort = _settings.HttpPort,
                RenewalThresholdDays = _settings.RenewalThresholdDays
            });
            await AdminApi.RenewLocalCertificateAsync();
            _certificate = await AdminApi.GetLocalCertificateAsync();
            _message = "Certificate issued.";
        });
        _renewing = false;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await action();
        }
        catch (ApplicationServiceException ex)
        {
            Logger.LogWarning(ex, "Certificate settings operation failed");
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                    ? "You do not have permission to change settings."
                    : "The operation failed.";
        }
        finally
        {
            _busy = false;
        }
    }

}
