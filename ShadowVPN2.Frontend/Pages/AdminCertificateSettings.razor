@page "/admin/settings/certificates"
@using System.Net
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Settings.View")]
@inject IAdminSettingsService AdminApi

<PageTitle>Certificate settings - ShadowVPN2</PageTitle>

<div>
    <AdminSettingsNav/>
    <h1>Certificates</h1>
    @if (_loading)
    {
        <p class="muted">Loading certificate settings…</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    else
    {
        <div class="settings-frame">
            <div class="form-check form-switch mb-3">
                <InputCheckbox class="form-check-input" @bind-Value="_settings.Enabled"/>
                <label class="form-check-label">Enable automatic Let's Encrypt certificates</label>
            </div>
            <label for="acme-email">Account email</label>
            <InputText id="acme-email" type="email" class="form-control" @bind-Value="_settings.Email"/>
            <label for="http-port">HTTP-01 port</label>
            <InputNumber id="http-port" class="form-control" @bind-Value="_settings.HttpPort"/>
            <label for="renewal-days">Renewal threshold (days)</label>
            <InputNumber id="renewal-days" class="form-control" @bind-Value="_settings.RenewalThresholdDays"/>
            <div class="form-check form-switch mb-3">
                <InputCheckbox class="form-check-input" @bind-Value="_settings.UseStaging"/>
                <label class="form-check-label">Use staging CA</label>
            </div>

            <section>
                <h2>Local node certificate</h2>
                @if (_certificate is null)
                {
                    <p class="muted">Not issued.</p>
                }
                else
                {
                    <p>Expires: @_certificate.NotAfter.ToLocalTime().ToString("g")</p>
                    @foreach (var domain in _certificate.Domains)
                    {
                        <code>@domain </code>
                    }

                    @if (!string.IsNullOrWhiteSpace(_certificate.LastError))
                    {
                        <div class="alert alert-danger">@_certificate.LastError</div>
                    }
                }
            </section>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button class="btn btn-outline-primary" @onclick="RenewAsync" disabled="@_busy">Issue / renew now</button>
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">Save settings</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <p role="status">@_message</p>
    }
</div>

@code {
    private AcmeSettingsResponse _settings = new();
    private ManagedCertificateResponse? _certificate;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settingsTask = AdminApi.GetCertificateSettingsAsync();
            var certificateTask = AdminApi.GetLocalCertificateAsync();
            await Task.WhenAll(settingsTask, certificateTask);
            _settings = await settingsTask;
            _certificate = await certificateTask;
        }
        catch (ApplicationServiceException ex)
        {
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to view settings."
                : "Could not load certificate settings.";
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task SaveAsync()
    {
        return RunAsync(async () =>
        {
            await AdminApi.SaveCertificateSettingsAsync(new UpdateAcmeSettingsRequest
            {
                Enabled = _settings.Enabled,
                Email = _settings.Email,
                UseStaging = _settings.UseStaging,
                HttpPort = _settings.HttpPort,
                RenewalThresholdDays = _settings.RenewalThresholdDays
            });
            _message = "Certificate settings saved.";
        });
    }

    private Task RenewAsync()
    {
        return RunAsync(async () =>
        {
            await AdminApi.SaveCertificateSettingsAsync(new UpdateAcmeSettingsRequest
            {
                Enabled = _settings.Enabled,
                Email = _settings.Email,
                UseStaging = _settings.UseStaging,
                HttpPort = _settings.HttpPort,
                RenewalThresholdDays = _settings.RenewalThresholdDays
            });
            await AdminApi.RenewLocalCertificateAsync();
            _certificate = await AdminApi.GetLocalCertificateAsync();
            _message = "Certificate issued.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await action();
        }
        catch (ApplicationServiceException ex)
        {
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                    ? "You do not have permission to change settings."
                    : "The operation failed.";
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
        finally
        {
            _busy = false;
        }
    }

}
