@page "/Error"
@using System.Diagnostics
@layout AccountLayout
@attribute [AllowAnonymous]

<PageTitle>Error - ShadowVPN2</PageTitle>

<div class="page-header"><h1>Unable to complete the request</h1></div>
<p>An error occurred while processing your request. Please try again.</p>
@if (ShowRequestId)
{
    <dl class="app-details">
        <dt>Request ID</dt>
        <dd><code class="text-break">@RequestId</code></dd>
    </dl>
}
<div class="actions"><a class="btn btn-outline-secondary" href="/">Back to dashboard</a></div>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }

}
