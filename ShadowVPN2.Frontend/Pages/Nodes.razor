@page "/nodes"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Nodes.View")]
@inject INodeApplicationService NodesApi
@inject IClusterApplicationService ClusterApi
@inject INodeUpdatesService NodeRealtime
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject ILogger<Nodes> Logger
@using System.Net
@implements IAsyncDisposable

<PageTitle>Nodes - ShadowVPN2</PageTitle>

<div>
    <div class="page-header">
        <h1>Nodes</h1>
        <div class="actions">
            <button class="btn btn-primary" type="button" @onclick="OpenAddNode">Add node</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 text-secondary" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Loading nodes…
        </div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
        @if (_authenticationRequired)
        {
            <a class="btn btn-primary" href="@LoginUrl">Sign in</a>
        }
    }
    @if (_nodes.Count == 0 && !_loading)
    {
        <div class="alert alert-secondary">No nodes found. Add a node to start.</div>
    }
    else if (_nodes.Count > 0)
    {
        <div class="table-responsive" tabindex="0" aria-label="Nodes">
            <table class="table table-striped table-hover align-middle">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Domain</th>
                    <th>Public IP</th>
                    <th>Mesh IP</th>
                    <th>Protocol domains</th>
                    <th>Status</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var node in _nodes)
                {
                    <tr>
                        <td>
                            @node.Name
                            @if (node.RuntimeMetadata is { } metadata)
                            {
                                @if (!string.IsNullOrWhiteSpace(metadata.ContainerImageDigest))
                                {
                                    <div class="small"><code class="text-break">@metadata.ContainerImageDigest</code>
                                    </div>
                                }
                            }
                        </td>
                        <td>
                            <code class="text-break">@(node.Domain?.ToString() ?? "—")</code>
                            @if (node.DomainStatus is not null)
                            {
                                <div class="text-secondary small">@DomainDnsDetails.StatusText(node.DomainStatus)</div>
                            }
                            else
                            {
                                <div
                                    class="text-secondary small">@(node.Domain is null ? "No domain configured" : "Pending check")</div>
                            }
                        </td>
                        <td>
                            <code class="text-break">@(node.PublicIpv4 ?? node.PublicIpv6 ?? "—")</code>
                            @if (node.NetworkCheckedAt is { } networkCheckedAt)
                            {
                                <div class="text-secondary small">Network: @AgeText(networkCheckedAt)</div>
                            }
                        </td>
                        <td><code class="text-break">@node.AwgMeshIp</code></td>
                        <td>
                            @foreach (var route in _protocolRoutes.Where(route => route.NodeId == node.NodeId &&
                                                                                  route.State is ProtocolDomainRouteState.Valid or
                                                                                      ProtocolDomainRouteState.PartialMatch))
                            {
                                <div><code class="text-break">@route.Domain</code></div>
                            }
                        </td>
                        <td>
                            @(node.IsPending ? "Pending" : "Joined")
                            <div class="text-secondary small">Runtime: @RuntimeStatusText(node.RuntimeHeartbeatAt)</div>
                            @if (node.RuntimeHeartbeatAt is { } heartbeatAt)
                            {
                                <div class="text-secondary small">Heartbeat: @AgeText(heartbeatAt)</div>
                            }
                            @if (node.RuntimeStartedAt is { } startedAt)
                            {
                                <div class="text-secondary small" title="@startedAt.ToString("u")">
                                    Started: @AgeText(startedAt)</div>
                            }
                            @foreach (var check in node.RuntimeChecks)
                            {
                                <div class="small mt-2">
                                    <div>
                                        @check.Key: @CheckStatusText(check.Value.Status)
                                        @if (check.Value.ValidUntil <= DateTimeOffset.UtcNow)
                                        {
                                            <span class="text-warning">(Expired)</span>
                                        }
                                    </div>
                                    <div class="text-secondary">Checked: @AgeText(check.Value.CheckedAt)</div>
                                    <div class="text-secondary">Valid until: @check.Value.ValidUntil.ToString("u")</div>
                                    @if (!string.IsNullOrWhiteSpace(check.Value.Message))
                                    {
                                        <div class="text-break">@check.Value.Message</div>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            <div class="actions table-actions">
                                @if (node.IsPending)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" type="button"
                                            aria-label="View node setup @node.Name" title="View node setup"
                                            @onclick="() => OpenNodeConfigurationAsync(node)">
                                        <span class="bi bi-key" aria-hidden="true"></span>
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        aria-label="Edit node @node.Name" title="Edit node"
                                        @onclick="() => EditNodeAsync(node)">
                                    <span class="bi bi-pencil" aria-hidden="true"></span>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" type="button"
                                        aria-label="Delete node @node.Name"
                                        title="@(node.IsPending ? "Cancel node setup" : "Delete node")"
                                        @onclick="() => ConfirmDeleteNodeAsync(node)">
                                    <span class="bi bi-trash" aria-hidden="true"></span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_showAddNode)
{
    <AppDialog Title="Add node" OnClose="CloseAddNode" Busy="_busy" LightDismiss="false">
        <ChildContent>
            <EditForm Model="_newNode" OnValidSubmit="GenerateTokenAsync">
                <DataAnnotationsValidator/>
                <div class="app-dialog__body">
                    @if (!string.IsNullOrEmpty(_dialogError))
                    {
                        <div class="alert alert-danger" role="alert">@_dialogError</div>
                    }
                    <ValidationSummary/>
                    <div class="field">
                        <label class="form-label" for="node-name">Node name</label>
                        <InputText id="node-name" class="form-control" @bind-Value="_newNode.Name"/>
                    </div>
                    <div class="field">
                        <label class="form-label" for="node-domain">Domain (optional)</label>
                        <InputHostName id="node-domain" class="form-control" @bind-Value="_newNode.Domain"/>
                        <ValidationMessage For="() => _newNode.Domain"/>
                    </div>
                </div>
                <div class="app-dialog__footer">
                    <div class="actions">
                        <button class="btn btn-outline-secondary" type="button" @onclick="CloseAddNode"
                                disabled="@_busy">Cancel
                        </button>
                        <button class="btn btn-primary" type="submit" disabled="@_busy">
                            @(_busy ? "Generating…" : "Generate join token")
                        </button>
                    </div>
                </div>
            </EditForm>
        </ChildContent>
    </AppDialog>
}

@if (_showSetup)
{
    <NodeSetupDialog JoinToken="@_setupJoinToken" NodeName="@_setupNodeName"
                     DefaultWebPort="@_setupWebPort" OnClose="CloseSetup"/>
}

@if (_editingNode is not null)
{
    <AppDialog Title="@($"Node: {_editingNode.Name}")" OnClose="CloseEditNode" Busy="_busy" LightDismiss="false">
        <ChildContent>
            <EditForm @key="_domainRequest" EditContext="_domainEditContext" OnValidSubmit="SaveDomainAsync">
                <DataAnnotationsValidator/>
                <div class="app-dialog__body">
                    @if (!string.IsNullOrEmpty(_dialogError))
                    {
                        <div class="alert alert-danger" role="alert">@_dialogError</div>
                    }
                    <ValidationSummary/>
                    <div class="field mb-4">
                        <label class="form-label" for="edit-node-name">Name</label>
                        <InputText id="edit-node-name" class="form-control" @bind-Value="_domainRequest.Name"
                                   aria-describedby="edit-node-name-validation"/>
                        <div id="edit-node-name-validation">
                            <ValidationMessage For="() => _domainRequest.Name"/>
                        </div>
                    </div>
                    <section class="mb-4" aria-labelledby="node-domain-heading">
                        <h3 id="node-domain-heading" class="h5">Domain</h3>
                        <div class="field">
                            <label class="form-label" for="edit-domain">Hostname</label>
                            <InputHostName id="edit-domain" class="form-control" @bind-Value="_domainRequest.Domain"
                                           aria-describedby="edit-domain-validation"/>
                            <div id="edit-domain-validation">
                                <ValidationMessage For="() => _domainRequest.Domain"/>
                            </div>
                        </div>
                    </section>
                    <section class="mb-4" aria-labelledby="node-network-heading">
                        <h3 id="node-network-heading" class="h5">Network</h3>
                        <dl class="app-details">
                            <dt>Public IPv4</dt>
                            <dd><code class="text-break">@(_editingNode.PublicIpv4 ?? "—")</code></dd>
                            <dt>Public IPv6</dt>
                            <dd><code class="text-break">@(_editingNode.PublicIpv6 ?? "—")</code></dd>
                            <dt>Internal addresses</dt>
                            <dd>
                                @if (_editingNode.InternalAddresses.Count == 0)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    @foreach (var address in _editingNode.InternalAddresses)
                                    {
                                        <div><code class="text-break">@address</code></div>
                                    }
                                }
                            </dd>
                        </dl>
                    </section>
                    <section class="mb-4" aria-labelledby="node-dns-heading">
                        <h3 id="node-dns-heading" class="h5">DNS</h3>
                        <p class="small text-body-secondary">Check DNS saves a changed hostname before checking. Cancel
                            discards only changes that have not been saved.</p>
                        <h4 class="h6">Node DNS status</h4>
                        @if (_editingNode.DomainStatus is { } nodeDomainStatus)
                        {
                            <DomainDnsDetails Status="nodeDomainStatus"/>
                        }
                        else
                        {
                            <p class="text-body-secondary">@(_editingNode.Domain is null ? "No domain configured" : "Pending check")</p>
                        }
                        @if (_manualDomainCheck is { } manualDomainCheck)
                        {
                            <h4 class="h6">Manual DNS check</h4>
                            <DomainDnsDetails Status="manualDomainCheck"/>
                        }
                    </section>
                    <section aria-labelledby="node-certificates-heading">
                        <h3 id="node-certificates-heading" class="h5">Certificates</h3>
                        <dl class="app-details">
                            <dt>Certificate domains</dt>
                            <dd>
                                @if (_operation == "load")
                                {
                                    <span role="status">Loading certificate domains…</span>
                                }
                                else if (_certificateDomains is null)
                                {
                                    <span>Certificate domains unavailable</span>
                                }
                                else if (_certificateDomains.Domains.Count > 0)
                                {
                                    @foreach (var domain in _certificateDomains.Domains)
                                    {
                                        <div><code class="text-break">@domain</code></div>
                                    }
                                }
                                else
                                {
                                    <span>No certificate domains</span>
                                }
                            </dd>
                            <dt>Protocol domains</dt>
                            <dd>
                                @foreach (var route in _protocolRoutes.Where(route => route.NodeId == _editingNode.NodeId &&
                                                                                      route.State is ProtocolDomainRouteState.Valid or ProtocolDomainRouteState.PartialMatch))
                                {
                                    <div><code class="text-break">@route.Domain</code> — @route.Protocol</div>
                                }
                            </dd>
                        </dl>
                    </section>
                </div>
                <div class="app-dialog__footer">
                    <div class="actions">
                        <button class="btn btn-outline-secondary" type="button" @onclick="CheckDomainAsync"
                                disabled="@_busy">@(_operation == "check" ? "Checking…" : "Check DNS")</button>
                    </div>
                    <div class="actions">
                        <button class="btn btn-outline-secondary" type="button" @onclick="CloseEditNode"
                                disabled="@_busy">Cancel
                        </button>
                        <button class="btn btn-primary" type="submit"
                                disabled="@_busy">@(_operation == "save" ? "Saving…" : "Save")</button>
                    </div>
                </div>
            </EditForm>
        </ChildContent>
    </AppDialog>
}

@if (_showDeleteConfirm && _deletingNode is not null)
{
    <AppDialog Title="@(_deletingNode.IsPending ? "Cancel node setup" : "Delete node")"
               OnClose="CloseDeleteConfirm" Busy="_busy" LightDismiss="false">
        <ChildContent>
            <div class="app-dialog__body">
                @if (!string.IsNullOrEmpty(_dialogError))
                {
                    <div class="alert alert-danger" role="alert">@_dialogError</div>
                }
                @if (_deletingNode.IsPending)
                {
                    <p>Cancel the setup request for <strong>@_deletingNode.Name</strong>?</p>
                    <p class="text-secondary small">The join token will become invalid and the node record will be
                        removed.</p>
                }
                else
                {
                    <p>Delete <strong>@_deletingNode.Name</strong> from the cluster?</p>
                    <p class="text-warning small">
                        <span class="bi bi-exclamation-triangle" aria-hidden="true"></span>
                        This will remove the node from RavenDB cluster and database topology.
                    </p>
                }
            </div>
            <div class="app-dialog__footer">
                <div class="actions">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseDeleteConfirm"
                            disabled="@_busy">Cancel
                    </button>
                    <button class="btn btn-danger" type="button" @onclick="DeleteNodeAsync"
                            disabled="@_busy">
                        @if (_busy)
                        {
                            <span>Deleting…</span>
                        }
                        else if (_deletingNode.IsPending)
                        {
                            <span>Cancel setup</span>
                        }
                        else
                        {
                            <span>Delete node</span>
                        }
                    </button>
                </div>
            </div>
        </ChildContent>
    </AppDialog>
}

@code {
    private IReadOnlyList<NodeResponse> _nodes = [];
    private IReadOnlyList<ProtocolDomainRouteResponse> _protocolRoutes = [];
    private NodeCertificateDomainsResponse? _certificateDomains;
    private IAsyncDisposable? _subscription;
    private readonly PeriodicTimer _freshnessTimer = new(TimeSpan.FromSeconds(5));
    private Task? _freshnessTask;
    private NodeResponse? _editingNode;
    private DomainCheckResponse? _manualDomainCheck;
    private UpdateNodeRequest _domainRequest = new();
    private EditContext? _domainEditContext;
    private readonly AddNodeForm _newNode = new();
    private string? _setupJoinToken;
    private string _setupNodeName = string.Empty;
    private int _setupWebPort;
    private bool _showAddNode;
    private bool _showSetup;
    private NodeResponse? _deletingNode;
    private bool _showDeleteConfirm;
    private bool _loading = true;
    private bool _busy;
    private string? _operation;
    private bool _authenticationRequired;
    private string? _error;
    private string? _dialogError;
    private string LoginUrl =>
        $"/Account/Login?returnUrl={Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)}";

    private void ApplyNodeUpdates(IReadOnlyList<NodeResponse> nodes)
    {
        _nodes = nodes.OrderBy(node => node.Number).ToArray();
        if (_editingNode is { } editingNode)
            _editingNode = _nodes.FirstOrDefault(node => node.NodeId == editingNode.NodeId);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadNodesAsync();
            _protocolRoutes = await NodesApi.GetProtocolDomainRoutesAsync();
            _subscription = await NodeRealtime.SubscribeAsync(nodes => InvokeAsync(() =>
            {
                ApplyNodeUpdates(nodes);
                StateHasChanged();
            }));
        }
        catch (ApplicationServiceException exception)
        {
            Logger.LogError(exception, "Unable to load nodes");
            _authenticationRequired = exception.StatusCode == HttpStatusCode.Unauthorized;
            _error = _authenticationRequired
                ? "Sign in to access nodes."
                : exception.StatusCode == HttpStatusCode.Forbidden
                    ? "You do not have permission to view nodes."
                    : "Could not load nodes.";
        }
        finally
        {
            _loading = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _freshnessTask = RefreshFreshnessAsync();
    }

    private async Task RefreshFreshnessAsync()
    {
        while (await _freshnessTimer.WaitForNextTickAsync())
            await InvokeAsync(StateHasChanged);
    }

    private async Task LoadNodesAsync()
    {
        _nodes = (await NodesApi.GetNodesAsync()).OrderBy(node => node.Number).ToArray();
    }

    private void OpenAddNode()
    {
        _showAddNode = true;
        _dialogError = null;
        _newNode.WebPort = Navigation.GetCurrentWebPort();
        _setupWebPort = _newNode.WebPort;
    }

    private void CloseAddNode()
    {
        if (!_busy)
            _showAddNode = false;
    }

    private void CloseSetup()
    {
        _showSetup = false;
    }


    private async Task GenerateTokenAsync()
    {
        _busy = true;
        _dialogError = null;
        try
        {
            _setupJoinToken = await ClusterApi.GenerateNodeJoinTokenAsync(_newNode.Name.Trim(), _newNode.Domain);
            _setupNodeName = _newNode.Name.Trim();
            _setupWebPort = Navigation.GetCurrentWebPort();
            _showAddNode = false;
            _showSetup = true;
        }
        catch (ApplicationServiceException exception)
        {
            Logger.LogError(exception, "Unable to generate node join token");
            _dialogError = exception.StatusCode == HttpStatusCode.Forbidden
                ? "Only administrators can add nodes."
                : "Could not generate a node join token.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenNodeConfigurationAsync(NodeResponse node)
    {
        _busy = true;
        _dialogError = null;
        try
        {
            _setupJoinToken = await ClusterApi.GetNodeJoinTokenAsync(node.NodeId);
            _setupNodeName = node.Name;
            _setupWebPort = Navigation.GetCurrentWebPort();
            _showSetup = true;
        }
        catch (ApplicationServiceException exception)
        {
            Logger.LogError(exception, "Unable to load node join configuration");
            _dialogError = "Could not load the node join configuration.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void CloseEditNode()
    {
        if (_busy)
            return;

        _editingNode = null;
        _manualDomainCheck = null;
        _dialogError = null;
    }


    private async Task EditNodeAsync(NodeResponse node)
    {
        _editingNode = node;
        _manualDomainCheck = null;
        _domainRequest = new UpdateNodeRequest { Name = node.Name, Domain = node.Domain };
        _domainEditContext = new EditContext(_domainRequest);
        _certificateDomains = null;
        _dialogError = null;
        _busy = true;
        _operation = "load";
        try
        {
            _certificateDomains = await NodesApi.GetCertificateDomainsAsync(node.NodeId);
        }
        catch (ApplicationServiceException exception)
        {
            Logger.LogError(exception, "Unable to load node certificate domains");
            _dialogError = "Could not load certificate domains. Close and reopen this node to try again.";
        }
        finally
        {
            _busy = false;
            _operation = null;
        }
    }

    private async Task SaveDomainAsync()
    {
        if (_editingNode is null)
            return;

        _busy = true;
        _operation = "save";
        _dialogError = null;
        try
        {
            await NodesApi.UpdateAsync(_editingNode.NodeId, _domainRequest);
            await ReloadAsync();
            _editingNode = null;
        }
        catch (ApplicationServiceException exception)
        {
            Logger.LogError(exception, "Unable to update node");
            _dialogError = exception.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to edit nodes."
                : "Could not update the node.";
        }
        finally
        {
            _busy = false;
            _operation = null;
        }
    }

    private async Task CheckDomainAsync()
    {
        if (_editingNode is null || _domainEditContext?.Validate() != true)
            return;

        _busy = true;
        _operation = "check";
        _dialogError = null;
        try
        {
            if (_domainRequest.Domain != _editingNode.Domain)
                await NodesApi.UpdateAsync(_editingNode.NodeId, _domainRequest);
            _manualDomainCheck = await NodesApi.CheckDomainAsync(_editingNode.NodeId);
            await ReloadAsync();
            _editingNode = _nodes.FirstOrDefault(node => node.NodeId == _editingNode.NodeId);
        }
        catch (ApplicationServiceException exception)
        {
            Logger.LogError(exception, "Unable to check node domain");
            _dialogError = "Could not check the node domain.";
        }
        finally
        {
            _busy = false;
            _operation = null;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadNodesAsync();
        _protocolRoutes = await NodesApi.GetProtocolDomainRoutesAsync();
    }


    private void ConfirmDeleteNodeAsync(NodeResponse node)
    {
        _deletingNode = node;
        _showDeleteConfirm = true;
        _dialogError = null;
    }

    private void CloseDeleteConfirm()
    {
        if (!_busy)
        {
            _showDeleteConfirm = false;
            _deletingNode = null;
            _dialogError = null;
        }
    }

    private async Task DeleteNodeAsync()
    {
        if (_deletingNode is null)
            return;

        _busy = true;
        _dialogError = null;
        try
        {
            await NodesApi.DeleteAsync(_deletingNode.NodeId);
            _showDeleteConfirm = false;
            _deletingNode = null;
        }
        catch (ApplicationServiceException exception)
        {
            Logger.LogError(exception, "Unable to delete node {NodeId}", _deletingNode?.NodeId);
            _dialogError = exception.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to delete nodes."
                : $"Could not delete node: {exception.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string RuntimeStatusText(DateTimeOffset? heartbeatAt)
    {
        if (heartbeatAt is null)
            return "No data";
        return DateTimeOffset.UtcNow - heartbeatAt.Value <= TimeSpan.FromSeconds(90)
            ? "Fresh"
            : "Stale";
    }

    private static string CheckStatusText(NodeCheckStatus status)
    {
        return status switch
        {
            NodeCheckStatus.Healthy => "Healthy",
            NodeCheckStatus.Unhealthy => "Unhealthy",
            _ => "Unknown"
        };
    }

    private static string AgeText(DateTimeOffset timestamp)
    {
        var age = DateTimeOffset.UtcNow - timestamp;
        return age < TimeSpan.FromSeconds(1) ? "just now" : $"{age.TotalMinutes:0.#} min ago";
    }

    public async ValueTask DisposeAsync()
    {
        _freshnessTimer.Dispose();
        if (_freshnessTask is not null)
            await _freshnessTask;
        if (_subscription is not null)
            await _subscription.DisposeAsync();
    }

}
