@page "/"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Nodes.View")]
@inject INodeApplicationService NodesApi
@inject IClusterApplicationService ClusterApi
@inject INodeUpdatesService NodeRealtime
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@using System.Net
@implements IAsyncDisposable

<PageTitle>Nodes - ShadowVPN2</PageTitle>

<div>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h1>Nodes</h1>
        <button class="btn btn-primary" @onclick="OpenAddNode">Add node</button>
    </div>

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 text-secondary" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Loading nodes…
        </div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
        @if (_authenticationRequired)
        {
            <a class="btn btn-primary" href="@LoginUrl">Sign in</a>
        }
    }
    @if (_nodes.Count == 0 && !_loading)
    {
        <div class="alert alert-secondary">No nodes found. Add a node to start.</div>
    }
    else if (_nodes.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Domain</th>
                    <th>Public IP</th>
                    <th>Mesh IP</th>
                    <th>Protocol domains</th>
                    <th>Status</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var node in _nodes)
                {
                    <tr>
                        <td>@node.Number</td>
                        <td>@node.Name</td>
                        <td>
                            <code>@(string.IsNullOrWhiteSpace(node.Domain) ? "—" : node.Domain)</code>
                            @if (node.DomainStatus is not null)
                            {
                                <div class="muted">@DomainStatusText(node.DomainStatus.State)</div>
                            }
                        </td>
                        <td><code>@(node.PublicIpv4 ?? node.PublicIpv6 ?? "—")</code></td>
                        <td><code>@node.AwgMeshIp</code></td>
                        <td>
                            @foreach (var route in _protocolRoutes.Where(route => route.NodeId == node.NodeId &&
                                                                                  route.State is ProtocolDomainRouteState.Valid or
                                                                                      ProtocolDomainRouteState.PartialMatch))
                            {
                                <div><code>@route.Domain</code></div>
                            }
                        </td>
                        <td>@(node.IsPending ? "Pending" : "Joined")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditNodeAsync(node)">Edit
                                domain
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_showAddNode)
{
    <div class="modal-backdrop">
        <section class="dialog modal-content" role="dialog" aria-modal="true">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Add node</h2>
                <button class="btn-close" type="button" aria-label="Close" @onclick="CloseAddNode"></button>
            </div>
            <div class="modal-body">
                @if (_joinToken is null)
                {
                    <label class="form-label" for="node-name">Node name</label>
                    <InputText id="node-name" class="form-control" @bind-Value="_newNodeName"/>
                    <label class="form-label" for="node-domain">Domain (optional)</label>
                    <InputText id="node-domain" class="form-control" @bind-Value="_newNodeDomain"/>
                    <button class="btn btn-primary" @onclick="GenerateTokenAsync" disabled="@_busy">Generate join
                        token
                    </button>
                }
                else
                {
                    <p>Set this token as <code>JoinToken</code> on the new node.</p>
                    <textarea class="form-control mb-2" rows="5" readonly>@_joinToken</textarea>
                    <button class="btn btn-outline-secondary" @onclick="CopyTokenAsync">Copy token</button>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseAddNode">Close</button>
            </div>
        </section>
    </div>
}

@if (_editingNode is not null)
{
    <div class="modal-backdrop">
        <section class="dialog modal-content" role="dialog" aria-modal="true">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Node: @_editingNode.Name</h2>
                <button class="btn-close" type="button" aria-label="Close"
                        @onclick="() => _editingNode = null"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="edit-domain">Domain</label>
                <InputText id="edit-domain" class="form-control" @bind-Value="_editingDomain"/>
                <p class="muted">
                    Public IPv4: @_editingNode.PublicIpv4 — Public IPv6: @_editingNode.PublicIpv6
                </p>
                <p>Internal addresses: @(_editingNode.InternalAddresses.Count == 0
                                               ? "—"
                                               : string.Join(", ", _editingNode.InternalAddresses))</p>
                @if (_editingNode.DomainStatus is not null)
                {
                    <p>@DomainStatusText(_editingNode.DomainStatus.State)</p>
                    @if (_editingNode.DomainStatus.ResolvedAddresses.Count > 0)
                    {
                        <p>Resolved: @string.Join(", ", _editingNode.DomainStatus.ResolvedAddresses)</p>
                    }
                }
                @if (_certificateDomains is not null)
                {
                    <p>Certificate domains: @(_certificateDomains.Domains.Count == 0
                                                    ? "none"
                                                    : string.Join(", ", _certificateDomains.Domains))</p>
                }
                @foreach (var route in _protocolRoutes.Where(route => route.NodeId == _editingNode.NodeId &&
                                                                      route.State is ProtocolDomainRouteState.Valid or
                                                                          ProtocolDomainRouteState.PartialMatch))
                {
                    <p><code>@route.Domain</code> — @route.Protocol</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CheckDomainAsync" disabled="@_busy">Check DNS
                </button>
                <button class="btn btn-primary" @onclick="SaveDomainAsync" disabled="@_busy">Save</button>
                <button class="btn btn-secondary" @onclick="() => _editingNode = null">Close</button>
            </div>
        </section>
    </div>
}

@code {
    private IReadOnlyList<NodeResponse> _nodes = [];
    private IReadOnlyList<ProtocolDomainRouteResponse> _protocolRoutes = [];
    private NodeCertificateDomainsResponse? _certificateDomains;
    private IAsyncDisposable? _subscription;
    private NodeResponse? _editingNode;
    private string? _editingDomain;
    private string _newNodeName = "new-node";
    private string? _newNodeDomain;
    private string? _joinToken;
    private bool _showAddNode;
    private bool _loading = true;
    private bool _busy;
    private bool _authenticationRequired;
    private string? _error;

    private string LoginUrl =>
        $"/Account/Login?returnUrl={Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadNodesAsync();
            _protocolRoutes = await NodesApi.GetProtocolDomainRoutesAsync();
            _subscription = await NodeRealtime.SubscribeAsync(nodes => InvokeAsync(() =>
            {
                _nodes = nodes.OrderBy(node => node.Number).ToArray();
                StateHasChanged();
            }));
        }
        catch (ApplicationServiceException exception)
        {
            _authenticationRequired = exception.StatusCode == HttpStatusCode.Unauthorized;
            _error = _authenticationRequired
                ? "Sign in to access nodes."
                : exception.StatusCode == HttpStatusCode.Forbidden
                    ? "You do not have permission to view nodes."
                    : "Could not load nodes.";
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadNodesAsync()
    {
        _nodes = (await NodesApi.GetNodesAsync()).OrderBy(node => node.Number).ToArray();
    }

    private void OpenAddNode()
    {
        _showAddNode = true;
        _joinToken = null;
        _error = null;
    }

    private void CloseAddNode()
    {
        _showAddNode = false;
    }

    private async Task GenerateTokenAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _joinToken = await ClusterApi.GenerateNodeJoinTokenAsync(_newNodeName.Trim(),
                string.IsNullOrWhiteSpace(_newNodeDomain) ? null : _newNodeDomain.Trim());
        }
        catch (ApplicationServiceException exception)
        {
            _error = exception.StatusCode == HttpStatusCode.Forbidden
                ? "Only administrators can add nodes."
                : "Could not generate a node join token.";
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyTokenAsync()
    {
        if (_joinToken is not null)
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _joinToken);
    }

    private async Task EditNodeAsync(NodeResponse node)
    {
        _editingNode = node;
        _editingDomain = node.Domain;
        _certificateDomains = await NodesApi.GetCertificateDomainsAsync(node.NodeId);
        _error = null;
    }

    private async Task SaveDomainAsync()
    {
        if (_editingNode is null)
            return;

        _busy = true;
        try
        {
            await NodesApi.UpdateDomainAsync(_editingNode.NodeId, _editingDomain);
            await ReloadAsync();
            _editingNode = null;
        }
        catch (ApplicationServiceException exception)
        {
            _error = exception.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to edit nodes."
                : "Could not update the node domain.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CheckDomainAsync()
    {
        if (_editingNode is null)
            return;

        _busy = true;
        try
        {
            if (!string.Equals(_editingDomain?.Trim(), _editingNode.Domain, StringComparison.OrdinalIgnoreCase))
                await NodesApi.UpdateDomainAsync(_editingNode.NodeId, _editingDomain);
            else
                _editingNode.DomainStatus = await NodesApi.CheckDomainAsync(_editingNode.NodeId);
            await ReloadAsync();
            _editingNode = _nodes.FirstOrDefault(node => node.NodeId == _editingNode.NodeId);
        }
        catch (ApplicationServiceException)
        {
            _error = "Could not check the node domain.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadNodesAsync();
        _protocolRoutes = await NodesApi.GetProtocolDomainRoutesAsync();
    }

    private static string DomainStatusText(DomainValidationState state)
    {
        return state switch
        {
            DomainValidationState.Valid => "Domain points to this node",
            DomainValidationState.PartialMatch => "Some DNS records point to this node",
            DomainValidationState.NoDomain => "No domain configured",
            DomainValidationState.PublicIpUnknown => "Public IP is unknown",
            DomainValidationState.NoRecords => "No A/AAAA records",
            DomainValidationState.Mismatch => "Domain points elsewhere",
            DomainValidationState.LookupFailed => "DNS lookup failed",
            _ => state.ToString()
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscription is not null)
            await _subscription.DisposeAsync();
    }

}
