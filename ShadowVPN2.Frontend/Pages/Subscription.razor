@page "/s/{SubscriptionId:guid}"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout PublicLayout
@inject ISubscriptionApplicationService SubscriptionApi
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<PageTitle>Connection setup - ShadowVPN2</PageTitle>

<FrontendNav/>
<main class="frontend-content">
    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 text-secondary" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Loading connection details…
        </div>
    }
    else if (_subscription is null)
    {
        <h1>Invalid link</h1>
        <div class="alert alert-danger">This subscription link is invalid or has been removed.</div>
    }
    else
    {
        <h1>@_subscription.ClientName</h1>
        <section class="mb-4">
            <h2>Subscription URLs</h2>
            <div class="d-flex flex-column gap-2">
                @foreach (var format in SubscriptionFormats)
                {
                    <div class="d-flex gap-2 align-items-center">
                        <code class="text-break flex-grow-1">@CreateSubscriptionUrl(format.Key)</code>
                        <button class="btn btn-outline-primary text-nowrap"
                                @onclick="() => CopySubscriptionUrlAsync(format.Key)">
                            @(CopiedKey == $"subscription:{format.Key}" ? "Copied" : format.Value)
                        </button>
                    </div>
                }
            </div>
        </section>
        <h2>Available connection hosts</h2>
        @if (!_subscription.Protocols.Any())
        {
            <p class="muted">No connection protocols are enabled for this client.</p>
        }

        @foreach (var protocol in _subscription.Protocols)
        {
            <h3>@protocol.Protocol</h3>
            @foreach (var endpoint in protocol.Endpoints)
            {
                <section class="endpoint">
                    <div><strong>@endpoint.Name</strong> <span class="muted">@endpoint.Address</span></div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @if (endpoint.Connection is WireGuardConnectionInfo wireGuard)
                        {
                            <a class="btn btn-outline-primary text-nowrap" href="@CreateConfigDataUrl(wireGuard)"
                               download="@CreateConfigFileName(_subscription.ClientName, protocol.Protocol, endpoint.Name, wireGuard.ServerAddress)">
                                Download VPN config
                            </a>
                        }
                        <button class="btn btn-outline-primary text-nowrap"
                                @onclick="() => CopyConnectionAsync(protocol, endpoint)">
                            @(CopiedKey == ConnectionKey(protocol, endpoint) ? "Copied" : "Copy connection")
                        </button>
                        @foreach (var transport in endpoint.Transports.OfType<FreeTurnConnectionInfo>())
                        {
                            <button class="btn btn-outline-primary text-nowrap"
                                    @onclick="() => CopyFreeTurnAsync(endpoint, transport)">Copy FreeTurn link
                            </button>
                        }
                    </div>
                </section>
            }
        }

        @if (_servers.Count > 0)
        {
            <section>
                <h2>Server latency</h2>
                <p class="muted">Measured from your device.</p>
                <button class="btn btn-outline-primary" @onclick="PingServersAsync" disabled="@_pinging">Check again
                </button>
                @foreach (var server in _servers)
                {
                    <p class="text-break">@server.Name — @server.Address — @PingText(server)</p>
                }
            </section>
        }
    }
</main>

@code {
    [Parameter] public Guid SubscriptionId { get; set; }

    private SubscriptionResponse? _subscription;
    private bool _loading = true;
    private bool _pinging;
    private string? _copiedKey;
    private readonly List<ServerState> _servers = [];
    private string? CopiedKey => _copiedKey;

    private static IReadOnlyDictionary<string, string> SubscriptionFormats { get; } =
        new Dictionary<string, string>
        {
            ["Base64"] = "Copy Base64 URL",
            ["Mihomo"] = "Copy Mihomo URL",
            ["MihomoProvider"] = "Copy Mihomo provider URL",
            ["FreeTurn"] = "Copy FreeTurn URL"
        };

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _subscription = await SubscriptionApi.GetSubscriptionAsync(SubscriptionId);
            BuildServerList();
        }
        catch (Exception)
        {
            _subscription = null;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _servers.Count > 0)
            await PingServersAsync();
    }

    private void BuildServerList()
    {
        _servers.Clear();
        if (_subscription is null)
            return;

        _servers.AddRange(_subscription.Protocols.SelectMany(protocol => protocol.Endpoints)
                .DistinctBy(endpoint => endpoint.Address, StringComparer.OrdinalIgnoreCase)
                .Select(endpoint => new ServerState(endpoint.Name, endpoint.Address)));
    }

    private async Task PingServersAsync()
    {
        if (_pinging) return;
        _pinging = true;
        foreach (var server in _servers)
        {
            server.Checking = true;
            server.Latency = null;
        }

        StateHasChanged();

        await Task.WhenAll(_servers.Select(async server =>
        {
            try
            {
                server.Latency = await JsRuntime.InvokeAsync<int>("pingServer",
                        $"https://{server.Address}/api/node/status", 3000);
            }
            catch (Exception)
            {
                server.Latency = -1;
            }
            finally
            {
                server.Checking = false;
                await InvokeAsync(StateHasChanged);
            }
        }));
        _pinging = false;
    }

    private async Task CopyConnectionAsync(ProtocolSubscription protocol, SubscriptionEndpoint endpoint)
    {
        var shareUrl = endpoint.Connection switch
        {
                Hysteria2ConnectionInfo hysteria2 => SubscriptionLinkBuilder.CreateHysteria2ShareUrl(hysteria2,
                        _subscription!.ClientName),
                NaiveProxyConnectionInfo naiveProxy => SubscriptionLinkBuilder.CreateNaiveProxyShareUrl(naiveProxy,
                        _subscription!.ClientName),
                WireGuardConnectionInfo wireGuard => SubscriptionLinkBuilder.CreateWireGuardShareUrl(wireGuard),
                _ => string.Empty
        };
        await CopyAsync(shareUrl, ConnectionKey(protocol, endpoint));
    }

    private string CreateSubscriptionUrl(string format)
    {
        return Navigation.ToAbsoluteUri($"s/{SubscriptionId}/subscription?format={Uri.EscapeDataString(format)}").ToString();
    }

    private Task CopySubscriptionUrlAsync(string format)
    {
        return CopyAsync(CreateSubscriptionUrl(format), $"subscription:{format}");
    }

    private async Task CopyFreeTurnAsync(SubscriptionEndpoint endpoint, FreeTurnConnectionInfo transport)
    {
        var localConnection = SubscriptionLinkBuilder.CreateLocalConnection(endpoint.Connection);
        var wireGuardConfig = localConnection is WireGuardConnectionInfo wireGuard
                ? SubscriptionLinkBuilder.CreateWireGuardConfig(wireGuard)
                : null;
        var shareUrl = SubscriptionLinkBuilder.CreateFreeTurnShareUrl(transport, _subscription!.ClientName,
                wireGuardConfig);
        await CopyAsync(shareUrl, $"{endpoint.Name}:{transport.Peer}");
    }

    private async Task CopyAsync(string text, string key)
    {
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        _copiedKey = key;
    }

    private static string ConnectionKey(ProtocolSubscription protocol, SubscriptionEndpoint endpoint) =>
            $"{protocol.Protocol}:{endpoint.Address}";

    private static string CreateConfigDataUrl(WireGuardConnectionInfo wireGuard) =>
            $"data:text/plain;charset=utf-8;base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(SubscriptionLinkBuilder.CreateWireGuardConfig(wireGuard)))}";

    private static string CreateConfigFileName(string clientName, string protocol, string endpointName,
            string serverAddress)
    {
        var invalidChars = Path.GetInvalidFileNameChars();
        var parts = new[] { "shadowvpn", clientName, protocol, endpointName, serverAddress }
                .Select(part => new string(part.Trim().Select(character => char.IsControl(character) ||
                                                                           invalidChars.Contains(character) || character is '/' or '\\'
                                ? '-'
                                : character).ToArray())
                        .Trim(' ', '.', '-'))
                .Where(part => part.Length > 0);
        var name = string.Join('-', parts);
        return $"{name[..Math.Min(name.Length, 180)]}.conf";
    }

    private static string PingText(ServerState server) => server.Checking
            ? "Checking…"
            : server.Latency switch
            {
                    null => "—",
                    -1 => "Unavailable",
                    _ => $"{server.Latency} ms"
            };

    private sealed class ServerState(string name, string address)
    {
        public string Name { get; } = name;
        public string Address { get; } = address;
        public bool Checking { get; set; }
        public int? Latency { get; set; }
    }

}
