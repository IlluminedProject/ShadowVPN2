@page "/s/{SubscriptionId:guid}"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout PublicLayout
@implements IAsyncDisposable
@inject ISubscriptionApplicationService SubscriptionApi
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<PageTitle>Connection setup - ShadowVPN2</PageTitle>

<div class="frontend-content" id="subscription-page">
    <div class="page-header d-flex align-items-center justify-content-between gap-3 flex-wrap">
        <h1 class="mb-0">@(_subscription?.ClientName ?? "Connection setup")</h1>
        @if (!_loading && _subscription is not null)
        {
            <div class="actions">
                <div class="btn-group dropdown" id="subscription-dropdown">
                    <button class="btn btn-outline-secondary" type="button"
                            data-copy-text="@CreateSubscriptionUrl(null)">Copy URL
                    </button>
                    <button class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" type="button"
                            data-dropdown-trigger aria-expanded="false" aria-controls="subscription-options"
                            aria-label="Choose subscription format"></button>
                    <ul id="subscription-options" class="dropdown-menu" data-dropdown-popup>
                        @foreach (var format in SubscriptionFormats)
                        {
                            <li>
                                <button class="dropdown-item" type="button"
                                        data-copy-text="@CreateSubscriptionUrl(format.Key)">@format.Value</button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
    <div class="app-status text-danger" role="alert" data-copy-error hidden></div>
    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 text-secondary" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Loading connection details…
        </div>
    }
    else if (_subscription is null)
    {
        <h2>Invalid link</h2>
        <div class="alert alert-danger" role="alert">This subscription link is invalid or has been removed.</div>
    }
    else
    {
        <section class="mb-4">
            <h2>Servers</h2>
            @if (!_subscription.Protocols.Any())
            {
                <p class="text-body-secondary">No connection protocols are enabled for this client.</p>
            }

            <div class="connection-list">
                @foreach (var protocol in _subscription.Protocols)
                {
                    @foreach (var endpoint in protocol.Endpoints)
                    {
                        <SubscriptionConnectionRow Endpoint="endpoint" Protocol="@protocol.Protocol"
                                                   ClientName="@_subscription.ClientName"/>
                    }
                }
            </div>
        </section>

        @if (_servers.Count > 0)
        {
            <section>
                <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                    <h2 class="mb-0">HTTPS latency</h2>
                    <button class="btn btn-outline-secondary" type="button" @onclick="PingServersAsync"
                            disabled="@_pinging">@(_pinging ? "Checking…" : _hasChecked ? "Check again" : "Check")</button>
                </div>
                <p class="text-body-secondary">HTTPS response time from your device.</p>
                <div class="app-list">
                    @foreach (var server in _servers)
                    {
                        <div class="app-list-item">
                            <div><span class="fw-semibold">@server.Name</span>
                                <div class="font-monospace text-break">@server.Address</div>
                            </div>
                            <span class="app-status" role="status">@PingText(server)</span>
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>


@code {
    [Parameter] public Guid SubscriptionId { get; set; }

    private SubscriptionResponse? _subscription;
    private bool _loading = true;
    private bool _pinging;
    private readonly List<ServerState> _servers = [];
    private bool _hasChecked;
    private IJSObjectReference? _copyModule;
    private IJSObjectReference? _dropdownModule;

    private static IReadOnlyDictionary<string, string> SubscriptionFormats { get; } =
        new Dictionary<string, string>
        {
            ["Base64"] = "Base64",
            ["Mihomo"] = "Mihomo",
            ["MihomoProvider"] = "Mihomo provider",
            ["FreeTurn"] = "FreeTurn"
        };

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _subscription = await SubscriptionApi.GetSubscriptionAsync(SubscriptionId);
            BuildServerList();
        }
        catch (ApplicationServiceException)
        {
            _subscription = null;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_subscription is not null)
        {
            _dropdownModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/ShadowVPN2.Frontend/js/dropdown.js");
            await _dropdownModule.InvokeVoidAsync("initialize", "subscription-dropdown");
            _copyModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/ShadowVPN2.Frontend/js/subscription-copy.js");
            await _copyModule.InvokeVoidAsync("initialize", "subscription-page");
        }

        if (firstRender && _servers.Count > 0)
            await PingServersAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_dropdownModule is null) return;
        try
        {
            await _dropdownModule.InvokeVoidAsync("dispose", "subscription-dropdown");
            await _dropdownModule.DisposeAsync();
            if (_copyModule is not null)
            {
                await _copyModule.InvokeVoidAsync("dispose", "subscription-page");
                await _copyModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void BuildServerList()
    {
        _servers.Clear();
        if (_subscription is null)
            return;

        _servers.AddRange(_subscription.Protocols.SelectMany(protocol => protocol.Endpoints)
            .DistinctBy(endpoint => endpoint.Address)
            .Select(endpoint => new ServerState(endpoint.Name, endpoint.Address)));
    }

    private async Task PingServersAsync()
    {
        if (_pinging) return;
        _pinging = true;
        foreach (var server in _servers)
        {
            server.Checking = true;
            server.Latency = null;
        }

        StateHasChanged();

        await Task.WhenAll(_servers.Select(async server =>
        {
            try
            {
                server.Latency = await JsRuntime.InvokeAsync<int>("pingServer",
                    $"https://{server.Address}/api/node/status", 3000);
            }
            catch (JSException)
            {
                server.Latency = -1;
            }
            finally
            {
                server.Checking = false;
                await InvokeAsync(StateHasChanged);
            }
        }));
        _pinging = false;
        _hasChecked = true;
        await InvokeAsync(StateHasChanged);
    }


    private string CreateSubscriptionUrl(string? format)
    {
        var path = $"s/{SubscriptionId}/subscription";
        if (format is not null)
            path += $"?format={Uri.EscapeDataString(format)}";
        return Navigation.ToAbsoluteUri(path).ToString();
    }




    private static string PingText(ServerState server)
    {
        return server.Checking
            ? "Checking…"
            : server.Latency switch
            {
                null => "—",
                -1 => "Check failed",
                _ => $"{server.Latency} ms"
            };
    }

    private sealed class ServerState(string name, HostAddress address)
    {
        public string Name { get; } = name;
        public HostAddress Address { get; } = address;
        public bool Checking { get; set; }
        public int? Latency { get; set; }
    }

}
