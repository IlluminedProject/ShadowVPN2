@page "/s/{SubscriptionId:guid}"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout PublicLayout
@implements IAsyncDisposable
@inject ISubscriptionApplicationService SubscriptionApi
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<PageTitle>Connection setup - ShadowVPN2</PageTitle>

<div class="frontend-content">
    <div class="page-header"><h1>@(_subscription?.ClientName ?? "Connection setup")</h1></div>
    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 text-secondary" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Loading connection details…
        </div>
    }
    else if (_subscription is null)
    {
        <h2>Invalid link</h2>
        <div class="alert alert-danger" role="alert">This subscription link is invalid or has been removed.</div>
    }
    else
    {
        <section class="mb-4">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span class="fw-semibold">Subscription</span>
                <div class="btn-group dropdown" id="subscription-dropdown">
                    <button class="btn btn-outline-secondary" type="button"
                            @onclick="() => CopySubscriptionUrlAsync()" disabled="@_copying">Copy subscription URL
                    </button>
                    <button class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" type="button"
                            data-dropdown-trigger aria-expanded="false" aria-controls="subscription-options"
                            aria-label="Choose subscription format" disabled="@_copying">
                    </button>
                    <ul id="subscription-options" class="dropdown-menu" data-dropdown-popup>
                        @foreach (var format in SubscriptionFormats)
                        {
                            <li>
                                <button class="dropdown-item" type="button" disabled="@_copying"
                                        @onclick="() => CopySubscriptionUrlAsync(format.Key)">@format.Value</button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            @if (CopyError is not null && FeedbackKey?.StartsWith("subscription:") == true)
            {
                <div class="app-status text-danger" role="alert">@CopyError</div>
            }
        </section>
        <section class="mb-4">
            <h2>Available connection hosts</h2>
            @if (!_subscription.Protocols.Any())
            {
                <p class="text-body-secondary">No connection protocols are enabled for this client.</p>
            }

            @foreach (var protocol in _subscription.Protocols)
            {
                if (protocol.Endpoints.Count == 0)
                    continue;

                <h3>@protocol.Protocol</h3>
                @foreach (var endpoint in protocol.Endpoints)
                {
                    <section class="endpoint app-list-item">
                        <div class="flex-grow-1">
                            <h4 class="h6">@endpoint.Name</h4>
                            <dl class="app-details mb-0">
                                <dt>Address</dt>
                                <dd class="font-monospace text-break">@endpoint.Address</dd>
                            </dl>
                            @if (CopyError is not null && (FeedbackKey == ConnectionKey(protocol, endpoint) || endpoint.Transports.OfType<FreeTurnConnectionInfo>().Any(transport => FeedbackKey == $"{endpoint.Name}:{transport.Peer}")))
                            {
                                <div class="app-status text-danger" role="alert">@CopyError</div>
                            }
                        </div>
                        <div class="actions">
                            @if (endpoint.Connection is WireGuardConnectionInfo wireGuard)
                            {
                                <a class="btn btn-outline-secondary" href="@CreateConfigDataUrl(wireGuard)"
                                   download="@CreateConfigFileName(_subscription.ClientName, protocol.Protocol, endpoint.Name, wireGuard.ServerAddress)">
                                    Download VPN config
                                </a>
                            }
                            <button class="btn btn-outline-secondary" type="button"
                                    @onclick="() => CopyConnectionAsync(protocol, endpoint)"
                                    disabled="@_copying">@(_copying && FeedbackKey == ConnectionKey(protocol, endpoint) ? "Copying…" : "Copy connection")</button>
                            @foreach (var transport in endpoint.Transports.OfType<FreeTurnConnectionInfo>())
                            {
                                <button class="btn btn-outline-secondary" type="button"
                                        @onclick="() => CopyFreeTurnAsync(endpoint, transport)"
                                        disabled="@_copying">@(_copying && FeedbackKey == $"{endpoint.Name}:{transport.Peer}" ? "Copying…" : "Copy FreeTurn link")</button>
                            }
                        </div>
                    </section>
                }
            }
        </section>

        @if (_servers.Count > 0)
        {
            <section>
                <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                    <h2 class="mb-0">Server latency</h2>
                    <button class="btn btn-outline-secondary" type="button" @onclick="PingServersAsync"
                            disabled="@_pinging">@(_pinging ? "Checking…" : "Check again")</button>
                </div>
                <p class="text-body-secondary">Measured from your device.</p>
                <div class="app-list">
                    @foreach (var server in _servers)
                    {
                        <div class="app-list-item">
                            <div><span class="fw-semibold">@server.Name</span>
                                <div class="font-monospace text-break">@server.Address</div>
                            </div>
                            <span class="app-status" role="status">@PingText(server)</span>
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    [Parameter] public Guid SubscriptionId { get; set; }

    private SubscriptionResponse? _subscription;
    private bool _loading = true;
    private bool _pinging;
    private readonly List<ServerState> _servers = [];
    private string? FeedbackKey { get; set; }
    private string? CopyError { get; set; }
    private bool _copying;
    private IJSObjectReference? _dropdownModule;

    private static IReadOnlyDictionary<string, string> SubscriptionFormats { get; } =
        new Dictionary<string, string>
        {
            ["Base64"] = "Copy Base64 URL",
            ["Mihomo"] = "Copy Mihomo URL",
            ["MihomoProvider"] = "Copy Mihomo provider URL",
            ["FreeTurn"] = "Copy FreeTurn URL"
        };

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _subscription = await SubscriptionApi.GetSubscriptionAsync(SubscriptionId);
            BuildServerList();
        }
        catch (ApplicationServiceException)
        {
            _subscription = null;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_subscription is not null)
        {
            _dropdownModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/ShadowVPN2.Frontend/js/dropdown.js");
            await _dropdownModule.InvokeVoidAsync("initialize", "subscription-dropdown");
        }

        if (firstRender && _servers.Count > 0)
            await PingServersAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_dropdownModule is null) return;
        try
        {
            await _dropdownModule.InvokeVoidAsync("dispose", "subscription-dropdown");
            await _dropdownModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void BuildServerList()
    {
        _servers.Clear();
        if (_subscription is null)
            return;

        _servers.AddRange(_subscription.Protocols.SelectMany(protocol => protocol.Endpoints)
            .DistinctBy(endpoint => endpoint.Address)
            .Select(endpoint => new ServerState(endpoint.Name, endpoint.Address)));
    }

    private async Task PingServersAsync()
    {
        if (_pinging) return;
        _pinging = true;
        foreach (var server in _servers)
        {
            server.Checking = true;
            server.Latency = null;
        }

        StateHasChanged();

        await Task.WhenAll(_servers.Select(async server =>
        {
            try
            {
                server.Latency = await JsRuntime.InvokeAsync<int>("pingServer",
                    $"https://{server.Address}/api/node/status", 3000);
            }
            catch (JSException)
            {
                server.Latency = -1;
            }
            finally
            {
                server.Checking = false;
                await InvokeAsync(StateHasChanged);
            }
        }));
        _pinging = false;
    }

    private async Task CopyConnectionAsync(ProtocolSubscription protocol, SubscriptionEndpoint endpoint)
    {
        var shareUrl = endpoint.Connection switch
        {
            Hysteria2ConnectionInfo hysteria2 => SubscriptionLinkBuilder.CreateHysteria2ShareUrl(hysteria2,
                _subscription!.ClientName),
            NaiveProxyConnectionInfo naiveProxy => SubscriptionLinkBuilder.CreateNaiveProxyShareUrl(naiveProxy,
                _subscription!.ClientName),
            WireGuardConnectionInfo wireGuard => SubscriptionLinkBuilder.CreateWireGuardShareUrl(wireGuard),
            _ => string.Empty
        };
        await CopyAsync(shareUrl, ConnectionKey(protocol, endpoint));
    }

    private string CreateSubscriptionUrl(string? format)
    {
        var path = $"s/{SubscriptionId}/subscription";
        if (format is not null)
            path += $"?format={Uri.EscapeDataString(format)}";
        return Navigation.ToAbsoluteUri(path).ToString();
    }

    private Task CopySubscriptionUrlAsync(string? format = null)
    {
        return CopyAsync(CreateSubscriptionUrl(format), $"subscription:{format}");
    }

    private async Task CopyFreeTurnAsync(SubscriptionEndpoint endpoint, FreeTurnConnectionInfo transport)
    {
        var localConnection = SubscriptionLinkBuilder.CreateLocalConnection(endpoint.Connection);
        var wireGuardConfig = localConnection is WireGuardConnectionInfo wireGuard
            ? SubscriptionLinkBuilder.CreateWireGuardConfig(wireGuard)
            : null;
        var shareUrl = SubscriptionLinkBuilder.CreateFreeTurnShareUrl(transport, _subscription!.ClientName,
            wireGuardConfig);
        await CopyAsync(shareUrl, $"{endpoint.Name}:{transport.Peer}");
    }

    private async Task CopyAsync(string text, string key)
    {
        _copying = true;
        CopyError = null;
        FeedbackKey = key;
        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            FeedbackKey = null;
        }
        catch (JSException)
        {
            CopyError = "Could not copy. Allow clipboard access and try again.";
        }
        finally
        {
            _copying = false;
        }
    }

    private static string ConnectionKey(ProtocolSubscription protocol, SubscriptionEndpoint endpoint)
    {
        return $"{protocol.Protocol}:{endpoint.Address}";
    }

    private static string CreateConfigDataUrl(WireGuardConnectionInfo wireGuard)
    {
        return $"data:text/plain;charset=utf-8;base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(SubscriptionLinkBuilder.CreateWireGuardConfig(wireGuard)))}";
    }

    private static string CreateConfigFileName(string clientName, string protocol, string endpointName,
        HostName serverAddress)
    {
        var invalidChars = Path.GetInvalidFileNameChars();
        var parts = new[] { "shadowvpn", clientName, protocol, endpointName, serverAddress.ToString() }
            .Select(part => new string(part.Trim().Select(character => char.IsControl(character) ||
                                                                       invalidChars.Contains(character) || character is '/' or '\\'
                    ? '-'
                    : character).ToArray())
                .Trim(' ', '.', '-'))
            .Where(part => part.Length > 0);
        var name = string.Join('-', parts);
        return $"{name[..Math.Min(name.Length, 180)]}.conf";
    }

    private static string PingText(ServerState server)
    {
        return server.Checking
            ? "Checking…"
            : server.Latency switch
            {
                null => "—",
                -1 => "Unavailable",
                _ => $"{server.Latency} ms"
            };
    }

    private sealed class ServerState(string name, HostAddress address)
    {
        public string Name { get; } = name;
        public HostAddress Address { get; } = address;
        public bool Checking { get; set; }
        public int? Latency { get; set; }
    }

}
