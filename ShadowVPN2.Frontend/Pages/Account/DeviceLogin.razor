@page "/Account/DeviceLogin"
@layout AccountLayout
@attribute [AllowAnonymous]
@implements IAsyncDisposable

<PageTitle>Device login</PageTitle>

<div class="text-center">
    <h1 class="mb-4">Log in with device code</h1>
    <div class="alert @(_error is null ? "alert-info" : "alert-danger")" role="@(_error is null ? "status" : "alert")">
        @if (_error is null)
        {
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
        }
        @_message
    </div>
    @if (_authorization is not null && _error is null)
    {
        <p>Open the verification address on another device and enter the code.</p>
        <dl>
            <dt>Verification address</dt>
            <dd><a class="text-break" href="@(_authorization.VerificationUriComplete ?? _authorization.VerificationUri)"
                   target="_blank" rel="noopener">@_authorization.VerificationUri</a></dd>
            <dt>Device code</dt>
            <dd><code class="fs-3 text-break">@_authorization.UserCode</code></dd>
        </dl>
    }
    <div class="actions justify-content-center mt-4">
        <a href="/Account/Login" class="btn btn-outline-secondary">Back to login</a>
    </div>
</div>

@code {
    [Inject] private IDeviceAuthorizationApplicationService DeviceAuthorization { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ILogger<DeviceLogin> Logger { get; set; } = default!;

    [SupplyParameterFromQuery] private string? TransactionId { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private DeviceAuthorizationStartResponse? _authorization;
    private string _message = "Preparing device authorization...";
    private string? _error;
    private CancellationTokenSource? _cancellation;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (string.IsNullOrWhiteSpace(TransactionId))
        {
            _error = "The device authorization transaction is missing.";
            _message = _error;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            _authorization = await DeviceAuthorization.GetDetailsAsync(TransactionId);
            if (_authorization is null)
            {
                _error = "Device authorization details are unavailable. Return to login to try again.";
                _message = _error;
                await InvokeAsync(StateHasChanged);
                return;
            }
            _message = "Waiting for confirmation...";
            _cancellation = new CancellationTokenSource();
            _ = PollAsync(_cancellation.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception) when (exception is ApplicationServiceException or UnauthorizedAccessException)
        {
            Logger.LogError(exception, "Unable to prepare device authorization");
            _error = "Device authorization could not be prepared. Return to login to try again.";
            _message = _error;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested && _authorization is not null)
        {
            try
            {
                var status = await DeviceAuthorization.PollAsync(TransactionId!, cancellationToken);
                if (status?.Status == "completed")
                {
                    await InvokeAsync(() => Navigation.NavigateTo(
                        $"/api/auth/device/complete/{Uri.EscapeDataString(TransactionId!)}?returnUrl=" +
                        Uri.EscapeDataString(ReturnUrl ?? "/"), true));
                    return;
                }

                if (status?.Status is "expired" or "denied" or "failed")
                {
                    _error = status.Status switch
                    {
                        "expired" => "The device code has expired. Return to login to request a new code.",
                        "denied" => "Device authorization was denied. Return to login to try again.",
                        _ => "Device authorization failed. Return to login to try again."
                    };
                    _message = _error;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                _message = status?.Status == "processing"
                    ? "Waiting for confirmation from the identity provider..."
                    : "Waiting for confirmation...";
                await InvokeAsync(StateHasChanged);
                await Task.Delay(TimeSpan.FromSeconds(Math.Max(1, status?.RetryAfter ?? 2)), cancellationToken);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
            }
            catch (Exception exception) when (exception is ApplicationServiceException or UnauthorizedAccessException)
            {
                Logger.LogError(exception, "Unable to complete device authorization");
                _error = "Device authorization could not be completed. Return to login to try again.";
                _message = _error;
                await InvokeAsync(StateHasChanged);
                return;
            }
            catch (Exception exception)
            {
                await DispatchExceptionAsync(exception);
                return;
            }
        }
    }

    public ValueTask DisposeAsync()
    {
        _cancellation?.Cancel();
        _cancellation?.Dispose();
        return ValueTask.CompletedTask;
    }

}
