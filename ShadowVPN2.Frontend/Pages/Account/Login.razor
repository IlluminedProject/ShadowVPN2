@page "/Account/Login"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@layout AccountLayout
@attribute [AllowAnonymous]
@inject IAuthApplicationService AuthApplicationService
@inject ILogger<Login> Logger

<PageTitle>Log in</PageTitle>
<h1 class="text-center mb-4">Log in</h1>
@if (_loadError is not null)
{
    <div class="alert alert-danger" role="alert">@_loadError</div>
}
else if (_loading)
{
    <div class="app-status" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        Loading sign-in options...
    </div>
}
else
{
    @if (_localLoginEnabled)
    {
        <form method="post" action="/api/auth/login">
            <AntiforgeryToken/>
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl"/>
            @if (Error is not null)
            {
                <div id="login-error" class="alert alert-danger" role="alert">@Error</div>
            }
            <div class="form-floating field">
                <InputText name="Email" id="Email" class="form-control" autocomplete="username"
                           placeholder="name@example.com"
                           required type="email" aria-invalid="@(ErrorCode == "invalid" ? "true" : null)"
                           aria-describedby="@(Error is not null ? "login-error" : null)" @bind-Value="_model.Email"/>
                <label class="form-label" for="Email">Email</label>
            </div>
            <div class="form-floating field">
                <InputText name="Password" id="Password" type="password" class="form-control"
                           autocomplete="current-password" placeholder="Password" required
                           aria-invalid="@(ErrorCode == "invalid" ? "true" : null)"
                           aria-describedby="@(Error is not null ? "login-error" : null)"
                           @bind-Value="_model.Password"/>
                <label class="form-label" for="Password">Password</label>
            </div>
            <div class="form-check field">
                <InputCheckbox id="RememberMe" @bind-Value="_model.RememberMe" name="RememberMe"
                               class="form-check-input"/>
                <label class="form-check-label" for="RememberMe">Remember me</label>
            </div>
            <div class="form-actions">
                <button type="submit" class="w-100 btn btn-primary">Log in</button>
            </div>
        </form>
    }
    else if (Error is not null)
    {
        <div class="alert alert-danger" role="alert">@Error</div>
    }

    @if (_localLoginEnabled || _providers.Count > 0)
    {
        <section class="mt-4" aria-label="Alternative sign-in methods">
            <div class="d-flex flex-column gap-2">
                @if (_localLoginEnabled)
                {
                    <form method="post" action="/api/auth/passkey/sign-in">
                        <AntiforgeryToken/>
                        <input type="hidden" name="ReturnUrl" value="@ReturnUrl"/>
                        <input type="hidden" name="Email" value="@_model.Email"/>
                        <button type="submit" data-passkey-login class="w-100 btn btn-outline-secondary">Log in with a
                            passkey
                        </button>
                    </form>
                }
                @foreach (var provider in _providers)
                {
                    @if (provider.UseDeviceFlow)
                    {
                        <a class="btn btn-outline-secondary w-100"
                           href="/api/auth/device/start-page?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")">Continue
                            with @provider.DisplayName</a>
                    }
                    else
                    {
                        <form method="post" action="/api/auth/external/start">
                            <AntiforgeryToken/>
                            <input type="hidden" name="provider" value="@provider.Name"/>
                            <input type="hidden" name="returnUrl" value="@ReturnUrl"/>
                            <button type="submit" class="btn btn-outline-secondary w-100">Continue
                                with @provider.DisplayName</button>
                        </form>
                    }
                }
            </div>
        </section>
    }
    else
    {
        <p class="text-body-secondary">No sign-in methods are currently available. Contact your administrator.</p>
    }
}

@code {
    private readonly LoginInput _model = new();
    private bool _localLoginEnabled;
    private bool _loading = true;
    private string? _loadError;
    private readonly List<ExternalLoginProviderResponse> _providers = [];

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }
    private string? Error => ErrorCode switch
    {
        "invalid" => "Invalid login attempt. Check your email and password.",
        "expired" => "The login session has expired. Please try again.",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var options = await AuthApplicationService.GetOptionsAsync();
            _providers.AddRange(options.ExternalProviders);
            _localLoginEnabled = options.LocalLoginEnabled;
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            Logger.LogError(exception, "Unable to load sign-in options");
            _loadError = "Sign-in options could not be loaded. Reload the page to try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class LoginInput
    {
        [Required] [EmailAddress] public string Email { get; set; } = string.Empty;
        [Required] public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; }
    }
}
