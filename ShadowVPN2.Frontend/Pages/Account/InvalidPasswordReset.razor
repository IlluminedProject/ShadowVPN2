@page "/Account/InvalidPasswordReset"
@layout AccountLayout
@attribute [AllowAnonymous]

<PageTitle>Invalid password reset</PageTitle>
<h1 class="text-center mb-4">Invalid password reset</h1>
<div class="alert alert-danger" role="alert">The password reset link is invalid.</div>
<div class="actions justify-content-center">
    <a class="btn btn-outline-secondary" href="/Account/Login">Back to login</a>
</div>
