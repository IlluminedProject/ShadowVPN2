@page "/Account/ExternalLogin"
@layout AccountLayout
@attribute [AllowAnonymous]

<PageTitle>External login</PageTitle>

<h1 class="text-center mb-4">External login</h1>
<div class="alert alert-danger text-center" role="alert">The external provider could not complete the sign-in. Return to
    login to try again.
</div>
<div class="actions justify-content-center">
    <a href="/Account/Login" class="btn btn-outline-secondary">Back to login</a>
</div>
