@page "/Account/Manage"
@layout ManageLayout
@attribute [Authorize]

<PageTitle>Profile</PageTitle>
<h2>Profile</h2>
<StatusMessage Message="@Message"/>
@if (_loadError is not null)
{
    <div class="alert alert-danger" role="alert">@_loadError</div>
    <ExceptionDetails Exception="_loadException"/>
}
else if (_profile is null)
{
    <div class="app-status" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        Loading profile...
    </div>
}
else
{
    <dl class="app-details">
        <dt>Username</dt>
        <dd>@_profile.UserName</dd>
        <dt>Email</dt>
        <dd>@_profile.Email</dd>
    </dl>
    @if (AuthOptions.LocalLoginEnabled)
    {
    <form method="post" action="/api/account/profile">
        <AntiforgeryToken/>
        <div class="field">
            <label class="form-label" for="phone-number">Phone number (optional)</label>
            <InputText id="phone-number" class="form-control" name="PhoneNumber" type="tel" autocomplete="tel"
                       @bind-Value="_phoneNumber"/>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
    }
}

@code {
    [Inject] private IAccountApplicationService Account { get; set; } = default!;
    [CascadingParameter] private AuthOptionsResponse AuthOptions { get; set; } = default!;
    [SupplyParameterFromQuery] private string? Message { get; set; }
    private AccountProfileResponse? _profile;
    private string? _phoneNumber;
    private string? _loadError;
    private Exception? _loadException;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await Account.GetProfileAsync();
            _phoneNumber = _profile?.PhoneNumber;
            if (_profile is null) _loadError = "Your profile could not be loaded. Reload the page to try again.";
        }
        catch (ApplicationServiceException exception)
        {
            _loadException = exception;
            _loadError = "Your profile could not be loaded. Reload the page to try again.";
        }
    }
}
