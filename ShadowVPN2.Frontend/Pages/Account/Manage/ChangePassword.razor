@page "/Account/Manage/ChangePassword"
@layout ManageLayout
@attribute [Authorize]
<PageTitle>Change password</PageTitle>
<h3>Change password</h3>
<form method="post" action="/api/account/password">
    <AntiforgeryToken/>
    <InputText class="form-control mb-2" name="CurrentPassword" type="password" placeholder="Current password" required
               @bind-Value="_currentPassword"/>
    <InputText class="form-control mb-2" name="NewPassword" type="password" placeholder="New password" minlength="6"
               required @bind-Value="_newPassword"/>
    <button class="btn btn-primary">Update password</button>
</form>

@code {
    private string? _currentPassword;
    private string? _newPassword;
}
