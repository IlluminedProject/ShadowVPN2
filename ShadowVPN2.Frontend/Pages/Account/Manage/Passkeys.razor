@page "/Account/Manage/Passkeys"
@layout ManageLayout
@attribute [Authorize]
<PageTitle>Passkeys</PageTitle><h3>Manage your passkeys</h3>
@if (_keys is not null)
{
    @foreach (var key in _keys)
    {
        <div class="d-flex gap-2 mb-2"><span>@(key.Name ?? "Unnamed passkey")</span>
            <form method="post" action="/api/account/passkeys/delete">
                <AntiforgeryToken/>
                <input type="hidden" name="Id" value="@key.Id"/>
                <button class="btn btn-sm btn-danger">Delete</button>
            </form>
            <a class="btn btn-sm btn-primary" href="/Account/Manage/RenamePasskey/@key.Id">Rename</a></div>
    }
}
<form method="post" action="/api/auth/passkey/register" class="mt-3">
    <AntiforgeryToken/>
    <button data-passkey-register class="btn btn-primary">Add a new passkey</button>
</form>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private IReadOnlyList<PasskeyResponse>? _keys;
    protected override async Task OnInitializedAsync()
    {
        _keys = await Http.GetFromJsonAsync<IReadOnlyList<PasskeyResponse>>("/api/account/passkeys");
    }

}
