@page "/Account/Manage/EnableAuthenticator"
@using System.Text.Json
@layout ManageLayout
@attribute [Authorize]
<PageTitle>Configure authenticator</PageTitle>
<h2>Configure authenticator app</h2>
<StatusMessage Message="@Message"/>
@if (_loadError is not null)
{
    <div class="alert alert-danger" role="alert">@_loadError</div>
}
else if (_setup is null)
{
    <div class="app-status" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        Loading authenticator setup...
    </div>
}
else
{
    <p>Enter the setup key in your authenticator app, then enter the verification code it displays.</p>
    <dl class="app-details">
        <dt>Setup key</dt>
        <dd><code class="text-break">@_setup.SharedKey</code></dd>
        <dt>Authenticator URI</dt>
        <dd><code class="text-break">@_setup.Uri</code></dd>
    </dl>
    <form method="post" action="/api/account/2fa/enable">
        <AntiforgeryToken/>
        <div class="field">
            <label class="form-label" for="authenticator-code">Verification code</label>
            <InputText id="authenticator-code" class="form-control" name="Code" autocomplete="one-time-code"
                       inputmode="numeric" required @bind-Value="_code"/>
        </div>
        <div class="form-actions">
            <a class="btn btn-outline-secondary" href="/Account/Manage/TwoFactorAuthentication">Cancel</a>
            <button type="submit" class="btn btn-primary">Verify</button>
        </div>
    </form>
}

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ILogger<EnableAuthenticator> Logger { get; set; } = default!;
    [SupplyParameterFromQuery] private string? Message { get; set; }
    private SetupResponse? _setup;
    private string? _code;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _setup = await Http.GetFromJsonAsync<SetupResponse>("/api/account/2fa/setup");
            if (_setup is null) _loadError = "Authenticator setup could not be loaded. Reload the page to try again.";
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            Logger.LogError(exception, "Unable to load authenticator setup");
            _loadError = "Authenticator setup could not be loaded. Reload the page to try again.";
        }
    }

    private sealed class SetupResponse
    {
        public string? SharedKey { get; set; }
        public string? Uri { get; set; }
    }
}
