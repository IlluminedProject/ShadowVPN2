@page "/Account/Manage/Email"
@layout ManageLayout
@attribute [Authorize]
<PageTitle>Manage email</PageTitle>
<h2>Manage email</h2>
<form method="post" action="/api/account/email">
    <AntiforgeryToken/>
    <div class="field">
        <label class="form-label" for="account-email">New email</label>
        <InputText id="account-email" class="form-control" name="Email" type="email" autocomplete="email" required
                   @bind-Value="_email"/>
    </div>
    <div class="form-actions">
        <a class="btn btn-outline-secondary" href="/Account/Manage">Cancel</a>
        <button type="submit" class="btn btn-primary">Change email</button>
    </div>
</form>

@code {
    private string? _email;
}
