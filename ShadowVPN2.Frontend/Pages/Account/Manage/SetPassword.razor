@page "/Account/Manage/SetPassword"
@layout ManageLayout
@attribute [Authorize]
<PageTitle>Set password</PageTitle>
<h2>Set your password</h2>
<form method="post" action="/api/account/password/set">
    <AntiforgeryToken/>
    <div class="field">
        <label class="form-label" for="new-password">New password</label>
        <InputText id="new-password" class="form-control" name="NewPassword" type="password" autocomplete="new-password"
                   aria-describedby="new-password-help" minlength="6" required @bind-Value="_newPassword"/>
        <div id="new-password-help" class="form-text">Use at least 6 characters.</div>
    </div>
    <div class="form-actions">
        <a class="btn btn-outline-secondary" href="/Account/Manage">Cancel</a>
        <button type="submit" class="btn btn-primary">Set password</button>
    </div>
</form>

@code {
    private string? _newPassword;
}
