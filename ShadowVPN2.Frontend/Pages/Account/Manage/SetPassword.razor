@page "/Account/Manage/SetPassword"
@layout ManageLayout
@attribute [Authorize]
<PageTitle>Set password</PageTitle>
<h3>Set your password</h3>
<form method="post" action="/api/account/password/set">
    <AntiforgeryToken/>
    <InputText class="form-control mb-2" name="NewPassword" type="password" placeholder="New password" minlength="6"
               required @bind-Value="_newPassword"/>
    <button class="btn btn-primary">Set password</button>
</form>

@code {
    private string? _newPassword;
}
