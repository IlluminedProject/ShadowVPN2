@page "/Account/Manage/TwoFactorAuthentication"
@using System.Text.Json
@layout ManageLayout
@attribute [Authorize]
<PageTitle>Two-factor authentication</PageTitle>
<h2>Two-factor authentication</h2>
<StatusMessage Message="@Message"/>
@if (_loadError is not null)
{
    <div class="alert alert-danger" role="alert">@_loadError</div>
    <ExceptionDetails Exception="_loadException"/>
}
else if (_profile is null)
{
    <div class="app-status" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        Loading security settings...
    </div>
}
else
{
    <dl class="app-details">
        <dt>Status</dt>
        <dd>@(_profile.TwoFactorEnabled ? "Enabled" : "Disabled")</dd>
        <dt>Recovery codes left</dt>
        <dd>@_profile.RecoveryCodesLeft</dd>
    </dl>
    <div class="actions">
        @if (_profile.TwoFactorEnabled)
        {
            <a class="btn btn-outline-secondary" href="/Account/Manage/GenerateRecoveryCodes">Generate recovery
                codes</a>
            <a class="btn btn-outline-danger" href="/Account/Manage/Disable2fa">Disable 2FA</a>
        }
        else
        {
            <a class="btn btn-primary" href="/Account/Manage/EnableAuthenticator">Configure authenticator</a>
        }
        @if (_profile.HasAuthenticator)
        {
            <a class="btn btn-outline-danger" href="/Account/Manage/ResetAuthenticator">Reset authenticator key</a>
        }
    </div>
}

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ILogger<TwoFactorAuthentication> Logger { get; set; } = default!;
    [SupplyParameterFromQuery] private string? Message { get; set; }
    private AccountProfileResponse? _profile;
    private string? _loadError;
    private Exception? _loadException;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await Http.GetFromJsonAsync<AccountProfileResponse>("/api/account/profile");
            if (_profile is null) _loadError = "Security settings could not be loaded. Reload the page to try again.";
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            Logger.LogError(exception, "Unable to load two-factor settings");
            _loadException = exception;
            _loadError = "Security settings could not be loaded. Reload the page to try again.";
        }
    }
}
