@page "/Account/Manage/RenamePasskey/{Id}"
@layout ManageLayout
@attribute [Authorize]
<PageTitle>Rename passkey</PageTitle>
<h2>Rename passkey</h2>
<form method="post" action="/api/account/passkeys/rename">
    <AntiforgeryToken/>
    <input type="hidden" name="Id" value="@Id"/>
    <div class="field">
        <label class="form-label" for="passkey-name">Passkey name</label>
        <InputText id="passkey-name" class="form-control" name="Name" autocomplete="off" required maxlength="200"
                   @bind-Value="_name"/>
    </div>
    <div class="form-actions">
        <a class="btn btn-outline-secondary" href="/Account/Manage/Passkeys">Cancel</a>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>

@code {
    private string? _name;
}

@code { [Parameter] public string Id { get; set; } = string.Empty; }
