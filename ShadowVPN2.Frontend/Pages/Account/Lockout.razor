@page "/Account/Lockout"
@layout AccountLayout
@attribute [AllowAnonymous]

<PageTitle>Locked out</PageTitle>

<div class="text-center">
    <h1 class="text-danger mb-4">Locked out</h1>
    <div class="alert alert-danger" role="alert">This account has been locked out. Please try again later.</div>
    <div class="actions justify-content-center">
        <a class="btn btn-outline-secondary" href="/Account/Login">Back to login</a>
    </div>
</div>
