@page "/admin/settings/protocols"
@using System.Net
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Settings.View")]
@inject IAdminSettingsService AdminApi

<PageTitle>Protocol settings - ShadowVPN2</PageTitle>

<div>
    <AdminSettingsNav/>
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h1>Protocol settings</h1>
            <p class="muted">Configure VPN protocols and transport overlays.</p>
        </div>
        <div class="dropdown">
            <button class="btn btn-outline-primary dropdown-toggle" type="button"
                    @onclick="ToggleProtocolMenu" aria-expanded="@_protocolMenuOpen">
                Add protocol
            </button>
            @if (_protocolMenuOpen)
            {
                <ul class="dropdown-menu show">
                    <li>
                        <button class="dropdown-item" type="button" @onclick="AddHysteria2">Hysteria2</button>
                    </li>
                    <li>
                        <button class="dropdown-item" type="button" @onclick="AddWireGuard">WireGuard / AmneziaWG
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" type="button" @onclick="AddNaiveProxy">NaiveProxy</button>
                    </li>
                </ul>
            }
        </div>
    </div>

    @if (_loading)
    {
        <p class="muted">Loading protocol settings…</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    else
    {
        <div class="settings-frame">
            <label class="form-label" for="main-domain">Global main domain</label>
            <InputText id="main-domain" class="form-control" @bind-Value="_request.MainDomain"
                       placeholder="vpn.example.com"/>

            @foreach (var item in _request.Protocols.ToArray())
            {
                <section class="settings-item">
                    <SettingsItemHeader Title="@ProtocolName(item)"
                                        @bind-ListenPort="item.ListenPort"
                                        @bind-Enabled="item.Enabled"
                                        OnRemove="() => RemoveProtocol(item)"/>
                    <div class="settings-item-body border border-top-0 rounded-bottom p-3">
                        <label class="form-label">Main domain override
                            <InputText class="form-control" @bind-Value="item.MainDomain"/>
                        </label>
                        @{ var protocolIndex = _request.Protocols.IndexOf(item); }
                        @if (protocolIndex >= 0 && protocolIndex < _domainRoutes.Count &&
                             _domainRoutes[protocolIndex].State != ProtocolDomainRouteState.NoDomain)
                        {
                            <p class="muted">
                                @_domainRoutes[protocolIndex].Domain — @_domainRoutes[protocolIndex].State
                                @if (_domainRoutes[protocolIndex].NodeName is not null)
                                {
                                    <span> (@_domainRoutes[protocolIndex].NodeName)</span>
                                }
                            </p>
                        }
                        @if (item is Hysteria2ProtocolSettingsDto hysteria2)
                        {
                            <label>Obfuscation type
                                <InputSelect class="form-select" @bind-Value="hysteria2.ObfsType">
                                    <option value="salamander">salamander</option>
                                    <option value="none">none</option>
                                </InputSelect>
                            </label>
                            @if (hysteria2.ObfsType != "none")
                            {
                                <label>Obfuscation password
                                    <InputText class="form-control" @bind-Value="hysteria2.ObfsPassword"/>
                                </label>
                            }

                            <p class="muted">TLS
                                certificate: @(hysteria2.HasTlsCertificate ? "generated" : "missing")</p>
                            <button class="btn btn-outline-primary"
                                    @onclick="() => RegenerateCertificateAsync(hysteria2.Id)" disabled="@_saving">
                                Regenerate TLS certificate
                            </button>
                        }
                        else if (item is AwgProtocolSettingsDto awg)
                        {
                            <details>
                                <summary>AmneziaWG parameters</summary>
                                <p class="muted">H1-H4 and S1-S4 must match between all nodes.</p>
                                <div class="settings-grid">
                                    <label>H1
                                        <InputText class="form-control" @bind-Value="awg.H1"/>
                                    </label>
                                    <label>H2
                                        <InputText class="form-control" @bind-Value="awg.H2"/>
                                    </label>
                                    <label>H3
                                        <InputText class="form-control" @bind-Value="awg.H3"/>
                                    </label>
                                    <label>H4
                                        <InputText class="form-control" @bind-Value="awg.H4"/>
                                    </label>
                                    <label>Jc
                                        <InputNumber class="form-control" @bind-Value="awg.Jc"/>
                                    </label>
                                    <label>Jmin
                                        <InputNumber class="form-control" @bind-Value="awg.Jmin"/>
                                    </label>
                                    <label>Jmax
                                        <InputNumber class="form-control" @bind-Value="awg.Jmax"/>
                                    </label>
                                    <label>S1
                                        <InputNumber class="form-control" @bind-Value="awg.S1"/>
                                    </label>
                                    <label>S2
                                        <InputNumber class="form-control" @bind-Value="awg.S2"/>
                                    </label>
                                    <label>S3
                                        <InputNumber class="form-control" @bind-Value="awg.S3"/>
                                    </label>
                                    <label>S4
                                        <InputNumber class="form-control" @bind-Value="awg.S4"/>
                                    </label>
                                    <label>I1
                                        <InputText class="form-control font-monospace" @bind-Value="awg.I1"/>
                                    </label>
                                    <label>I2
                                        <InputText class="form-control font-monospace" @bind-Value="awg.I2"/>
                                    </label>
                                    <label>I3
                                        <InputText class="form-control font-monospace" @bind-Value="awg.I3"/>
                                    </label>
                                    <label>I4
                                        <InputText class="form-control font-monospace" @bind-Value="awg.I4"/>
                                    </label>
                                    <label>I5
                                        <InputText class="form-control font-monospace" @bind-Value="awg.I5"/>
                                    </label>
                                </div>
                            </details>
                        }
                        else if (item is NaiveProxyProtocolSettingsDto naiveProxy)
                        {
                            <p class="muted">TCP only. A matching managed certificate is validated normally; otherwise
                                subscriptions use a pinned self-signed certificate.</p>
                            <p class="muted">Fallback
                                certificate: @(naiveProxy.HasTlsCertificate ? "generated" : "will be generated on save")</p>
                            <button class="btn btn-outline-primary"
                                    @onclick="() => RegenerateCertificateAsync(naiveProxy.Id)"
                                    disabled="@(_saving || !naiveProxy.HasTlsCertificate)">
                                Regenerate fallback certificate
                            </button>
                        }
                    </div>
                </section>
            }

        </div>
        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">Save settings</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <p role="status">@_message</p>
    }
</div>

@code {
    private UpdateProtocolsSettingsRequest _request = new();
    private IReadOnlyList<ProtocolDomainRouteResponse> _domainRoutes = [];
    private bool _loading = true;
    private bool _saving;
    private bool _protocolMenuOpen;
    private string? _error;
    private string? _message;

    private void ToggleProtocolMenu()
    {
        _protocolMenuOpen = !_protocolMenuOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await AdminApi.GetProtocolsAsync();
            _request = new UpdateProtocolsSettingsRequest
            {
                MainDomain = settings.MainDomain,
                Protocols = settings.Protocols,
                Transports = settings.Transports
            };
            _domainRoutes = await LoadDomainRoutesAsync();
        }
        catch (ApplicationServiceException ex)
        {
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to view settings."
                : "Could not load protocol settings.";
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<IReadOnlyList<ProtocolDomainRouteResponse>> LoadDomainRoutesAsync()
    {
        try
        {
            return await NodesApi.GetProtocolDomainRoutesAsync();
        }
        catch (Exception)
        {
            return [];
        }
    }

    private void AddHysteria2()
    {
        _protocolMenuOpen = false;
        var settings = new Hysteria2ProtocolSettingsDto
        {
            Id = Guid.NewGuid(),
            Enabled = true,
            ListenPort = NextPort(4443),
            ObfsPassword = Convert.ToHexString(RandomNumberGenerator.GetBytes(16)).ToLowerInvariant()
        };
        _request.Protocols.Add(settings);
    }

    private void AddWireGuard()
    {
        _protocolMenuOpen = false;
        _request.Protocols.Add(new AwgProtocolSettingsDto
        {
                Id = Guid.NewGuid(),
                Enabled = true,
                ListenPort = NextPort(51820)
        });
    }

    private void AddNaiveProxy()
    {
        _protocolMenuOpen = false;
        _request.Protocols.Add(new NaiveProxyProtocolSettingsDto
        {
                Id = Guid.NewGuid(),
                Enabled = true,
                ListenPort = NextPort(443)
        });
    }

    private int NextPort(int start)
    {
        var used = _request.Protocols.Select(protocol => protocol.ListenPort).ToHashSet();
        while (used.Contains(start)) start++;
        return start;
    }

    private void RemoveProtocol(ProtocolSettingsDto protocol)
    {
        _request.Protocols.Remove(protocol);
        _request.Transports.RemoveAll(transport => transport.ProtocolId == protocol.Id);
    }

    private static string ProtocolName(ProtocolSettingsDto protocol)
    {
        return protocol switch
        {
                Hysteria2ProtocolSettingsDto => "Hysteria2",
                AwgProtocolSettingsDto => "WireGuard / AmneziaWG",
                NaiveProxyProtocolSettingsDto => "NaiveProxy",
                _ => "Unknown"
        };
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _message = null;
        try
        {
            await AdminApi.SaveProtocolsAsync(_request);
            var settings = await AdminApi.GetProtocolsAsync();
            _request = new UpdateProtocolsSettingsRequest
            {
                    MainDomain = settings.MainDomain,
                    Protocols = settings.Protocols,
                    Transports = settings.Transports
            };
            _domainRoutes = await LoadDomainRoutesAsync();
            _message = "Protocol settings saved. Nodes will update automatically.";
        }
        catch (ApplicationServiceException ex)
        {
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to change settings."
                : "Could not save protocol settings.";
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RegenerateCertificateAsync(Guid protocolId)
    {
        _saving = true;
        _error = null;
        _message = null;
        try
        {
            await AdminApi.RegenerateProtocolCertificateAsync(protocolId);
            var settings = await AdminApi.GetProtocolsAsync();
            _request.Protocols = settings.Protocols;
            _message = "TLS certificate regenerated.";
        }
        catch (ApplicationServiceException ex)
        {
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to change settings."
                : "Could not regenerate the TLS certificate.";
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
        finally
        {
            _saving = false;
        }
    }

    [Inject] private INodeApplicationService NodesApi { get; set; } = default!;
}
