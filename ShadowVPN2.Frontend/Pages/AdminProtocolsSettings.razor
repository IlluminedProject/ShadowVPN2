@page "/admin/protocols"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Settings.View")]
@inject IAdminSettingsService AdminApi
@inject ILogger<AdminProtocolsSettings> Logger
@inject IJSRuntime JsRuntime
@using System.Net
@implements IAsyncDisposable

<PageTitle>Protocols - ShadowVPN2</PageTitle>

<div>
    <div class="page-header">
        <div>
            <h1>Protocols</h1>
            <p class="text-body-secondary mb-0">Configure VPN protocols.</p>
        </div>
        <div class="dropdown" id="protocol-dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-dropdown-trigger
                    aria-expanded="false" aria-controls="protocol-options"
                    disabled="@(_loading || !_loaded || _saving)">Add protocol
            </button>
            <ul id="protocol-options" class="dropdown-menu" data-dropdown-popup>
                <li>
                    <button class="dropdown-item" type="button" @onclick="AddHysteria2">Hysteria2</button>
                </li>
                <li>
                    <button class="dropdown-item" type="button" @onclick="AddWireGuard">WireGuard / AmneziaWG</button>
                </li>
                <li>
                    <button class="dropdown-item" type="button" @onclick="AddNaiveProxy">NaiveProxy</button>
                </li>
                <li>
                    <button class="dropdown-item" type="button" @onclick="AddNaiveProxyQuic">NaiveProxy · HTTP/3 (UDP)
                    </button>
                </li>
            </ul>
        </div>
    </div>

    @if (_loading)
    {
        <div class="app-status text-body-secondary" role="status"><span class="spinner-border spinner-border-sm"
                                                                        aria-hidden="true"></span> Loading protocol
            settings…
        </div>
    }
    else if (!_loaded)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    else
    {
        <EditForm @key="_request" Model="_request" OnValidSubmit="SaveAsync" class="settings-frame">
        <DataAnnotationsValidator/>
            <Blazilla.FluentValidator Validator="_awgValidator"/>
        <ValidationSummary/>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }
            <fieldset disabled="@_saving">
                <legend class="visually-hidden">Protocol settings</legend>
                <div class="field">
                    <label class="form-label" for="main-domain">Global main domain (optional)</label>
                    <InputHostName id="main-domain" class="form-control" @bind-Value="_request.MainDomain"
                                   DisplayName="Global main domain" placeholder="vpn.example.com"
                                   aria-describedby="main-domain-error"/>
                    <div id="main-domain-error">
                        <ValidationMessage For="() => _request.MainDomain"/>
                    </div>
                </div>
                @if (_request.Protocols.Count == 0)
                {
                    <p class="text-body-secondary">No protocols configured. Use Add protocol to configure a connection
                        protocol.</p>
                }
            @foreach (var item in _request.Protocols.ToArray())
            {
                <section @key="item" class="settings-item">
                    @switch (item)
                    {
                        case IPortBindingSettings bindingHeader:
                            <SettingsItemHeader Title="@ProtocolName(item)" RangeAllowed="true"
                                                @bind-PortBinding="bindingHeader.PortBinding"
                                                @bind-Enabled="item.Enabled"
                                                @bind-PublishDirectConnection="item.PublishDirectConnection"
                                                Busy="_saving" OnRemove="() => RequestRemoveProtocol(item)"/>
                            break;
                        case IListenPortSettings portHeader:
                            <SettingsItemHeader Title="@ProtocolName(item)" @bind-ListenPort="portHeader.ListenPort"
                                                AllowUnsetPort="@(item is NaiveProxyQuicProtocolSettingsDto)"
                                                @bind-Enabled="item.Enabled"
                                                @bind-PublishDirectConnection="item.PublishDirectConnection"
                                                Busy="_saving" OnRemove="() => RequestRemoveProtocol(item)"/>
                            break;
                    }
                    <div class="settings-item-body">
                        <div class="field">
                            <label class="form-label" for="@($"protocol-{item.Id}-domain")">Main domain override
                                (optional)</label>
                            <InputHostName id="@($"protocol-{item.Id}-domain")" class="form-control"
                                           @bind-Value="item.MainDomain" DisplayName="Main domain override"
                                           aria-describedby="@($"protocol-{item.Id}-domain-error")"/>
                            <div id="@($"protocol-{item.Id}-domain-error")">
                                <ValidationMessage For="() => item.MainDomain"/>
                            </div>
                        </div>
                        @{ var protocolIndex = _request.Protocols.IndexOf(item); }
                        @if (protocolIndex >= 0 && protocolIndex < _domainRoutes.Count &&
                             _domainRoutes[protocolIndex].State != ProtocolDomainRouteState.NoDomain)
                        {
                            <dl class="app-details field">
                                <dt>Domain route</dt>
                                <dd><code class="text-break">@_domainRoutes[protocolIndex].Domain</code></dd>
                                <dt>Status</dt>
                                <dd>@_domainRoutes[protocolIndex].State</dd>
                                <dt>Node</dt>
                                <dd>@(_domainRoutes[protocolIndex].NodeName ?? "—")</dd>
                            </dl>
                        }
                        @if (item is Hysteria2ProtocolSettingsDto hysteria2)
                        {
                            <div class="field">
                                <label class="form-label" for="@($"protocol-{item.Id}-obfs")">Obfuscation type</label>
                                <InputSelect id="@($"protocol-{item.Id}-obfs")" class="form-select"
                                             @bind-Value="hysteria2.ObfsType">
                                    <option value="salamander">salamander</option>
                                    <option value="none">none</option>
                                </InputSelect>
                            </div>
                            @if (hysteria2.ObfsType != "none")
                            {
                                <div class="field"><label class="form-label" for="@($"protocol-{item.Id}-password")">Obfuscation
                                        password</label>
                                    <InputText id="@($"protocol-{item.Id}-password")" class="form-control"
                                               @bind-Value="hysteria2.ObfsPassword"/>
                                </div>
                            }

                            <dl class="app-details field">
                                <dt>TLS certificate</dt>
                                <dd>@(hysteria2.HasTlsCertificate ? "Generated" : "Missing")</dd>
                            </dl>
                            <button class="btn btn-outline-secondary" type="button"
                                    @onclick="() => RegenerateCertificateAsync(hysteria2.Id)" disabled="@_saving">
                                @(_regenerating == hysteria2.Id ? "Regenerating…" : "Regenerate TLS certificate")
                            </button>
                        }
                        else if (item is AwgProtocolSettingsDto awg)
                        {
                            <div class="alert @(awg.IsAmneziaWg ? "alert-warning" : "alert-success")" role="status">
                                @(awg.IsAmneziaWg
                                    ? "AmneziaWG only: these parameters are not compatible with standard WireGuard clients."
                                    : "Compatible with standard WireGuard and AmneziaWG clients.")
                            </div>
                            <details>
                                <summary>AmneziaWG parameters</summary>
                                <AwgParameters IdPrefix="@($"protocol-{item.Id}")" Model="awg"/>
                            </details>
                        }
                        else if (item is NaiveProxyProtocolSettingsDto naiveProxy)
                        {
                            <p class="text-body-secondary">TCP only. A matching managed certificate is validated
                                normally; otherwise subscriptions use a pinned self-signed certificate.</p>
                            <dl class="app-details field">
                                <dt>Fallback certificate</dt>
                                <dd>@(naiveProxy.HasTlsCertificate ? "Generated" : "Will be generated on save")</dd>
                            </dl>
                            <button class="btn btn-outline-secondary" type="button"
                                    @onclick="() => RegenerateCertificateAsync(naiveProxy.Id)"
                                    disabled="@(_saving || !naiveProxy.HasTlsCertificate)">
                                @(_regenerating == naiveProxy.Id ? "Regenerating…" : "Regenerate fallback certificate")
                            </button>
                        }
                        else if (item is NaiveProxyQuicProtocolSettingsDto naiveQuic)
                        {
                            <p class="text-body-secondary">HTTP/3 over UDP. A matching managed certificate is validated
                                normally; otherwise subscriptions use a pinned self-signed certificate.</p>
                            <dl class="app-details field">
                                <dt>Fallback certificate</dt>
                                <dd>@(naiveQuic.HasTlsCertificate ? "Generated" : "Will be generated on save")</dd>
                            </dl>
                            <button class="btn btn-outline-secondary" type="button"
                                    @onclick="() => RegenerateCertificateAsync(naiveQuic.Id)"
                                    disabled="@(_saving || !naiveQuic.HasTlsCertificate)">
                                @(_regenerating == naiveQuic.Id ? "Regenerating…" : "Regenerate fallback certificate")
                            </button>
                        }
                    </div>
                </section>
            }

                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert alert-success app-status mt-3" role="status">@_message</div>
                }
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit"
                            disabled="@_saving">@(_saving && _regenerating is null ? "Saving…" : "Save settings")</button>
                </div>
            </fieldset>
        </EditForm>
    }
</div>
@if (_pendingRemoval is not null)
{
    <ConfirmDialog Title="Remove protocol"
                   Message="@($"Remove {ProtocolName(_pendingRemoval)} on port {ProtocolPort(_pendingRemoval)} and its transport overlays? The change takes effect when you save settings.")"
                   ConfirmText="Remove protocol" OnConfirm="ConfirmRemoveProtocol"
                   OnCancel="() => _pendingRemoval = null"/>
}

@code {
    private UpdateProtocolsSettingsRequest _request = new();
    private IReadOnlyList<ProtocolDomainRouteResponse> _domainRoutes = [];
    private int _meshPort;
    private bool _loading = true;
    private bool _saving;
    private bool _loaded;
    private readonly HashSet<Guid> _savedProtocols = [];
    private ProtocolSettingsDto? _pendingRemoval;
    private Guid? _regenerating;
    private IJSObjectReference? _dropdownModule;
    private string? _error;
    private string? _message;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _dropdownModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/ShadowVPN2.Frontend/js/dropdown.js");
        await _dropdownModule.InvokeVoidAsync("initialize", "protocol-dropdown");
    }

    public async ValueTask DisposeAsync()
    {
        if (_dropdownModule is null) return;
        try
        {
            await _dropdownModule.InvokeVoidAsync("dispose", "protocol-dropdown");
            await _dropdownModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void RequestRemoveProtocol(ProtocolSettingsDto protocol)
    {
        if (_savedProtocols.Contains(protocol.Id)) _pendingRemoval = protocol;
        else RemoveProtocol(protocol);
    }

    private void ConfirmRemoveProtocol()
    {
        if (_pendingRemoval is not null) RemoveProtocol(_pendingRemoval);
        _pendingRemoval = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await AdminApi.GetProtocolsAsync();
            _meshPort = (await AdminApi.GetAwgSettingsAsync()).ListenPort;
            _request = new UpdateProtocolsSettingsRequest
            {
                MainDomain = settings.MainDomain,
                Protocols = settings.Protocols,
                Transports = settings.Transports
            };
            _domainRoutes = await LoadDomainRoutesAsync();
            _savedProtocols.UnionWith(_request.Protocols.Select(protocol => protocol.Id));
            _loaded = true;
        }
        catch (ApplicationServiceException ex)
        {
            Logger.LogWarning(ex, "Could not load protocol settings");
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to view settings."
                : "Could not load protocol settings.";
        }
        finally
        {
            _loading = false;
        }
    }

    private readonly UpdateProtocolsSettingsValidator _awgValidator = new();

    private Task<IReadOnlyList<ProtocolDomainRouteResponse>> LoadDomainRoutesAsync()
    {
        return NodesApi.GetProtocolDomainRoutesAsync();
    }

    private void AddHysteria2()
    {
        var port = NextPort(4443);
        if (port is null) return;
        var settings = new Hysteria2ProtocolSettingsDto
        {
            Id = Guid.NewGuid(),
            Enabled = true,
            PortBinding = new PortBinding(port.Value),
            ObfsPassword = Convert.ToHexString(RandomNumberGenerator.GetBytes(16)).ToLowerInvariant()
        };
        _request.Protocols.Add(settings);
    }

    private void AddWireGuard()
    {
        var port = NextPort(51820);
        if (port is null) return;
        _request.Protocols.Add(new AwgProtocolSettingsDto
        {
                Id = Guid.NewGuid(),
                Enabled = true,
                ListenPort = port.Value
        });
    }

    private void AddNaiveProxy()
    {
        var port = NextPort(443, false);
        if (port is null) return;
        _request.Protocols.Add(new NaiveProxyProtocolSettingsDto
        {
                Id = Guid.NewGuid(),
                Enabled = true,
                ListenPort = port.Value
        });
    }

    private void AddNaiveProxyQuic()
    {
        _request.Protocols.Add(new NaiveProxyQuicProtocolSettingsDto
        {
            Id = Guid.NewGuid(),
            Enabled = true
        });
    }

    private int? NextPort(int start, bool reserveMesh = true)
    {
        var port = AvailablePortFinder.Find(start,
            _request.Protocols, _request.Transports, reserveMesh ? _meshPort : null);
        if (port is null)
        {
            _error = "No free listen ports are available.";
        }
        return port;
    }

    private void RemoveProtocol(ProtocolSettingsDto protocol)
    {
        _request.Protocols.Remove(protocol);
        _request.Transports.RemoveAll(transport => transport.ProtocolId == protocol.Id);
    }

    private static string ProtocolName(ProtocolSettingsDto protocol)
    {
        return protocol switch
        {
                Hysteria2ProtocolSettingsDto => "Hysteria2",
                AwgProtocolSettingsDto => "WireGuard / AmneziaWG",
                NaiveProxyProtocolSettingsDto => "NaiveProxy",
                NaiveProxyQuicProtocolSettingsDto => "NaiveProxy · HTTP/3 (UDP)",
                _ => "Unknown"
        };
    }

    private static string ProtocolPort(ProtocolSettingsDto protocol)
    {
        return protocol switch
        {
            IPortBindingSettings binding => binding.PortBinding.ToString(),
            IListenPortSettings port => port.ListenPort.ToString(),
            _ => string.Empty
        };
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _message = null;
        try
        {
            await AdminApi.SaveProtocolsAsync(_request);
            var settings = await AdminApi.GetProtocolsAsync();
            _request = new UpdateProtocolsSettingsRequest
            {
                    MainDomain = settings.MainDomain,
                    Protocols = settings.Protocols,
                    Transports = settings.Transports
            };
            _domainRoutes = await LoadDomainRoutesAsync();
            _savedProtocols.Clear();
            _savedProtocols.UnionWith(_request.Protocols.Select(protocol => protocol.Id));
            _message = "Protocol settings saved. Nodes will update automatically.";
        }
        catch (ApplicationServiceException ex)
        {
            Logger.LogWarning(ex, "Could not save protocol settings");
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to change settings."
                : "Could not save protocol settings.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RegenerateCertificateAsync(Guid protocolId)
    {
        _regenerating = protocolId;
        _saving = true;
        _error = null;
        _message = null;
        try
        {
            await AdminApi.RegenerateProtocolCertificateAsync(protocolId);
            var settings = await AdminApi.GetProtocolsAsync();
            _request.Protocols = settings.Protocols;
            _message = "TLS certificate regenerated.";
        }
        catch (ApplicationServiceException ex)
        {
            Logger.LogWarning(ex, "Could not regenerate the TLS certificate for protocol {ProtocolId}", protocolId);
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to change settings."
                : "Could not regenerate the TLS certificate.";
        }
        finally
        {
            _saving = false;
            _regenerating = null;
        }
    }

    [Inject] private INodeApplicationService NodesApi { get; set; } = default!;
}
