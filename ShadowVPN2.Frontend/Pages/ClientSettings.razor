@page "/devices/settings/{*ClientId}"
@using System.ComponentModel.DataAnnotations
@using System.Net
@rendermode InteractiveServer
@attribute [Authorize]
@inject IClientApplicationService ClientsApi
@inject NavigationManager Navigation
@inject ILogger<ClientSettings> Logger

<PageTitle>Device settings - ShadowVPN2</PageTitle>

<div>
    <div class="page-header">
        <h1>Device settings</h1>
        <div class="actions"><a class="btn btn-outline-secondary" href="/devices">Back to VPN devices</a></div>
    </div>

    @if (_loading)
    {
        <div class="app-status text-body-secondary" role="status"><span class="spinner-border spinner-border-sm"
                                                                        aria-hidden="true"></span> Loading device…
        </div>
    }
    else if (!_authenticated)
    {
        <p>You need to sign in to manage VPN devices.</p>
        <a class="btn btn-primary" href="@LoginUrl">Sign in</a>
    }
    else if (_client is null)
    {
        <div class="alert alert-danger" role="alert">Device not found or access denied.</div>
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="SaveAsync" class="settings-frame">
            <DataAnnotationsValidator/>
            <ValidationSummary/>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }
            <fieldset disabled="@_saving">
                <legend class="visually-hidden">Device settings</legend>
                <div class="field">
                    <label class="form-label" for="client-name">Device name</label>
                    <InputText id="client-name" class="form-control" @bind-Value="_form.Name"
                               aria-describedby="client-name-error"/>
                    <div id="client-name-error">
                        <ValidationMessage For="() => _form.Name"/>
                    </div>
                </div>
                <div class="form-check form-switch field">
                    <InputCheckbox id="client-enabled" class="form-check-input" @bind-Value="_form.IsEnabled"/>
                    <label class="form-check-label" for="client-enabled">Enabled</label>
                </div>
                <div class="field">
                    <label class="form-label" for="client-mtu">WireGuard MTU (bytes, optional)</label>
                    <InputNumber id="client-mtu" class="form-control" inputmode="numeric"
                                 @bind-Value="_form.WireGuardMtu" aria-describedby="client-mtu-hint client-mtu-error"/>
                    <div id="client-mtu-hint" class="form-text">Enter a value from 576 to 9000 bytes, or leave blank to
                        use the default.
                    </div>
                    <div id="client-mtu-error">
                        <ValidationMessage For="() => _form.WireGuardMtu"/>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert alert-success app-status" role="status">@_message</div>
                }
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit"
                            disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
                </div>
            </fieldset>
        </EditForm>

        <section class="mt-4">
            <h2>Connection details</h2>
            <dl class="app-details">
                <dt>Assigned IP</dt>
                <dd class="font-monospace text-break">@_client.AssignedIp</dd>
                <dt>Subscription</dt>
                <dd><a class="btn btn-outline-secondary" href="/s/@_client.SubscriptionId" target="_blank"
                       rel="noopener">Open
                        subscription</a></dd>
                @if (_client.Hysteria2 is not null)
                {
                    <dt>Hysteria2 password</dt>
                    <dd><code class="text-break">@_client.Hysteria2.Password</code></dd>
                }
            </dl>
        </section>
    }
</div>

@code {
    [Parameter] public string? ClientId { get; set; }

    private ClientResponse? _client;
    private FormModel _form = new();
    private bool _loading = true;
    private bool _authenticated;
    private bool _saving;
    private string? _error;
    private string? _message;

    private string LoginUrl => $"/Account/Login?returnUrl={Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)}";

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        try
        {
            if (!string.IsNullOrWhiteSpace(ClientId))
            {
                _client = await ClientsApi.GetClientAsync(Uri.UnescapeDataString(ClientId));
                _form = new FormModel
                {
                        Name = _client.Name,
                        IsEnabled = _client.IsEnabled,
                        WireGuardMtu = _client.WireGuard?.Mtu
                };
            }

            _authenticated = true;
        }
        catch (ApplicationServiceException exception)
        {
            Logger.LogError(exception, "Unable to load device settings");
            if (exception.StatusCode == HttpStatusCode.Unauthorized)
                _authenticated = false;
            else if (exception.StatusCode == HttpStatusCode.NotFound)
                _error = "Could not load device settings.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_client is null)
            return;

        _saving = true;
        _error = null;
        _message = null;
        try
        {
            var request = new UpdateClientRequest
            {
                    Name = _form.Name,
                    IsEnabled = _form.IsEnabled,
                    WireGuard = _client.WireGuard is null && !_form.WireGuardMtu.HasValue
                            ? null
                            : new WireGuardClientSettingsRequest { Mtu = _form.WireGuardMtu }
            };
            _client = await ClientsApi.UpdateClientAsync(_client.Id, request);
            _message = "Settings saved.";
        }
        catch (ApplicationServiceException exception)
        {
            Logger.LogError(exception, "Unable to save device settings");
            if (exception.StatusCode == HttpStatusCode.Unauthorized)
                _authenticated = false;
            else
                _error = "Could not save device settings.";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class FormModel
    {
        [StringLength(100, MinimumLength = 1)] public string Name { get; set; } = string.Empty;

        public bool IsEnabled { get; set; }

        [Range(576, 9000)] public int? WireGuardMtu { get; set; }
    }

}
