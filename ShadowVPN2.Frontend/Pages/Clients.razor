@page "/devices"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IClientApplicationService ClientsApi
@inject IClientUpdatesService ClientRealtime
@implements IAsyncDisposable

<PageTitle>VPN devices - ShadowVPN2</PageTitle>

<div>
    <div class="page-header">
        <h1>VPN devices</h1>
        <button class="btn btn-primary ms-auto" type="button" disabled="@_loading" @onclick="OpenAddClient">Add device
        </button>
    </div>

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 text-secondary" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Loading devices…
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }


        <div class="field">
            <label class="form-label" for="client-search">Search devices</label>
            <InputText id="client-search" class="form-control" @bind-Value="_search" @bind-Value:after="ApplySearch"/>
        </div>

        @if (_filteredClients.Count == 0)
        {
            <p class="text-body-secondary">@(_clients.Count == 0 ? "No VPN devices configured yet." : "No devices match the search.")</p>
        }
        else
        {
            @foreach (var group in _filteredClients.GroupBy(client => client.UserNumber))
            {
                <section class="mb-4">
                    @if (_isAdministrator)
                    {
                        var owner = group.First();
                        <h2>@(owner.IsOwnedByCurrentUser ? "You" : owner.OwnerDisplayName ?? $"User {owner.UserNumber}")</h2>
                    }
                    <div class="table-responsive" tabindex="0" aria-label="VPN devices">
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                            <tr>
                                <th>Name</th>
                                <th>IP address</th>
                                <th>Created</th>
                                <th><span class="visually-hidden">Actions</span></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var client in group)
                            {
                                <tr @key="client.Id">
                                    <td>@client.Name</td>
                                    <td><code class="text-break">@client.AssignedIp</code></td>
                                    <td>@client.CreatedAt.LocalDateTime.ToString("g")</td>
                                    <td>
                                        <div class="actions table-actions justify-content-end">
                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input" type="checkbox" role="switch"
                                                       checked="@client.IsEnabled" aria-label="Enable @client.Name"
                                                       title="Enable @client.Name"
                                                       disabled="@_updatingClients.Contains(client.Id)"
                                                       @onchange="() => ToggleClientAsync(client)"/>
                                            </div>
                                            <a class="btn btn-outline-secondary btn-sm"
                                               href="@($"/devices/settings/{EscapeDocumentId(client.Id)}")"
                                               aria-label="Settings for @client.Name" title="Settings"><span
                                                    class="bi bi-gear" aria-hidden="true"></span></a>
                                            <a class="btn btn-outline-secondary btn-sm"
                                               href="@($"/s/{client.SubscriptionId}")" target="_blank"
                                               aria-label="Subscription for @client.Name" title="Subscription"><span
                                                    class="bi bi-link-45deg" aria-hidden="true"></span></a>
                                            <button class="btn btn-outline-danger btn-sm" type="button"
                                                    @onclick="() => RequestDeleteClient(client)"
                                                    aria-label="Delete @client.Name" title="Delete"><span
                                                    class="bi bi-trash" aria-hidden="true"></span></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }
    }
</div>

@if (_showAddClient)
{
    <AppDialog Title="Add device" Busy="_saving" OnClose="CloseAddClient">
        <ChildContent>
            <EditForm Model="_newClient" OnValidSubmit="CreateClientAsync">
                <div class="app-dialog__body">
                    <DataAnnotationsValidator/>
                    @if (_createError is not null)
                    {
                        <div class="alert alert-danger" role="alert">@_createError</div>
                    }
                    <div class="field">
                        <label class="form-label" for="new-client-name">Device name</label>
                        <InputText id="new-client-name" class="form-control" @bind-Value="_newClient.Name"
                                   disabled="@_saving" autofocus/>
                        <ValidationMessage For="() => _newClient.Name"/>
                    </div>
                </div>
                <footer class="app-dialog__footer">
                    <div class="actions ms-auto">
                        <button class="btn btn-outline-secondary" type="button" @onclick="CloseAddClient"
                                disabled="@_saving">Cancel
                        </button>
                        <button class="btn btn-primary" type="submit"
                                disabled="@_saving">@(_saving ? "Creating…" : "Add device")</button>
                    </div>
                </footer>
            </EditForm>
        </ChildContent>
    </AppDialog>
}

@if (_deleteClient is not null)
{
    <ConfirmDialog Title="Delete device" Message="@($"Delete device '{_deleteClient.Name}'? This cannot be undone.")"
                   ConfirmText="Delete" Busy="_deleting" Error="@_deleteError"
                   OnConfirm="ConfirmDeleteClientAsync" OnCancel="CancelDeleteClient"/>
}

@code {
    private IReadOnlyList<ClientResponse> _clients = [];
    private IReadOnlyList<ClientResponse> _filteredClients = [];
    private readonly CreateClientRequest _newClient = new() { Name = string.Empty };
    private bool _loading = true;
    private bool _saving;
    private bool _deleting;
    private string? _error;
    private string? _deleteError;
    private string _search = string.Empty;
    private bool _isAdministrator;
    private ClientResponse? _deleteClient;
    private IAsyncDisposable? _realtimeSubscription;
    private bool _showAddClient;
    private string? _createError;
    private readonly HashSet<string> _updatingClients = [];

    private void OpenAddClient()
    {
        _newClient.Name = string.Empty;
        _createError = null;
        _showAddClient = true;
    }

    private void CloseAddClient()
    {
        if (!_saving) _showAddClient = false;
    }

    private async Task ToggleClientAsync(ClientResponse client)
    {
        if (!_updatingClients.Add(client.Id)) return;
        _error = null;
        try
        {
            await ClientsApi.UpdateClientAsync(client.Id, new UpdateClientRequest
            {
                Name = client.Name,
                IsEnabled = !client.IsEnabled,
                WireGuard = client.WireGuard is null ? null : new WireGuardClientSettingsRequest { Mtu = client.WireGuard.Mtu }
            });
            await LoadClientsAsync();
        }
        catch (ApplicationServiceException)
        {
            _error = "Could not update the device.";
        }
        finally
        {
            _updatingClients.Remove(client.Id);
        }
    }


    private async Task CreateClientAsync()
    {
        _saving = true;
        _createError = null;
        try
        {
            await ClientsApi.CreateClientAsync(_newClient);
            _newClient.Name = string.Empty;
            await LoadClientsAsync();
            _showAddClient = false;
        }
        catch (ApplicationServiceException)
        {
            _createError = "Could not create the device.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void RequestDeleteClient(ClientResponse client)
    {
        _deleteClient = client;
        _deleteError = null;
    }

    private void CancelDeleteClient()
    {
        if (!_deleting)
            _deleteClient = null;
    }

    private async Task ConfirmDeleteClientAsync()
    {
        if (_deleteClient is null)
            return;

        _deleting = true;
        _deleteError = null;
        try
        {
            await ClientsApi.DeleteClientAsync(_deleteClient.Id);
            await LoadClientsAsync();
            _deleteClient = null;
        }
        catch (ApplicationServiceException)
        {
            _deleteError = "Could not delete the device.";
        }
        finally
        {
            _deleting = false;
        }
    }

    private static string EscapeDocumentId(string id)
    {
        return string.Join('/', id.Split('/').Select(Uri.EscapeDataString));
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAdministrator = await ClientsApi.IsAdministratorAsync();
            await LoadClientsAsync();
            _realtimeSubscription = await ClientRealtime.SubscribeAsync(clients => InvokeAsync(() =>
            {
                _clients = clients;
                ApplySearch();
                StateHasChanged();
            }));
            await InvokeAsync(StateHasChanged);
        }
        catch (ApplicationServiceException)
        {
            _error = "Could not load VPN devices.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadClientsAsync()
    {
        _clients = await ClientsApi.GetClientsAsync();
        ApplySearch();
    }

    private void ApplySearch()
    {
        var search = _search.Trim();
        _filteredClients = string.IsNullOrEmpty(search)
            ? _clients
            : _clients.Where(client =>
                    client.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    client.AssignedIp.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    client.UserNumber.ToString().Contains(search, StringComparison.OrdinalIgnoreCase))
                .ToArray();
    }


    public async ValueTask DisposeAsync()
    {
        if (_realtimeSubscription is not null)
            await _realtimeSubscription.DisposeAsync();
    }

}
