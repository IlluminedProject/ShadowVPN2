@page "/clients"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IClientApplicationService ClientsApi
@inject IClientUpdatesService ClientRealtime
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@using System.Net
@implements IAsyncDisposable

<PageTitle>VPN clients - ShadowVPN2</PageTitle>

<div>
    <h1>VPN clients</h1>

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 text-secondary" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Loading clients…
        </div>
    }
    else if (!_authenticated)
    {
        <p class="text-secondary">You need to sign in to manage VPN clients.</p>
        <a class="btn btn-primary" href="@LoginUrl">Sign in</a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        <EditForm Model="_newClient" OnValidSubmit="CreateClientAsync">
            <DataAnnotationsValidator/>
            <div class="d-flex flex-wrap align-items-start gap-2 mb-3">
                <InputText class="form-control" @bind-Value="_newClient.Name" placeholder="Device name"/>
                <button class="btn btn-primary" type="submit" disabled="@_saving">Add client</button>
            </div>
            <ValidationMessage For="() => _newClient.Name"/>
        </EditForm>

        <div class="mb-3">
            <InputText class="form-control" @bind-Value="_search" @bind-Value:after="ApplySearch"
                       placeholder="Search clients"/>
        </div>

        @if (_filteredClients.Count == 0)
        {
            <p class="muted">@(_clients.Count == 0 ? "No VPN clients configured yet." : "No clients match the search.")</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                <thead>
                <tr>
                    <th>Name</th>
                    @if (_isAdministrator)
                    {
                        <th>User</th>
                    }
                    <th>IP address</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var client in _filteredClients)
                {
                    <tr>
                        <td>@client.Name</td>
                        @if (_isAdministrator)
                        {
                            <td>@(client.IsOwnedByCurrentUser ? "You" : client.OwnerDisplayName)</td>
                        }
                        <td><code>@client.AssignedIp</code></td>
                        <td>@(client.IsEnabled ? "Enabled" : "Disabled")</td>
                        <td>@client.CreatedAt.LocalDateTime.ToString("g")</td>
                        <td class="actions">
                            <a class="btn btn-outline-primary btn-sm"
                               href="@($"/clients/settings/{EscapeDocumentId(client.Id)}")">Settings</a>
                            <a class="btn btn-outline-info btn-sm" href="@($"/s/{client.SubscriptionId}")"
                               target="_blank">Subscription</a>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteClientAsync(client)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<ClientResponse> _clients = [];
    private IReadOnlyList<ClientResponse> _filteredClients = [];
    private readonly CreateClientRequest _newClient = new() { Name = string.Empty };
    private bool _loading = true;
    private bool _authenticated;
    private bool _saving;
    private bool _retryAfterInteractiveRender;
    private string? _error;
    private string _search = string.Empty;
    private bool _isAdministrator;
    private IAsyncDisposable? _realtimeSubscription;

    private string LoginUrl => $"/Account/Login?returnUrl={Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)}";

    private static string EscapeDocumentId(string id) =>
            string.Join('/', id.Split('/').Select(Uri.EscapeDataString));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAdministrator = await ClientsApi.IsAdministratorAsync();
            await LoadClientsAsync();
            _authenticated = true;
            _realtimeSubscription = await ClientRealtime.SubscribeAsync(clients => InvokeAsync(() =>
            {
                _clients = clients;
                ApplySearch();
                StateHasChanged();
            }));
        }
        catch (ApplicationServiceException exception)
        {
            HandleApiError(exception, "Could not load VPN clients.");
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_retryAfterInteractiveRender)
            return;

        _retryAfterInteractiveRender = false;
        try
        {
            await LoadClientsAsync();
            _authenticated = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (ApplicationServiceException exception)
        {
            HandleApiError(exception, "Could not load VPN clients.");
        }
    }

    private async Task LoadClientsAsync()
    {
        _clients = await ClientsApi.GetClientsAsync();
        ApplySearch();
    }

    private void ApplySearch()
    {
        var search = _search.Trim();
        _filteredClients = string.IsNullOrEmpty(search)
            ? _clients
            : _clients.Where(client =>
                    client.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    client.AssignedIp.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    client.UserNumber.ToString().Contains(search, StringComparison.OrdinalIgnoreCase))
                .ToArray();
    }

    private async Task CreateClientAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            await ClientsApi.CreateClientAsync(_newClient);
            _newClient.Name = string.Empty;
            await LoadClientsAsync();
        }
        catch (ApplicationServiceException exception)
        {
            HandleApiError(exception, "Could not create the client.");
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteClientAsync(ClientResponse client)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Delete client '{client.Name}'?");
        if (!confirmed)
            return;

        _error = null;
        try
        {
            await ClientsApi.DeleteClientAsync(client.Id);
            await LoadClientsAsync();
        }
        catch (ApplicationServiceException exception)
        {
            HandleApiError(exception, "Could not delete the client.");
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
    }

    private void HandleApiError(ApplicationServiceException exception, string message)
    {
        if (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            _authenticated = false;
            _retryAfterInteractiveRender = true;
        }
        else
        {
            _authenticated = true;
            _error = message;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_realtimeSubscription is not null)
            await _realtimeSubscription.DisposeAsync();
    }

}
