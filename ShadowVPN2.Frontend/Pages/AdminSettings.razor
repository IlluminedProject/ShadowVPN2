@page "/admin/settings"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Settings.View")]
@inject NavigationManager Navigation

<PageTitle>Settings - ShadowVPN2</PageTitle>

<div class="page-header"><h1>Settings</h1></div>
<div class="app-status text-body-secondary" role="status"><span class="spinner-border spinner-border-sm"
                                                                aria-hidden="true"></span> Opening authorization
    settings…
</div>
<p><a href="/admin/settings/auth">Open authorization settings</a></p>

@code {

    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/admin/settings/auth", replace: true);
    }

}
