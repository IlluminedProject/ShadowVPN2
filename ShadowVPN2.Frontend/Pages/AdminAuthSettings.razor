@page "/admin/settings/auth"
@using System.Net
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Settings.View")]
@inject IAdminSettingsService AdminApi

<PageTitle>Authorization settings - ShadowVPN2</PageTitle>

<div>
    <AdminSettingsNav/>
    <h1>Authorization settings</h1>
    @if (_loading)
    {
        <p class="muted">Loading settings…</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    else
    {
        <div class="settings-frame">
            <div class="form-check form-switch mb-4">
                <InputCheckbox class="form-check-input" @bind-Value="_request.EnableLocalLogin"/>
                <label class="form-check-label h5">Enable local login</label>
            </div>
            <div class="form-check form-switch mb-4">
                <InputCheckbox class="form-check-input" @bind-Value="_request.SelfRegistrationEnabled"/>
                <label class="form-check-label h5">Enable self-registration</label>
            </div>
            <div class="form-check form-switch mb-3">
                <InputCheckbox class="form-check-input" @bind-Value="_request.EnableOidc"/>
                <label class="form-check-label h5">Enable OpenID Connect</label>
            </div>
        @if (_request.EnableOidc)
        {
                <div class="ms-4 p-3 border-start">
                    <div class="mb-3">
                        <label class="form-label" for="display-name">Display name</label>
                        <InputText id="display-name" class="form-control"
                                   @bind-Value="_request.OidcSettings!.DisplayName"/>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <InputCheckbox class="form-check-input" @bind-Value="_request.OidcSettings!.DeviceFlowEnabled"/>
                        <label class="form-check-label h5">Enable device flow</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="authority">Issuer URL</label>
                        <InputText id="authority" type="url" class="form-control"
                                   @bind-Value="_request.OidcSettings!.Authority"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="client-id">Client ID</label>
                        <InputText id="client-id" class="form-control" @bind-Value="_request.OidcSettings!.ClientId"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="client-secret">Client secret (blank keeps the saved
                            secret)</label>
                        <InputText id="client-secret" type="password" class="form-control"
                                   @bind-Value="_request.OidcSettings!.ClientSecret"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="scopes">Scopes</label>
                        <InputText id="scopes" class="form-control" @bind-Value="_request.OidcSettings!.Scopes"/>
                    </div>
            @if (!_request.OidcSettings.DeviceFlowEnabled)
            {
                <p>Redirect URI: <code>@RedirectUri</code></p>
            }

                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-outline-info" @onclick="TestOidcAsync" disabled="@_busy">Test provider
                        </button>
                    </div>
                </div>
        }

        </div>
        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">Save settings</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_message))
    {
        <p role="status">@_message</p>
    }
</div>

@code {
    private UpdateAuthSettingsRequest _request = new() { OidcSettings = new OidcAuthSettings() };
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;
    private string RedirectUri => NavigationManager.ToAbsoluteUri("/signin-OIDC").ToString();

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await AdminApi.GetAuthSettingsAsync();
            _request.EnableLocalLogin = response.EnableLocalLogin;
            _request.SelfRegistrationEnabled = response.SelfRegistrationEnabled;
            _request.EnableOidc = response.EnableOidc;
            _request.OidcSettings = response.OidcSettings ?? new OidcAuthSettings();
        }
        catch (ApplicationServiceException ex)
        {
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to view settings."
                    : "Could not load authorization settings.";
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        await RunAsync(async () =>
        {
            await AdminApi.SaveAuthSettingsAsync(_request);
            _message = "Settings saved.";
        });
    }

    private async Task TestOidcAsync()
    {
        await RunAsync(async () =>
        {
            var success = await AdminApi.TestOidcAsync(_request.OidcSettings!.Authority);
            _message = success ? "Connected to the OIDC discovery endpoint." : "OIDC discovery failed.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await action();
        }
        catch (ApplicationServiceException ex)
        {
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to change settings."
                    : "The operation failed.";
        }
        catch (Exception)
        {
            _error = "Could not complete the operation.";
        }
        finally
        {
            _busy = false;
        }
    }

}
