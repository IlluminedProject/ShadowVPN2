@page "/admin/settings/auth"
@using System.Net
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Settings.View")]
@inject IAdminSettingsService AdminApi

<PageTitle>Authorization settings - ShadowVPN2</PageTitle>

<AdminSettingsNav/>
<div class="page-header"><h1>Authorization settings</h1></div>
@if (_loading)
{
    <div class="app-status text-body-secondary" role="status"><span class="spinner-border spinner-border-sm"
                                                                    aria-hidden="true"></span> Loading settings…
    </div>
}
else if (!_loaded)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
else
{
    <EditForm Model="_request" OnValidSubmit="SaveAsync" class="settings-frame">
        <DataAnnotationsValidator/>
        <ValidationSummary/>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }
        <fieldset disabled="@_busy">
            <legend class="visually-hidden">Authorization settings</legend>
            <div class="form-check form-switch field">
                <InputCheckbox id="enable-local-login" class="form-check-input"
                               @bind-Value="_request.EnableLocalLogin"/>
                <label class="form-check-label" for="enable-local-login">Enable local login</label>
            </div>
            <div class="form-check form-switch field">
                <InputCheckbox id="self-registration" class="form-check-input"
                               @bind-Value="_request.SelfRegistrationEnabled"/>
                <label class="form-check-label" for="self-registration">Enable self-registration</label>
            </div>
            <div class="form-check form-switch field">
                <InputCheckbox id="enable-oidc" class="form-check-input" @bind-Value="_request.EnableOidc"/>
                <label class="form-check-label" for="enable-oidc">Enable OpenID Connect</label>
            </div>
            @if (_request.EnableOidc)
            {
                <section class="mt-4">
                    <h2>OpenID Connect provider</h2>
                    <div class="field">
                        <label class="form-label" for="display-name">Display name</label>
                        <InputText id="display-name" class="form-control"
                                   @bind-Value="_request.OidcSettings!.DisplayName"/>
                    </div>
                    <div class="form-check form-switch field">
                        <InputCheckbox id="device-flow" class="form-check-input"
                                       @bind-Value="_request.OidcSettings!.DeviceFlowEnabled"/>
                        <label class="form-check-label" for="device-flow">Enable device flow</label>
                    </div>
                    <div class="field">
                        <label class="form-label" for="authority">Issuer URL</label>
                        <InputText id="authority" type="url" class="form-control"
                                   @bind-Value="_request.OidcSettings!.Authority"/>
                    </div>
                    <div class="field">
                        <label class="form-label" for="client-id">Client ID</label>
                        <InputText id="client-id" class="form-control" @bind-Value="_request.OidcSettings!.ClientId"/>
                    </div>
                    <div class="field">
                        <label class="form-label" for="client-secret">Client secret (optional)</label>
                        <InputText id="client-secret" type="password" autocomplete="off" class="form-control"
                                   aria-describedby="client-secret-hint"
                                   @bind-Value="_request.OidcSettings!.ClientSecret"/>
                        <div id="client-secret-hint" class="form-text">Leave blank to keep the saved secret.</div>
                    </div>
                    <div class="field">
                        <label class="form-label" for="scopes">Scopes</label>
                        <InputText id="scopes" class="form-control" @bind-Value="_request.OidcSettings!.Scopes"/>
                    </div>
                    @if (!_request.OidcSettings.DeviceFlowEnabled)
                    {
                        <dl class="app-details">
                            <dt>Redirect URI</dt>
                            <dd><code class="text-break">@RedirectUri</code></dd>
                        </dl>
                    }
                    <div class="actions">
                        <button class="btn btn-outline-secondary" type="button" @onclick="TestOidcAsync"
                                disabled="@_busy">@(_testing ? "Testing…" : "Test provider")</button>
                    </div>
                    @if (_testMessage is not null)
                    {
                        <div class="alert @(_testSucceeded ? "alert-success" : "alert-danger") mt-3"
                             role="@(_testSucceeded ? "status" : "alert")">@_testMessage</div>
                    }
                </section>
            }
            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="alert alert-success app-status mt-3" role="status">@_message</div>
            }
            <div class="form-actions">
                <button class="btn btn-primary" type="submit"
                        disabled="@_busy">@(_busy && !_testing ? "Saving…" : "Save settings")</button>
            </div>
        </fieldset>
    </EditForm>
}

@code {
    private readonly UpdateAuthSettingsRequest _request = new() { OidcSettings = new OidcAuthSettings() };
    private bool _loading = true;
    private bool _loaded;
    private bool _testing;
    private bool _testSucceeded;
    private string? _testMessage;
    private bool _busy;
    private string? _error;
    private string? _message;
    private string RedirectUri => NavigationManager.ToAbsoluteUri("/signin-OIDC").ToString();

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await AdminApi.GetAuthSettingsAsync();
            _request.EnableLocalLogin = response.EnableLocalLogin;
            _request.SelfRegistrationEnabled = response.SelfRegistrationEnabled;
            _request.EnableOidc = response.EnableOidc;
            _request.OidcSettings = response.OidcSettings ?? new OidcAuthSettings();
            _loaded = true;
        }
        catch (ApplicationServiceException ex)
        {
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to view settings."
                : "Could not load authorization settings.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        await RunAsync(async () =>
        {
            await AdminApi.SaveAuthSettingsAsync(_request);
            _message = "Settings saved.";
        });
    }

    private async Task TestOidcAsync()
    {
        _testing = true;
        _testMessage = null;
        await RunAsync(async () =>
        {
            _testSucceeded = await AdminApi.TestOidcAsync(_request.OidcSettings!.Authority);
            _testMessage = _testSucceeded ? "Connected to the OIDC discovery endpoint." : "OIDC discovery failed. Check the issuer URL and try again.";
        });
        _testing = false;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await action();
        }
        catch (ApplicationServiceException ex)
        {
            _error = ex.StatusCode == HttpStatusCode.Forbidden
                ? "You do not have permission to change settings."
                : "The operation failed.";
        }
        finally
        {
            _busy = false;
        }
    }

}
