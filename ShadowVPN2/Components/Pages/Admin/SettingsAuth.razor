@page "/admin/settings/auth"
@using ShadowVPN2.Data
@using ShadowVPN2.Entities.Auth
@using ShadowVPN2.Infrastructure.Authentication
@attribute [Authorize(Policy = AppPermissions.Settings.View)]
@rendermode InteractiveServer
@inject SettingsService SettingsService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IAuthorizationService AuthorizationService

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <NavLink href="/admin/settings" class="list-group-item list-group-item-action" Match="NavLinkMatch.All">
                    General
                </NavLink>
                <NavLink href="/admin/settings/auth" class="list-group-item list-group-item-action active">
                    Authorization
                </NavLink>
                <NavLink href="/admin/settings/protocols" class="list-group-item list-group-item-action">Protocols
                </NavLink>
                <NavLink href="/admin/settings/certificates" class="list-group-item list-group-item-action">
                    Certificates
                </NavLink>
                <NavLink href="/admin/settings/cluster" class="list-group-item list-group-item-action">Cluster
                </NavLink>
            </div>
        </div>
        <div class="col-md-9">
            <h3>Authorization Settings</h3>
            <p class="text-muted">Configure how users authenticate with the system.</p>

            @if (!_canManage && !_isLoading)
            {
                <div class="alert alert-warning py-2 mb-4">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    You have read-only access to these settings.
                </div>
            }

            @if (_isLoading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <fieldset disabled="@(!_canManage)">
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="form-check form-switch mb-4">
                                <input class="form-check-input" type="checkbox" role="switch" id="localLoginSwitch"
                                       @bind="_request.EnableLocalLogin">
                                <label class="form-check-label h5" for="localLoginSwitch">Enable Local Login</label>
                                <div class="form-text">Users can log in with their email and password stored in the
                                    local database.
                                </div>
                            </div>

                            <hr/>

                            <div class="form-check form-switch mb-4">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="selfRegistrationSwitch" @bind="_request.SelfRegistrationEnabled">
                                <label class="form-check-label h5" for="selfRegistrationSwitch">Enable
                                    Self-Registration</label>
                                <div class="form-text">Allow new users to automatically register when logging in via
                                    OAuth.
                                </div>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="oidcSwitch"
                                       @bind="_request.EnableOidc">
                                <label class="form-check-label h5" for="oidcSwitch">Enable OAuth2 / OpenID
                                    Connect</label>
                                <div class="form-text">Allow users to log in using an external identity
                                    provider.
                                </div>
                            </div>

                            @if (_request.EnableOidc)
                            {
                                <div class="ms-4 p-3 border-start">
                                    <div class="mb-3">
                                        <label class="form-label">Display Name</label>
                                        <input type="text" class="form-control"
                                               @bind="_request.OidcSettings!.DisplayName"
                                               placeholder="e.g. Corporate Login"/>
                                        <div class="form-text">The name displayed on the login button.</div>
                                    </div>

                                    <hr/>
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               id="deviceFlowSwitch"
                                               @bind="_request.OidcSettings!.DeviceFlowEnabled"/>
                                        <label class="form-check-label h5" for="deviceFlowSwitch">Enable Device
                                            Authorization</label>
                                        <div class="form-text">Allow login without registering a redirect URI. The
                                            provider must support RFC 8628. The existing OAuth client credentials
                                            will be used.
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">OpenID Configuration Issuer URL</label>
                                        <input type="url" class="form-control" @bind="_request.OidcSettings!.Authority"
                                               placeholder="e.g. https://accounts.google.com"/>
                                        <div class="form-text">The base issuer URL. The discovery document will be
                                            fetched from <code>/.well-known/openid-configuration</code>.
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Client ID</label>
                                        <input type="text" class="form-control"
                                               @bind="_request.OidcSettings!.ClientId"/>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Client Secret</label>
                                        <input type="password" class="form-control"
                                               @bind="_request.OidcSettings!.ClientSecret"/>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Scopes</label>
                                        <input type="text" class="form-control" @bind="_request.OidcSettings!.Scopes"
                                               placeholder="openid email profile"/>
                                        <div class="form-text">Space-separated scopes to request.</div>
                                    </div>

                                    @if (!_request.OidcSettings.DeviceFlowEnabled)
                                    {
                                        <div class="mb-3">
                                            <label class="form-label">Redirect URI</label>
                                            <div class="input-group">
                                                <input type="text" class="form-control bg-light"
                                                       value="@(NavigationManager.BaseUri.TrimEnd('/') + "/signin-OIDC")"
                                                       readonly/>
                                                <button class="btn btn-outline-secondary" type="button"
                                                        @onclick='() => CopyToClipboard(NavigationManager.BaseUri.TrimEnd("/").ToString() + "/signin-OIDC")'>
                                                    <i class="bi bi-clipboard"></i>
                                                </button>
                                            </div>
                                            <div class="form-text">Configure this URL in your identity provider's
                                                allowed
                                                redirect URIs.
                                            </div>
                                        </div>
                                    }

                                    <div class="mb-3">
                                        <button class="btn btn-outline-info" type="button" @onclick="TestConnection"
                                                disabled="@_isTesting">
                                            @if (_isTesting)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"
                                                      aria-hidden="true"></span>
                                                <span> Testing...</span>
                                            }
                                            else
                                            {
                                                <span>Test Provider Configuration</span>
                                            }
                                        </button>

                                        @if (!string.IsNullOrEmpty(_testMessage))
                                        {
                                            <div class="mt-2 small text-@(_testSuccess ? "success" : "danger")">
                                                @((MarkupString)_testMessage)
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </fieldset>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success">@_successMessage</div>
                }

                @if (_canManage)
                {
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-primary" @onclick="SaveSettings" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Save Changes
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isTesting;
    private bool _canManage;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _testMessage;
    private bool _testSuccess;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private readonly UpdateAuthSettingsRequest _request = new()
    {
        OidcSettings = new OidcAuthSettings()
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthState != null)
            {
                var state = await AuthState;
                var result = await AuthorizationService.AuthorizeAsync(state.User, AppPermissions.Settings.Manage);
                _canManage = result.Succeeded;
            }

            var config = await SettingsService.GetConfigurationAsync();
            var oidc = config.Providers.OfType<OidcAuthProvider>().FirstOrDefault();
            var local = config.Providers.OfType<LocalAuthProvider>().FirstOrDefault();

            _request.EnableLocalLogin = local?.IsEnabled ?? false;
            _request.SelfRegistrationEnabled = config.SelfRegistrationEnabled;
            _request.EnableOidc = oidc?.IsEnabled ?? false;

            if (oidc != null)
            {
                _request.OidcSettings = new OidcAuthSettings
                {
                    DisplayName = oidc.DisplayName,
                    Authority = oidc.Authority,
                    ClientId = oidc.ClientId,
                    ClientSecret = oidc.ClientSecret,
                    Scopes = oidc.Scopes,
                    DeviceFlowEnabled = oidc.DeviceFlowEnabled
                };
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to load configuration: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task TestConnection()
    {
        if (string.IsNullOrWhiteSpace(_request.OidcSettings?.Authority))
        {
            _testMessage = "Authority URL is required.";
            _testSuccess = false;
            return;
        }

        _isTesting = true;
        _testMessage = null;
        StateHasChanged();

        try
        {
            _testSuccess = await SettingsService.TestOidcConnectionAsync(_request.OidcSettings.Authority);
            var discoveryUrl = _request.OidcSettings.Authority.TrimEnd('/') + "/.well-known/openid-configuration";
            _testMessage = _testSuccess
                ? "Successfully connected to OIDC discovery endpoint!"
                : $"Failed to connect to <code>{discoveryUrl}</code>";
        }
        catch (Exception ex)
        {
            _testSuccess = false;
            _testMessage = "Error: " + ex.Message;
        }
        finally
        {
            _isTesting = false;
        }
    }

    private async Task SaveSettings()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;
        StateHasChanged();

        try
        {
            if (_request.EnableOidc)
            {
                if (string.IsNullOrWhiteSpace(_request.OidcSettings?.Authority) || string.IsNullOrWhiteSpace(_request.OidcSettings?.ClientId))
                {
                    _errorMessage = "Authority and Client ID are required for OIDC.";
                    return;
                }
            }

            await SettingsService.SaveAuthSettingsAsync(_request);
            _successMessage = "Settings saved successfully.";
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to save settings: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CopyToClipboard(string text)
    {
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

}
