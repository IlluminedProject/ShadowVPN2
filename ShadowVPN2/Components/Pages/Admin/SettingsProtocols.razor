@page "/admin/settings/protocols"
@using ShadowVPN2.Components.Pages.Admin.Protocols
@using ShadowVPN2.Data.Protocols
@using ShadowVPN2.Entities
@using ShadowVPN2.Infrastructure.Authentication
@attribute [Authorize(Policy = AppPermissions.Settings.View)]
@rendermode InteractiveServer
@inject ProtocolSettingsService ProtocolSettingsService
@inject ProtocolDomainService ProtocolDomainService
@inject NavigationManager NavigationManager
@inject IAuthorizationService AuthorizationService

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <NavLink href="/admin/settings" class="list-group-item list-group-item-action" Match="NavLinkMatch.All">
                    General
                </NavLink>
                <NavLink href="/admin/settings/auth" class="list-group-item list-group-item-action">Authorization
                </NavLink>
                <NavLink href="/admin/settings/protocols" class="list-group-item list-group-item-action active">
                    Protocols
                </NavLink>
                <NavLink href="/admin/settings/certificates" class="list-group-item list-group-item-action">
                    Certificates
                </NavLink>
                <NavLink href="/admin/settings/cluster" class="list-group-item list-group-item-action">Cluster
                </NavLink>
            </div>
        </div>
        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3>Protocol Settings</h3>
                    <p class="text-muted mb-0">Configure VPN protocols globally for all nodes.</p>
                </div>
                <div class="dropdown">
                    <button class="btn btn-outline-primary dropdown-toggle" type="button"
                            @onclick="ToggleDropdown" aria-expanded="@_isDropdownOpen" disabled="@(!_canManage)">
                        <i class="bi bi-plus-lg me-1"></i> Add Protocol
                    </button>
                    @if (_isDropdownOpen)
                    {
                        <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1040;"
                             @onclick="() => _isDropdownOpen = false"></div>
                    }
                    <ul class="dropdown-menu dropdown-menu-end @(_isDropdownOpen ? "show" : "")"
                        style="@(_isDropdownOpen ? "display: block; z-index: 1050;" : "display: none;")">
                        <li>
                            <button class="dropdown-item" type="button" @onclick='() => AddProtocol("hysteria2")'>
                                Hysteria2
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" @onclick='() => AddProtocol("wireguard")'>
                                WireGuard / AmneziaWG
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

            @if (!_canManage && !_isLoading)
            {
                <div class="alert alert-warning py-2 mb-4">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    You have read-only access to these settings.
                </div>
            }

            @if (_isLoading)
            {
                <div class="d-flex justify-content-center my-5">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                @if (_request.Protocols.Count == 0)
                {
                    <div class="alert alert-info text-center py-5">
                        <i class="bi bi-info-circle fs-2 d-block mb-3"></i>
                        <p>No protocols configured. Click the "Add Protocol" button to get started.</p>
                    </div>
                }
                else
                {
                    <fieldset disabled="@(!_canManage)">
                        <div class="card mb-4 border-secondary">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Global Main Domain</h5>
                            </div>
                            <div class="card-body">
                                <input class="form-control" @bind="_request.MainDomain"
                                       placeholder="vpn.example.com"/>
                                <div class="form-text">Fallback domain for protocols without their own main domain.
                                </div>
                            </div>
                        </div>
                        @foreach (var protocol in _request.Protocols)
                        {
                            <ProtocolSettingsCard @key="protocol.Id" Protocol="protocol" CanManage="_canManage"
                                                  DomainRoute="GetDomainRoute(protocol)" OnRemove="RemoveProtocol">
                                @if (protocol is Hysteria2GlobalSettings h2Config)
                                {
                                    <Hysteria2ProtocolSettings Settings="h2Config" CanManage="_canManage"/>
                                }
                                else if (protocol is AwgGlobalSettings wgConfig)
                                {
                                    <WireGuardAmneziaProtocolSettings Settings="wgConfig"/>
                                }
                            </ProtocolSettingsCard>
                        }

                        <div class="card mb-4 border-secondary">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Transports</h5>
                                @if (_canManage && _request.Protocols.Count > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            @onclick="AddFreeTurnTransport">
                                        <i class="bi bi-plus-lg me-1"></i> Add FreeTurn
                                    </button>
                                }
                            </div>
                            <div class="card-body">
                                @if (_request.Transports.Count == 0)
                                {
                                    <p class="text-muted mb-0">No transport overlays configured.</p>
                                }
                                else
                                {
                                    @foreach (var transport in _request.Transports)
                                    {
                                        <div class="border rounded p-3 mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <strong>@GetTransportName(transport)</strong>
                                                @if (_canManage)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => RemoveTransport(transport)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <label class="form-label">Protocol</label>
                                                    <select class="form-select" @bind="transport.ProtocolId">
                                                        @foreach (var protocolOption in _request.Protocols)
                                                        {
                                                            <option
                                                                value="@protocolOption.Id">@GetProtocolName(protocolOption)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Relay Listen Port</label>
                                                    <input type="number" class="form-control"
                                                           @bind="transport.ListenPort"
                                                           min="1" max="65535"/>
                                                    <div class="form-text">External port opened by the transport.</div>
                                                </div>
                                                @if (transport is FreeTurnTransportSettings freeTurn)
                                                {
                                                    <div class="col-md-4">
                                                        <label class="form-label">Obfuscation Profile</label>
                                                        <select class="form-select" @bind="freeTurn.ObfuscationProfile">
                                                            <option value="">Disabled</option>
                                                            <option value="RtpOpus">RTP/Opus</option>
                                                            <option value="RtpOpus2">RTP/Opus 2</option>
                                                            <option value="RtpOpus3">RTP/Opus 3</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label">TURN Transport</label>
                                                        <select class="form-select" @bind="freeTurn.TurnTransport">
                                                            <option value="Tcp">TCP/TLS</option>
                                                            <option value="Udp">UDP</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label">TURN Streams</label>
                                                        <input type="number" class="form-control"
                                                               @bind="freeTurn.Streams"
                                                               min="1" max="64"/>
                                                    </div>
                                                    <div class="col-12">
                                                        <label class="form-label">Obfuscation Key</label>
                                                        <input class="form-control font-monospace"
                                                               @bind="freeTurn.ObfuscationKey"
                                                               placeholder="64 hexadecimal characters"/>
                                                    </div>
                                                }
                                            </div>
                                            <div class="form-check form-switch mt-3">
                                                <input class="form-check-input" type="checkbox" role="switch"
                                                       @bind="transport.Enabled"/>
                                                <label class="form-check-label">Enable transport</label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </fieldset>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success">@_successMessage</div>
                }

                @if (_canManage && _request.Protocols.Count > 0)
                {
                    <div class="d-flex justify-content-end mt-4">
                        <button class="btn btn-primary btn-lg px-5" @onclick="SaveSettings" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Save All Changes
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _canManage;
    private bool _isDropdownOpen;
    private string? _errorMessage;
    private string? _successMessage;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private readonly UpdateProtocolsSettingsRequest _request = new();
    private IReadOnlyList<ProtocolDomainRouteResponse> _domainRoutes = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthState != null)
            {
                var state = await AuthState;
                var result = await AuthorizationService.AuthorizeAsync(state.User, AppPermissions.Settings.Manage);
                _canManage = result.Succeeded || state.User.IsInRole(AppRoles.Administrator);
            }

            var settings = await ProtocolSettingsService.GetSettingsAsync();
            _request.Protocols = settings.Protocols;
            _request.Transports = settings.Transports;
            _request.MainDomain = settings.MainDomain;
            _domainRoutes = await ProtocolDomainService.GetRoutesAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to load settings: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleDropdown()
    {
        _isDropdownOpen = !_isDropdownOpen;
    }

    private void AddProtocol(string type)
    {
        _isDropdownOpen = false;
        if (type == "hysteria2")
        {
            var settings = new Hysteria2GlobalSettings
            {
                Id = Guid.NewGuid(),
                Enabled = true,
                ListenPort = GetNextAvailablePort(4443)
            };
            settings.GenerateSelfSignedCertificate();
            _request.Protocols.Add(settings);
        }
        else if (type == "wireguard")
        {
            _request.Protocols.Add(new AwgGlobalSettings
            {
                Id = Guid.NewGuid(),
                Enabled = true,
                ListenPort = GetNextAvailablePort(51820)
            });
        }
    }

    private int GetNextAvailablePort(int startPort)
    {
        var usedPorts = _request.Protocols.Select(p => p.ListenPort).ToHashSet();
        var port = startPort;
        while (usedPorts.Contains(port)) port++;
        return port;
    }

    private void RemoveProtocol(ProtocolGlobalSettings protocol)
    {
        _request.Transports.RemoveAll(transport => transport.ProtocolId == protocol.Id);
        _request.Protocols.Remove(protocol);
    }

    private void AddFreeTurnTransport()
    {
        var protocol = _request.Protocols.FirstOrDefault();
        if (protocol is null)
            return;

        _request.Transports.Add(new FreeTurnTransportSettings
        {
            Id = Guid.NewGuid(),
            ProtocolId = protocol.Id,
            ListenPort = GetNextTransportPort(),
            ObfuscationKey = FreeTurnTransportSettings.GenerateObfuscationKey()
        });
    }

    private void RemoveTransport(TransportSettings transport)
    {
        _request.Transports.Remove(transport);
    }

    private int GetNextTransportPort()
    {
        var usedPorts = _request.Protocols.Select(protocol => protocol.ListenPort)
            .Concat(_request.Transports.Select(transport => transport.ListenPort))
            .ToHashSet();
        var port = 56000;
        while (usedPorts.Contains(port)) port++;
        return port;
    }

    private string GetTransportName(TransportSettings transport)
    {
        var protocol = _request.Protocols.FirstOrDefault(item => item.Id == transport.ProtocolId);
        return $"{transport.GetType().Name.Replace("TransportSettings", string.Empty)} → {GetProtocolName(protocol)}";
    }

    private static string GetProtocolName(ProtocolGlobalSettings? protocol)
    {
        return protocol is null ? "Unknown protocol" : $"{protocol.Protocol} : {protocol.ListenPort}";
    }

    private async Task SaveSettings()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;
        StateHasChanged();

        try
        {
            foreach (var protocol in _request.Protocols)
            {
                if (protocol is Hysteria2GlobalSettings h2 && h2.Enabled)
                {
                    if (string.IsNullOrWhiteSpace(h2.TlsCertificatePem) || string.IsNullOrWhiteSpace(h2.TlsKeyPem))
                    {
                        _errorMessage = $"TLS certificate is missing for Hysteria2 (Port {h2.ListenPort}). Click Regenerate.";
                        _isSaving = false;
                        return;
                    }
                }
            }

            await ProtocolSettingsService.UpdateSettingsAsync(_request);
            _domainRoutes = await ProtocolDomainService.GetRoutesAsync();
            _successMessage = "Protocol settings saved successfully. Nodes will be updated automatically.";
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to save settings: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private ProtocolDomainRouteResponse? GetDomainRoute(ProtocolGlobalSettings protocol)
    {
        var index = _request.Protocols.IndexOf(protocol);
        return _domainRoutes.FirstOrDefault(route => route.ProtocolIndex == index);
    }
}
