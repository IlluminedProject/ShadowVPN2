@page "/admin/settings/protocols"
@using ShadowVPN2.Data.Protocols
@using ShadowVPN2.Entities
@using ShadowVPN2.Infrastructure.Authentication
@attribute [Authorize(Policy = AppPermissions.Settings.View)]
@rendermode InteractiveServer
@inject ProtocolSettingsService ProtocolSettingsService
@inject ProtocolDomainService ProtocolDomainService
@inject NavigationManager NavigationManager
@inject IAuthorizationService AuthorizationService

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <NavLink href="/admin/settings" class="list-group-item list-group-item-action" Match="NavLinkMatch.All">
                    General
                </NavLink>
                <NavLink href="/admin/settings/auth" class="list-group-item list-group-item-action">Authorization
                </NavLink>
                <NavLink href="/admin/settings/protocols" class="list-group-item list-group-item-action active">
                    Protocols
                </NavLink>
                <NavLink href="/admin/settings/cluster" class="list-group-item list-group-item-action">Cluster
                </NavLink>
            </div>
        </div>
        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3>Protocol Settings</h3>
                    <p class="text-muted mb-0">Configure VPN protocols globally for all nodes.</p>
                </div>
                <div class="dropdown">
                    <button class="btn btn-outline-primary dropdown-toggle" type="button"
                            @onclick="ToggleDropdown" aria-expanded="@isDropdownOpen" disabled="@(!canManage)">
                        <i class="bi bi-plus-lg me-1"></i> Add Protocol
                    </button>
                    @if (isDropdownOpen)
                    {
                        <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1040;"
                             @onclick="() => isDropdownOpen = false"></div>
                    }
                    <ul class="dropdown-menu dropdown-menu-end @(isDropdownOpen ? "show" : "")"
                        style="@(isDropdownOpen ? "display: block; z-index: 1050;" : "display: none;")">
                        <li>
                            <button class="dropdown-item" type="button" @onclick='() => AddProtocol("hysteria2")'>
                                Hysteria2
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" @onclick='() => AddProtocol("wireguard")'>
                                WireGuard / AmneziaWG
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

            @if (!canManage && !isLoading)
            {
                <div class="alert alert-warning py-2 mb-4">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    You have read-only access to these settings.
                </div>
            }

            @if (isLoading)
            {
                <div class="d-flex justify-content-center my-5">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                @if (request.Protocols.Count == 0)
                {
                    <div class="alert alert-info text-center py-5">
                        <i class="bi bi-info-circle fs-2 d-block mb-3"></i>
                        <p>No protocols configured. Click the "Add Protocol" button to get started.</p>
                    </div>
                }
                else
                {
                    <fieldset disabled="@(!canManage)">
                        <div class="card mb-4 border-secondary">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Global Main Domain</h5>
                            </div>
                            <div class="card-body">
                                <input class="form-control" @bind="request.MainDomain"
                                       placeholder="vpn.example.com"/>
                                <div class="form-text">Fallback domain for protocols without their own main domain.
                                </div>
                            </div>
                        </div>
                        @foreach (var protocol in request.Protocols)
                        {
                            <div class="card mb-4 border-primary">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <span class="badge bg-primary me-2">@protocol.Protocol</span>
                                        @(protocol is Hysteria2GlobalSettings h2 ? $"Port: {h2.ListenPort}" : protocol is WireGuardAmneziaGlobalSettings wg ? $"Port: {wg.ListenPort}" : protocol.Protocol)
                                    </h5>
                                    @if (canManage)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => RemoveProtocol(protocol)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                                <div class="card-body">
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               id="enabled-@protocol.Protocol" @bind="protocol.Enabled">
                                        <label class="form-check-label h5" for="enabled-@protocol.Protocol">Enable
                                            Protocol</label>
                                    </div>

                                    @{ var domainRoute = GetDomainRoute(protocol); }
                                    @if (domainRoute is { State: not ProtocolDomainRouteState.NoDomain })
                                    {
                                        <div class="alert @GetRouteAlertClass(domainRoute.State) py-2">
                                            <strong>@domainRoute.Domain</strong>
                                            <span class="ms-2">@GetRouteStatusText(domainRoute)</span>
                                            @if (domainRoute.ResolvedAddresses.Count > 0)
                                            {
                                                <div class="small mt-1">
                                                    Resolves to: @string.Join(", ", domainRoute.ResolvedAddresses)
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (protocol is Hysteria2GlobalSettings h2Config)
                                    {
                                        <div class="ms-4 p-3 border-start">
                                            <div class="mb-3">
                                                <label class="form-label">Main Domain</label>
                                                <input class="form-control" @bind="h2Config.MainDomain"
                                                       placeholder="hysteria.example.com"/>
                                                <div class="form-text">Overrides the global main domain for this
                                                    protocol.
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <div class="col-md-4">
                                                    <label class="form-label">Listen Port</label>
                                                    <input type="number" class="form-control"
                                                           @bind="h2Config.ListenPort" min="1" max="65535"/>
                                                    <div class="form-text">UDP port for Hysteria2.</div>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Obfuscation Type</label>
                                                    <select class="form-select" @bind="h2Config.ObfsType">
                                                        <option value="salamander">salamander</option>
                                                        <option value="none">none</option>
                                                    </select>
                                                </div>
                                                @if (h2Config.ObfsType != "none")
                                                {
                                                    <div class="col-md-4">
                                                        <label class="form-label">Obfuscation Password</label>
                                                        <input type="text" class="form-control"
                                                               @bind="h2Config.ObfsPassword"/>
                                                    </div>
                                                }
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">TLS Certificate</label>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="text-muted small">
                                                        @if (!string.IsNullOrEmpty(h2Config.TlsCertificatePem))
                                                        {
                                                            <i class="bi bi-check-circle text-success me-1"></i>
                                                            <text>Self-signed certificate generated</text>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-x-circle text-danger me-1"></i>
                                                            <text>No certificate</text>
                                                        }
                                                    </span>
                                                    @if (canManage)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                @onclick="() => h2Config.GenerateSelfSignedCertificate()">
                                                            <i class="bi bi-arrow-clockwise me-1"></i> Regenerate
                                                        </button>
                                                    }
                                                </div>
                                                <div class="form-text">Auto-generated self-signed certificate.
                                                    Regenerate if needed.
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (protocol is WireGuardAmneziaGlobalSettings wgConfig)
                                    {
                                        <div class="ms-4 p-3 border-start">
                                            <div class="mb-3"><label class="form-label">Main Domain</label><input
                                                    class="form-control" @bind="wgConfig.MainDomain"
                                                    placeholder="vpn.example.com"/></div>
                                            <div class="row g-3 mb-3">
                                                <div class="col-md-4"><label class="form-label">Listen
                                                        Port</label><input type="number" class="form-control"
                                                                           @bind="wgConfig.ListenPort" min="1"
                                                                           max="65535"/></div>
                                                <div class="col-md-4"><label class="form-label">MTU</label><input
                                                        type="number" class="form-control" @bind="wgConfig.Mtu"
                                                        min="576" max="9000"/></div>
                                                <div class="col-md-4"><label class="form-label">Server VPN
                                                        Address</label><input class="form-control"
                                                                              @bind="wgConfig.ServerAddress"/></div>
                                            </div>
                                            <div
                                                class="alert @(wgConfig.IsAmneziaWg ? "alert-warning" : "alert-success") py-2">
                                                <strong>Ordinary WireGuard
                                                    compatibility:</strong> @(wgConfig.IsAmneziaWg ? "No. AmneziaWG parameters are configured." : "Yes. No AmneziaWG parameters are configured.")
                                            </div>
                                            <h6>AmneziaWG parameters</h6>
                                            <div class="row g-3">
                                                <div class="col-md-3"><label class="form-label">Jc</label><input
                                                        type="number" class="form-control" @bind="wgConfig.Jc" min="0"/>
                                                </div>
                                                <div class="col-md-3"><label class="form-label">Jmin</label><input
                                                        type="number" class="form-control" @bind="wgConfig.Jmin"
                                                        min="0"/></div>
                                                <div class="col-md-3"><label class="form-label">Jmax</label><input
                                                        type="number" class="form-control" @bind="wgConfig.Jmax"
                                                        min="0"/></div>
                                                <div class="col-md-3"><label class="form-label">S1</label><input
                                                        type="number" class="form-control" @bind="wgConfig.S1" min="0"/>
                                                </div>
                                                <div class="col-md-3"><label class="form-label">S2</label><input
                                                        type="number" class="form-control" @bind="wgConfig.S2" min="0"/>
                                                </div>
                                                <div class="col-md-3"><label class="form-label">S3</label><input
                                                        type="number" class="form-control" @bind="wgConfig.S3" min="0"/>
                                                </div>
                                                <div class="col-md-3"><label class="form-label">S4</label><input
                                                        type="number" class="form-control" @bind="wgConfig.S4" min="0"/>
                                                </div>
                                                <div class="col-md-3"><label class="form-label">H1</label><input
                                                        class="form-control" @bind="wgConfig.H1"/></div>
                                                <div class="col-md-3"><label class="form-label">H2</label><input
                                                        class="form-control" @bind="wgConfig.H2"/></div>
                                                <div class="col-md-3"><label class="form-label">H3</label><input
                                                        class="form-control" @bind="wgConfig.H3"/></div>
                                                <div class="col-md-3"><label class="form-label">H4</label><input
                                                        class="form-control" @bind="wgConfig.H4"/></div>
                                            </div>
                                            <div class="row g-3 mt-1">
                                                <div class="col-md-6"><label class="form-label">I1</label><input
                                                        class="form-control font-monospace" @bind="wgConfig.I1"/></div>
                                                <div class="col-md-6"><label class="form-label">I2</label><input
                                                        class="form-control font-monospace" @bind="wgConfig.I2"/></div>
                                                <div class="col-md-6"><label class="form-label">I3</label><input
                                                        class="form-control font-monospace" @bind="wgConfig.I3"/></div>
                                                <div class="col-md-6"><label class="form-label">I4</label><input
                                                        class="form-control font-monospace" @bind="wgConfig.I4"/></div>
                                                <div class="col-md-6"><label class="form-label">I5</label><input
                                                        class="form-control font-monospace" @bind="wgConfig.I5"/></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </fieldset>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">@successMessage</div>
                }

                @if (canManage && request.Protocols.Count > 0)
                {
                    <div class="d-flex justify-content-end mt-4">
                        <button class="btn btn-primary btn-lg px-5" @onclick="SaveSettings" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Save All Changes
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool isSaving;
    private bool canManage;
    private bool isDropdownOpen;
    private string? errorMessage;
    private string? successMessage;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private readonly UpdateProtocolsSettingsRequest request = new();
    private IReadOnlyList<ProtocolDomainRouteResponse> domainRoutes = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthState != null)
            {
                var state = await AuthState;
                var result = await AuthorizationService.AuthorizeAsync(state.User, AppPermissions.Settings.Manage);
                canManage = result.Succeeded || state.User.IsInRole(AppRoles.Administrator);
            }

            var settings = await ProtocolSettingsService.GetSettingsAsync();
            request.Protocols = settings.Protocols;
            request.MainDomain = settings.MainDomain;
            domainRoutes = await ProtocolDomainService.GetRoutesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load settings: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void AddProtocol(string type)
    {
        isDropdownOpen = false;
        if (type == "hysteria2")
        {
            var settings = new Hysteria2GlobalSettings
            {
                Enabled = true,
                ListenPort = GetNextAvailablePort()
            };
            settings.GenerateSelfSignedCertificate();
            request.Protocols.Add(settings);
        }
        else if (type == "wireguard" && request.Protocols.All(p => p is not WireGuardAmneziaGlobalSettings))
        {
            request.Protocols.Add(new WireGuardAmneziaGlobalSettings { Enabled = true });
        }
        else if (type == "wireguard" && request.Protocols.All(p => p is not WireGuardAmneziaGlobalSettings))
        {
            request.Protocols.Add(new WireGuardAmneziaGlobalSettings { Enabled = true });
        }
    }

    private int GetNextAvailablePort()
    {
        var usedPorts = request.Protocols.OfType<Hysteria2GlobalSettings>().Select(p => p.ListenPort).ToHashSet();
        var port = 4443;
        while (usedPorts.Contains(port)) port++;
        return port;
    }

    private void RemoveProtocol(ProtocolGlobalSettings protocol)
    {
        request.Protocols.Remove(protocol);
    }

    private async Task SaveSettings()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();

        try
        {
            foreach (var protocol in request.Protocols)
            {
                if (protocol is Hysteria2GlobalSettings h2 && h2.Enabled)
                {
                    if (string.IsNullOrWhiteSpace(h2.TlsCertificatePem) || string.IsNullOrWhiteSpace(h2.TlsKeyPem))
                    {
                        errorMessage = $"TLS certificate is missing for Hysteria2 (Port {h2.ListenPort}). Click Regenerate.";
                        isSaving = false;
                        return;
                    }
                }
            }

            await ProtocolSettingsService.UpdateSettingsAsync(request);
            domainRoutes = await ProtocolDomainService.GetRoutesAsync();
            successMessage = "Protocol settings saved successfully. Nodes will be updated automatically.";
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to save settings: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private ProtocolDomainRouteResponse? GetDomainRoute(ProtocolGlobalSettings protocol)
    {
        var index = request.Protocols.IndexOf(protocol);
        return domainRoutes.FirstOrDefault(route => route.ProtocolIndex == index);
    }

    private static string GetRouteAlertClass(ProtocolDomainRouteState state) => state switch
    {
        ProtocolDomainRouteState.Valid => "alert-success",
        ProtocolDomainRouteState.PartialMatch => "alert-warning",
        _ => "alert-danger"
    };

    private static string GetRouteStatusText(ProtocolDomainRouteResponse route) => route.State switch
    {
        ProtocolDomainRouteState.Valid => $"points to {route.NodeName}",
        ProtocolDomainRouteState.PartialMatch => $"partially points to {route.NodeName}",
        ProtocolDomainRouteState.NoRecords => "has no A or AAAA records",
        ProtocolDomainRouteState.UnknownNode => "does not point to a known node",
        ProtocolDomainRouteState.MultipleNodes => "points to multiple nodes",
        ProtocolDomainRouteState.LookupFailed => "could not be resolved",
        _ => route.State.ToString()
    };

}
