@page "/admin/settings/cluster"
@using ShadowVPN2.Components.Pages.Admin.Protocols
@using ShadowVPN2.Data
@using ShadowVPN2.Data.Cluster
@using ShadowVPN2.Entities
@using ShadowVPN2.Infrastructure.Authentication
@attribute [Authorize(Policy = AppPermissions.Settings.View)]
@rendermode InteractiveServer
@inject GlobalConfigurationService GlobalConfigurationService
@inject ClusterSettingsService ClusterSettingsService
@inject IAuthorizationService AuthorizationService

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <NavLink href="/admin/settings" class="list-group-item list-group-item-action" Match="NavLinkMatch.All">
                    General
                </NavLink>
                <NavLink href="/admin/settings/auth" class="list-group-item list-group-item-action">Authorization
                </NavLink>
                <NavLink href="/admin/settings/protocols" class="list-group-item list-group-item-action">Protocols
                </NavLink>
                <NavLink href="/admin/settings/certificates" class="list-group-item list-group-item-action">
                    Certificates
                </NavLink>
                <NavLink href="/admin/settings/cluster" class="list-group-item list-group-item-action active">Cluster
                </NavLink>
            </div>
        </div>
        <div class="col-md-9">
            <h3>Cluster Settings</h3>
            <p class="text-muted">Configure AmneziaWG mesh networking between nodes.</p>

            @if (!_canManage && !_isLoading)
            {
                <div class="alert alert-warning py-2 mb-4">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    You have read-only access to these settings.
                </div>
            }

            @if (_isLoading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (_awgSettings != null)
            {
                <fieldset disabled="@(!_canManage)">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Global Node Domain</h5>
                        </div>
                        <div class="card-body">
                            <input class="form-control" @bind="_globalDomain" placeholder="vpn.example.com"/>
                            <div class="form-text">Common domain for the main node and all nodes. Node-specific domains
                                take precedence.
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Network</h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">Listen Port</label>
                                    <input type="number" class="form-control" @bind="_awgSettings.ListenPort" min="1"
                                           max="65535"/>
                                    <div class="form-text">UDP port for AWG mesh (default: 51820).</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Obfuscation Parameters</h5>
                        </div>
                        <div class="card-body">
                            <AmneziaWgParametersSettings Settings="_awgSettings"/>
                            <div class="row g-3 mt-1">
                                <div class="col-md-3">
                                    <label class="form-label">H1</label>
                                    <input type="number" class="form-control" @bind="_awgSettings.H1"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">H2</label>
                                    <input type="number" class="form-control" @bind="_awgSettings.H2"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">H3</label>
                                    <input type="number" class="form-control" @bind="_awgSettings.H3"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">H4</label>
                                    <input type="number" class="form-control" @bind="_awgSettings.H4"/>
                                </div>
                            </div>
                            <div class="form-text mt-2">AmneziaWG obfuscation parameters. Randomly generated on first
                                setup. All nodes must use the same values.
                            </div>
                        </div>
                    </div>
                </fieldset>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success">@_successMessage</div>
                }

                @if (_canManage)
                {
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-primary" @onclick="SaveSettings" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Save Changes
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _canManage;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _globalDomain;
    private AwgGlobalSettings? _awgSettings;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthState != null)
            {
                var state = await AuthState;
                var result = await AuthorizationService.AuthorizeAsync(state.User, AppPermissions.Settings.Manage);
                _canManage = result.Succeeded || state.User.IsInRole(AppRoles.Administrator);
            }

            var config = await GlobalConfigurationService.GetAsync();
            var clusterSettings = await ClusterSettingsService.GetSettingsAsync();
            _awgSettings = config.AwgSettings;
            _globalDomain = clusterSettings.GlobalDomain;
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to load settings: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveSettings()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;
        StateHasChanged();

        try
        {
            await ClusterSettingsService.UpdateSettingsAsync(new UpdateClusterSettingsRequest
            {
                GlobalDomain = _globalDomain
            });
            await GlobalConfigurationService.UpdateAsync(config => { config.AwgSettings = _awgSettings!; });
            _successMessage = "Cluster settings saved. Nodes will update automatically.";
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to save settings: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

}
