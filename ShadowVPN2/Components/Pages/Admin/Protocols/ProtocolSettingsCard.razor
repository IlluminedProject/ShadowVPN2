@using ShadowVPN2.Data.Protocols
@using ShadowVPN2.Entities
<div class="card mb-4 border-primary">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <span class="badge bg-primary me-2">@Protocol.Protocol</span>
            Port: @Protocol.ListenPort
        </h5>
        @if (CanManage)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="() => OnRemove.InvokeAsync(Protocol)">
                <i class="bi bi-trash"></i>
            </button>
        }
    </div>
    <div class="card-body">
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch"
                   id="enabled-@Protocol.Id" @bind="Protocol.Enabled">
            <label class="form-check-label h5" for="enabled-@Protocol.Id">Enable Protocol</label>
        </div>

        @if (DomainRoute is { State: not ProtocolDomainRouteState.NoDomain })
        {
            <div class="alert @GetRouteAlertClass(DomainRoute.State) py-2">
                <strong>@DomainRoute.Domain</strong>
                <span class="ms-2">@GetRouteStatusText(DomainRoute)</span>
                @if (DomainRoute.ResolvedAddresses.Count > 0)
                {
                    <div class="small mt-1">
                        Resolves to: @string.Join(", ", DomainRoute.ResolvedAddresses)
                    </div>
                }
            </div>
        }

        @ChildContent
    </div>
</div>

@code {
    [Parameter][EditorRequired] public ProtocolGlobalSettings Protocol { get; set; } = null!;
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public ProtocolDomainRouteResponse? DomainRoute { get; set; }
    [Parameter] public EventCallback<ProtocolGlobalSettings> OnRemove { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static string GetRouteAlertClass(ProtocolDomainRouteState state)
    {
        return state switch
        {
            ProtocolDomainRouteState.Valid => "alert-success",
            ProtocolDomainRouteState.PartialMatch => "alert-warning",
            _ => "alert-danger"
        };
    }

    private static string GetRouteStatusText(ProtocolDomainRouteResponse route)
    {
        return route.State switch
        {
            ProtocolDomainRouteState.Valid => $"points to {route.NodeName}",
            ProtocolDomainRouteState.PartialMatch => $"partially points to {route.NodeName}",
            ProtocolDomainRouteState.NoRecords => "has no A or AAAA records",
            ProtocolDomainRouteState.UnknownNode => "does not point to a known node",
            ProtocolDomainRouteState.MultipleNodes => "points to multiple nodes",
            ProtocolDomainRouteState.LookupFailed => "could not be resolved",
            _ => route.State.ToString()
        };
    }

}
