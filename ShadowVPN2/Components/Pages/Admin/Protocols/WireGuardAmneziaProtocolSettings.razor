@using ShadowVPN2.Entities
<div class="ms-4 p-3 border-start">
    <div class="mb-3">
        <label class="form-label">Main Domain</label>
        <input class="form-control" @bind="Settings.MainDomain" placeholder="vpn.example.com"/>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label">Listen Port</label>
            <input type="number" class="form-control" @bind="Settings.ListenPort" min="1" max="65535"/>
        </div>
        <div class="col-md-4">
            <label class="form-label">MTU</label>
            <input type="number" class="form-control" @bind="Settings.Mtu" min="576" max="9000"/>
        </div>
        <div class="col-md-4">
            <label class="form-label">Server VPN Address</label>
            <input class="form-control" @bind="Settings.ServerAddress"/>
        </div>
    </div>
    <div class="alert @(Settings.IsAmneziaWg ? "alert-warning" : "alert-success") py-2">
        <strong>Ordinary WireGuard compatibility:</strong>
        @(Settings.IsAmneziaWg ? "No. AmneziaWG parameters are configured." : "Yes. No AmneziaWG parameters are configured.")
    </div>
    <h6>AmneziaWG parameters</h6>
    <AmneziaWgParametersSettings Settings="Settings"/>
    <div class="row g-3 mt-1">
        <div class="col-md-3"><label class="form-label">H1</label><input class="form-control" @bind="Settings.H1"/>
        </div>
        <div class="col-md-3"><label class="form-label">H2</label><input class="form-control" @bind="Settings.H2"/>
        </div>
        <div class="col-md-3"><label class="form-label">H3</label><input class="form-control" @bind="Settings.H3"/>
        </div>
        <div class="col-md-3"><label class="form-label">H4</label><input class="form-control" @bind="Settings.H4"/>
        </div>
    </div>
</div>

@code {
    [Parameter][EditorRequired] public WireGuardAmneziaGlobalSettings Settings { get; set; } = null!;
}
