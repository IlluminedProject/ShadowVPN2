@using System.Text
@inherits ProtocolSubscriptionViewBase<ShadowVPN2.Data.Subscription.WireGuardConnectionInfo>

<div class="accordion-item mb-3 border rounded">
    <h2 class="accordion-header">
        <button class="accordion-button bg-light fw-bold" type="button" data-bs-toggle="collapse"
                data-bs-target="@CollapseId" aria-expanded="true">
            WireGuard / AmneziaWG
        </button>
    </h2>
    <div id="@CollapseId" class="accordion-collapse collapse show">
        <div class="accordion-body">
            @foreach (var endpoint in GetEndpoints())
            {
                <h5 class="border-bottom pb-2 mt-3">@endpoint.Name</h5>
                <a class="btn btn-primary mb-2" download="shadowvpn.conf" href="@DataUrl(endpoint.Connection.Config)">Download
                    configuration</a>
                <pre class="bg-light border rounded p-3 small">@endpoint.Connection.Config</pre>
            }
        </div>
    </div>
</div>

@code {
    private string CollapseId => $"collapse-{Subscription.Protocol.ToLowerInvariant()}";

    private static string DataUrl(string value)
    {
        return $"data:text/plain;charset=utf-8;base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(value))}";
    }

}
