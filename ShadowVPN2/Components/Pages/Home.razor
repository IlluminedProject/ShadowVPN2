@page "/"
@using RandomFriendlyNameGenerator
@using ShadowVPN2.Data
@using ShadowVPN2.Data.Cluster
@using ShadowVPN2.Data.Protocols
@using ShadowVPN2.Data.Certificates
@using ShadowVPN2.Infrastructure.Authentication
@attribute [Authorize(Policy = AppPermissions.Nodes.View)]
@implements IDisposable
@inject NodeService NodeService
@inject ClusterService ClusterService
@inject ProtocolDomainService ProtocolDomainService
@inject ManagedCertificateService ManagedCertificateService
@inject IJSRuntime JSRuntime
@inject IAuthorizationService AuthorizationService
@rendermode InteractiveServer

<PageTitle>Nodes - ShadowVPN2</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-2">
            <h1>Nodes</h1>
            <span class="badge bg-primary">Live</span>
        </div>
        <AuthorizeView Policy="@AppPermissions.Nodes.Manage">
            <button class="btn btn-primary" @onclick="OpenAddNodeModal">
                <i class="bi bi-plus-lg me-1"></i>Add Node
            </button>
        </AuthorizeView>
    </div>

    @if (_nodes == null)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!_nodes.Any())
    {
        <div class="alert alert-info" role="alert">
            No nodes found. Go to <a href="/setup">Setup</a> to add your first node.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 50px;">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Domain</th>
                    <th scope="col">Public IP</th>
                    <th scope="col">AWG Mesh IP</th>
                    <th scope="col">AWG Public Key</th>
                    <th scope="col">Protocol Domains</th>
                    <th scope="col">Status</th>
                    <th scope="col"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var node in _nodes)
                {
                    <tr>
                        <td>@node.Number</td>
                        <td>
                            <strong>@node.Name</strong>
                        </td>
                        <td>
                            <code>@(string.IsNullOrEmpty(node.Domain) ? "—" : node.Domain)</code>
                            @if (node.DomainStatus is { State: not DomainValidationState.NoDomain })
                            {
                                <div class="small text-muted">@GetDomainStatusText(node.DomainStatus.State)</div>
                            }
                        </td>
                        <td>
                            <code>@(node.PublicIpv4 ?? node.PublicIpv6 ?? "—")</code>
                        </td>
                        <td>
                            <code>@node.AwgMeshIp</code>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(node.AwgPublicKey))
                            {
                                <code
                                    title="@node.AwgPublicKey">@(node.AwgPublicKey.Length > 12 ? node.AwgPublicKey[..12] + "..." : node.AwgPublicKey)</code>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @foreach (var route in GetProtocolRoutes(node.NodeId))
                            {
                                <div><code>@route.Domain</code></div>
                            }
                            @if (!GetProtocolRoutes(node.NodeId).Any())
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (node.IsPending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Joined</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (_canManage && !node.IsPending)
                            {
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => OpenEditNodeModal(node)">
                                    Edit
                                </button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_showAddNodeModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Node</h5>
                    <button type="button" class="btn-close" @onclick="CloseAddNodeModal"></button>
                </div>
                <div class="modal-body">
                    @if (_generatedToken == null)
                    {
                        <div class="mb-3">
                            <label class="form-label">Node Name</label>
                            <div class="input-group">
                                <input type="text" class="form-control" @bind="_newNodeName"
                                       placeholder="e.g. eu-west-2"/>
                                <button class="btn btn-outline-secondary" type="button" @onclick="RandomizeName">
                                    Random
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Node Domain (optional)</label>
                            <input type="text" class="form-control" @bind="_newNodeDomain"
                                   placeholder="node.example.com"/>
                        </div>

                        @if (!string.IsNullOrEmpty(_addNodeError))
                        {
                            <div class="alert alert-danger">@_addNodeError</div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-success mb-3">
                            Token generated. Set this as the <code>JoinToken</code> environment variable on the new
                            node.
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Join Token</label>
                            <div class="input-group">
                                <textarea class="form-control font-monospace" rows="4"
                                          readonly>@_generatedToken</textarea>
                                <button class="btn btn-outline-secondary" type="button" @onclick="CopyToken">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (_generatedToken == null)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="CloseAddNodeModal">Cancel</button>
                        <button type="button" class="btn btn-primary" @onclick="GenerateToken"
                                disabled="@_isGenerating">
                            @if (_isGenerating)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Generate Token
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="CloseAddNodeModal">Done</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_editingNode != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Network: @_editingNode.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditNodeModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Node Domain</label>
                        <input class="form-control" @bind="_editingDomain" placeholder="node.example.com"/>
                        <div class="form-text">Leave empty to address this node by its public IP.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="text-muted small">Public IPv4</div>
                            <code>@(_editingNode.PublicIpv4 ?? "—")</code>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Public IPv6</div>
                            <code>@(_editingNode.PublicIpv6 ?? "—")</code>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small mb-1">Internal addresses</div>
                        @if (_editingNode.InternalAddresses.Count == 0)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            @foreach (var address in _editingNode.InternalAddresses)
                            {
                                <code class="me-2">@address</code>
                            }
                        }
                    </div>

                    @if (_editingNode.DomainStatus != null)
                    {
                        <div class="alert @GetDomainAlertClass(_editingNode.DomainStatus.State) mb-0">
                            <strong>DNS: @GetDomainStatusText(_editingNode.DomainStatus.State)</strong>
                            @if (_editingNode.DomainStatus.ResolvedAddresses.Count > 0)
                            {
                                <div class="small mt-1">
                                    Resolves to: @string.Join(", ", _editingNode.DomainStatus.ResolvedAddresses)
                                </div>
                            }
                        </div>
                    }

                    <div class="mt-3">
                        <div class="text-muted small mb-1">Protocol domains resolving to this node</div>
                        @if (!GetProtocolRoutes(_editingNode.NodeId).Any())
                        {
                            <span>—</span>
                        }
                        else
                        {
                            @foreach (var route in GetProtocolRoutes(_editingNode.NodeId))
                            {
                                <div><code>@route.Domain</code> <span class="text-muted">@route.Protocol</span></div>
                            }
                        }
                    </div>

                    @{ var managedCertificate = ManagedCertificateService.GetForNode(_editingNode.NodeId); }
                    <div class="mt-3">
                        <div class="text-muted small mb-1">Managed certificate</div>
                        @if (managedCertificate == null)
                        {
                            <span>Not issued</span>
                        }
                        else
                        {
                            <div>Expires: @managedCertificate.NotAfter.ToLocalTime().ToString("g")</div>
                            @foreach (var domain in managedCertificate.Domains)
                            {
                                <code class="me-2">@domain</code>
                            }
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_editNodeError))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@_editNodeError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CheckEditingNodeDomain"
                            disabled="@_isEditingNode">
                        Check DNS
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseEditNodeModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveEditingNode" disabled="@_isEditingNode">
                        @if (_isEditingNode)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<NodeResponse>? _nodes;
    private NodeService.NodeSubscription? _subscription;

    private bool _showAddNodeModal;
    private string _newNodeName = "";
    private string? _newNodeDomain;
    private string? _generatedToken;
    private string? _addNodeError;
    private bool _isGenerating;
    private bool _canManage;
    private NodeResponse? _editingNode;
    private string? _editingDomain;
    private string? _editNodeError;
    private bool _isEditingNode;
    private IReadOnlyList<ProtocolDomainRouteResponse> _protocolRoutes = [];

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            _canManage = (await AuthorizationService.AuthorizeAsync(state.User, AppPermissions.Nodes.Manage)).Succeeded ||
                         state.User.IsInRole(AppRoles.Administrator);
        }

        UpdateNodesFromResponse(await NodeService.GetNodeResponsesAsync());
        _protocolRoutes = await ProtocolDomainService.GetRoutesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _subscription = await NodeService.SubscribeAsync(OnNodesUpdated);
            var latest = await _subscription.GetCurrentNodesAsync();
            UpdateNodes(latest);
            StateHasChanged();
        }
    }

    private Task OnNodesUpdated(IReadOnlyList<NodeResponse> nodes)
    {
        return InvokeAsync(async () =>
        {
            UpdateNodesFromResponse(nodes);
            _protocolRoutes = await ProtocolDomainService.GetRoutesAsync();
            StateHasChanged();
        });
    }

    private void UpdateNodesFromResponse(IEnumerable<NodeResponse> nodes)
    {
        _nodes = [.. nodes.OrderBy(n => n.Number)];
    }

    private void UpdateNodes(IEnumerable<NodeResponse> nodes)
    {
        UpdateNodesFromResponse(nodes);
    }

    private void OpenAddNodeModal()
    {
        _showAddNodeModal = true;
        _generatedToken = null;
        _addNodeError = null;
        _newNodeDomain = null;
        RandomizeName();
    }

    private void CloseAddNodeModal()
    {
        _showAddNodeModal = false;
    }

    private void RandomizeName()
    {
        _newNodeName = NameGenerator.Identifiers.Get(1, separator: "-").FirstOrDefault()?.ToLower() ?? "new-node";
    }

    private async Task GenerateToken()
    {
        if (string.IsNullOrWhiteSpace(_newNodeName))
        {
            _addNodeError = "Node name is required.";
            return;
        }

        _isGenerating = true;
        _addNodeError = null;
        StateHasChanged();

        try
        {
            _generatedToken = await ClusterService.GenerateJoinTokenAsync(
                _newNodeName.Trim(),
                string.IsNullOrWhiteSpace(_newNodeDomain) ? null : _newNodeDomain.Trim());
        }
        catch (Exception ex)
        {
            _addNodeError = "Failed to generate token: " + ex.Message;
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private async Task CopyToken()
    {
        if (_generatedToken != null)
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _generatedToken);
    }

    private void OpenEditNodeModal(NodeResponse node)
    {
        _editingNode = node;
        _editingDomain = node.Domain;
        _editNodeError = null;
    }

    private void CloseEditNodeModal()
    {
        _editingNode = null;
    }

    private async Task SaveEditingNode()
    {
        if (_editingNode == null) return;
        _isEditingNode = true;
        _editNodeError = null;
        try
        {
            _editingNode = await NodeService.UpdateDomainAsync(_editingNode.NodeId, _editingDomain);
            _editingDomain = _editingNode.Domain;
            await ReloadNodesAsync();
        }
        catch (Exception ex)
        {
            _editNodeError = ex.Message;
        }
        finally
        {
            _isEditingNode = false;
        }
    }

    private async Task CheckEditingNodeDomain()
    {
        if (_editingNode == null) return;
        _isEditingNode = true;
        _editNodeError = null;
        try
        {
            if (!string.Equals(_editingDomain?.Trim(), _editingNode.Domain, StringComparison.OrdinalIgnoreCase))
                _editingNode = await NodeService.UpdateDomainAsync(_editingNode.NodeId, _editingDomain);
            else
                _editingNode.DomainStatus = await NodeService.CheckDomainAsync(_editingNode.NodeId);
            _editingDomain = _editingNode.Domain;
            await ReloadNodesAsync();
        }
        catch (Exception ex)
        {
            _editNodeError = ex.Message;
        }
        finally
        {
            _isEditingNode = false;
        }
    }

    private async Task ReloadNodesAsync()
    {
        UpdateNodesFromResponse(await NodeService.GetNodeResponsesAsync());
        _protocolRoutes = await ProtocolDomainService.GetRoutesAsync();
    }

    private IEnumerable<ProtocolDomainRouteResponse> GetProtocolRoutes(Guid nodeId)
    {
        return _protocolRoutes.Where(route => route.Enabled && route.NodeId == nodeId &&
                                              route.State is ProtocolDomainRouteState.Valid or
                                                  ProtocolDomainRouteState.PartialMatch);
    }

    private static string GetDomainAlertClass(DomainValidationState state) => state switch
    {
        DomainValidationState.Valid => "alert-success",
        DomainValidationState.NoDomain => "alert-secondary",
        DomainValidationState.PublicIpUnknown => "alert-warning",
        DomainValidationState.PartialMatch => "alert-warning",
        _ => "alert-danger"
    };

    private static string GetDomainStatusText(DomainValidationState state) => state switch
    {
        DomainValidationState.Valid => "domain points to this node",
        DomainValidationState.PartialMatch => "only some DNS records point to this node",
        DomainValidationState.NoDomain => "domain is not configured",
        DomainValidationState.PublicIpUnknown => "public IP is not known yet",
        DomainValidationState.NoRecords => "domain has no A or AAAA records",
        DomainValidationState.Mismatch => "domain points to another address",
        DomainValidationState.LookupFailed => "DNS lookup failed",
        _ => state.ToString()
    };

    public void Dispose()
    {
        _subscription?.Dispose();
    }

}
