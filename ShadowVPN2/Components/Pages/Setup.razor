@page "/setup"
@using System.Net
@using RandomFriendlyNameGenerator
@using ShadowVPN2.Data
@rendermode InteractiveServer
@layout SetupLayout
@attribute [AllowAnonymous]
@inject NavigationManager NavigationManager
@inject SetupService SetupService
@inject IJSRuntime JsRuntime

@if (_currentStep == 1)
{
    <h4>Step 1: Network Information</h4>
    <p>Please confirm your server's network details.</p>

    <div class="mb-3">
        <label class="form-label">Node Domain (optional)</label>
        <div class="input-group">
            <input type="text" class="form-control" @bind="_nodeDomain"
                   placeholder="node.example.com"/>
            <button class="btn btn-outline-secondary" type="button" @onclick="LookupPublicIp"
                    disabled="@_isLookingUpIp">
                @if (_isLookingUpIp)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span>Refresh IP</span>
                }
            </button>
        </div>
        <div class="form-text">Leave empty to expose this node by its public IP. Public certificates require a domain.
        </div>
        @if (!string.IsNullOrEmpty(_publicIp))
        {
            <div class="form-text">Detected public IP: <code>@_publicIp</code></div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label">Node Name</label>
        <div class="input-group">
            <input type="text" class="form-control" @bind="_nodeNameInput" placeholder="@_nodeNamePlaceholder"/>
            <button class="btn btn-outline-secondary" type="button" @onclick="GenerateRandomNodeName">
                Random Name
            </button>
        </div>
        <div class="form-text">A friendly name for this server in your cluster.</div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            @((MarkupString)_errorMessage)
        </div>
    }

    <button class="btn btn-primary w-100" @onclick="NextStep" disabled="@_isProcessing">
        @if (_isProcessing)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        }
        else
        {
            <span>Continue</span>
        }
    </button>
}
else if (_currentStep == 2)
{
    <h4>Step 2: Authentication</h4>
    <p>Choose how users will log in. You can change this later in Settings.</p>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_useLocalLogin ? "active" : "")" type="button"
                    @onclick="() => { _useLocalLogin = true; _useOidc = false; }">
                Local Login
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_useOidc ? "active" : "")" type="button"
                    @onclick="() => { _useOidc = true; _useLocalLogin = false; }">
                OAuth2 / OpenID Connect
            </button>
        </li>
    </ul>

    @if (_useLocalLogin)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Administrator Account</h5>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" @bind="_email"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" class="form-control" @bind="_password"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirm Password</label>
                    <input type="password" class="form-control" @bind="_confirmPassword"/>
                </div>
            </div>
        </div>
    }

    @if (_useOidc)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">OIDC Provider</h5>
                <div class="alert alert-info py-2 mb-3">The first user to log in via this provider will become the
                    administrator.
                </div>

                <div class="mb-3">
                    <label class="form-label">Display Name</label>
                    <input type="text" class="form-control" @bind="_oidcDisplayName"
                           placeholder="e.g. Corporate Login"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">OpenID Configuration Issuer URL</label>
                    <input type="url" class="form-control" @bind="_oidcAuthority"
                           placeholder="e.g. https://accounts.google.com"/>
                    <div class="form-text">The base issuer URL. The discovery document will be fetched from <code>/.well-known/openid-configuration</code>.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Client ID</label>
                    <input type="text" class="form-control" @bind="_oidcClientId"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Client Secret</label>
                    <input type="password" class="form-control" @bind="_oidcClientSecret"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Redirect URI</label>
                    <div class="input-group">
                        <input type="text" class="form-control bg-light"
                               value="@(NavigationManager.BaseUri.TrimEnd('/') + "/signin-OIDC")" readonly/>
                        <button class="btn btn-outline-secondary" type="button"
                                @onclick='() => CopyToClipboard(NavigationManager.BaseUri.TrimEnd("/").ToString() + "/signin-OIDC")'>
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                    <div class="form-text">Configure this URL in your identity provider's allowed redirect URIs.</div>
                </div>

                <button class="btn btn-outline-info" type="button" @onclick="TestOidcConnection"
                        disabled="@_isTestingOidc">
                    @if (_isTestingOidc)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> Testing...</span>
                    }
                    else
                    {
                        <span>Test Provider Configuration</span>
                    }
                </button>

                @if (!string.IsNullOrEmpty(_oidcTestMessage))
                {
                    <div class="mt-2 small text-@(_oidcTestSuccess ? "success" : "danger")">
                        @((MarkupString)_oidcTestMessage)
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            @((MarkupString)_errorMessage)
        </div>
    }

    <button class="btn btn-primary w-100" @onclick="NextStep" disabled="@_isProcessing">
        @if (_isProcessing)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        }
        else
        {
            <span>Continue</span>
        }
    </button>
}
else if (_currentStep == 3)
{
    <h4>Step 3: Save Root Certificate</h4>

    <div class="alert alert-warning">
        <h5 class="alert-heading">Important Security Notice</h5>
        <p>Before completing the setup, please download the <strong>Root CA Certificate</strong> (root-ca.pfx).</p>
        <p>This certificate contains the private key needed to add new nodes to your ShadowVPN2 cluster in the future.
            Once you complete the setup, this file will be permanently deleted from this server for security
            reasons.</p>
        <hr>
        <p class="mb-0">Keep this file in a secure and secret location!</p>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            @((MarkupString)_errorMessage)
        </div>
    }

    <div class="d-flex justify-content-between align-items-center">
        <a href="/api/setup/root-ca" class="btn btn-outline-success btn-lg" target="_blank"
           @onclick="() => _hasDownloadedCert = true">
            Download root-ca.pfx
        </a>

        <button class="btn btn-danger btn-lg" @onclick="FinishSetup" disabled="@(_isProcessing || !_hasDownloadedCert)">
            @if (_isProcessing)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            else
            {
                <span>Finish &amp; Delete File</span>
            }
        </button>
    </div>
}

@code {
    private int _currentStep = 1;

    private string _hostname = string.Empty;
    private string _publicIp = string.Empty;
    private string _nodeDomain = string.Empty;
    private string _nodeNameInput = string.Empty;
    private string _nodeNamePlaceholder = string.Empty;
    private bool _isLookingUpIp;

    // Step 2
    private bool _useLocalLogin = true;
    private bool _useOidc;
    private string _oidcDisplayName = "Login with OAuth";
    private string _oidcAuthority = string.Empty;
    private string _oidcClientId = string.Empty;
    private string _oidcClientSecret = string.Empty;
    private bool _isTestingOidc;
    private string _oidcTestMessage = string.Empty;
    private bool _oidcTestSuccess;

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;

    // Step 3
    private bool _hasDownloadedCert;

    private string _errorMessage = string.Empty;
    private bool _isProcessing;

    private void GenerateRandomNodeName()
    {
        _nodeNameInput = NameGenerator.Identifiers.Get(1, separator: "-").FirstOrDefault()?.ToLower() ?? "random-node";
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.BaseUri);
        _hostname = uri.Host;
        if (!string.Equals(_hostname, "localhost", StringComparison.OrdinalIgnoreCase) &&
            !IPAddress.TryParse(_hostname, out _))
            _nodeDomain = _hostname;
        _nodeNamePlaceholder = NameGenerator.Identifiers.Get(1, separator: "-").FirstOrDefault()?.ToLower() ?? "primary-node";

        await LookupPublicIp();
    }

    private async Task LookupPublicIp()
    {
        _isLookingUpIp = true;
        StateHasChanged();

        var ip = await SetupService.GetPublicIpAsync();
        _publicIp = ip ?? string.Empty;

        _isLookingUpIp = false;
    }

    private async Task TestOidcConnection()
    {
        _isTestingOidc = true;
        _oidcTestMessage = string.Empty;
        StateHasChanged();

        var discoveryUrl = _oidcAuthority.TrimEnd('/') + "/.well-known/openid-configuration";
        var success = await SetupService.TestOidcConnectionAsync(_oidcAuthority);
        _oidcTestSuccess = success;
        _oidcTestMessage = success
            ? "Successfully connected to OIDC discovery endpoint!"
            : $"Failed to connect to <code>{discoveryUrl}</code>";

        _isTestingOidc = false;
    }

    private async Task NextStep()
    {
        _errorMessage = string.Empty;

        if (_currentStep == 1)
        {
            _isProcessing = true;
            try
            {
                var request = new NodeSetupRequest
                {
                    Domain = string.IsNullOrWhiteSpace(_nodeDomain) ? null : _nodeDomain.Trim(),
                    NodeName = string.IsNullOrWhiteSpace(_nodeNameInput) ? _nodeNamePlaceholder : _nodeNameInput
                };

                await SetupService.ConfigureNodeAsync(request);
                _currentStep++;
            }
            catch (Exception ex)
            {
                _errorMessage = ex.Message;
            }
            finally
            {
                _isProcessing = false;
            }
        }
        else if (_currentStep == 2)
        {
            if (_useLocalLogin && _password != _confirmPassword)
            {
                _errorMessage = "Passwords do not match.";
                return;
            }

            _isProcessing = true;
            try
            {
                if (_useLocalLogin)
                {
                    await SetupService.ConfigureLocalAuthAsync(new LocalAuthSetupRequest
                    {
                        Email = _email,
                        Password = _password
                    });
                }

                if (_useOidc)
                {
                    await SetupService.ConfigureOidcAsync(new OidcAuthSetupRequest
                    {
                        SchemeName = "OIDC",
                        DisplayName = _oidcDisplayName,
                        Authority = _oidcAuthority,
                        ClientId = _oidcClientId,
                        ClientSecret = _oidcClientSecret
                    });
                }

                _currentStep++;
            }
            catch (Exception ex)
            {
                _errorMessage = ex.Message;
            }
            finally
            {
                _isProcessing = false;
            }
        }
    }

    private async Task FinishSetup()
    {
        _errorMessage = string.Empty;
        _isProcessing = true;

        try
        {
            await SetupService.FinishSetupAsync();
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task CopyToClipboard(string text)
    {
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

}
