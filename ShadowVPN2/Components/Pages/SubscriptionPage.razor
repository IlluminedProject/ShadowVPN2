@page "/s/{SubscriptionId:guid}"
@using System.Text
@using ShadowVPN2.Data.Subscription

@attribute [AllowAnonymous]
@layout PublicLayout
@inject SubscriptionService SubscriptionService
@rendermode InteractiveServer

<PageTitle>Connection Setup - ShadowVPN2</PageTitle>

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted">Loading your connection details...</p>
    </div>
}
else if (_response == null)
{
    <div class="text-center py-5">
        <i class="bi bi-x-circle text-danger" style="font-size: 3rem;"></i>
        <h3 class="mt-3">Invalid Link</h3>
        <p class="text-muted">This subscription link is invalid or has been removed.</p>
    </div>
}
else
{
    <div class="text-center mb-4">
        <h2 class="fw-bold">@_response.ClientName</h2>
        <p class="text-muted">Available connection hosts</p>
    </div>

    @if (!_response.Protocols.Any())
    {
        <div class="alert alert-warning">
            No connection protocols are enabled for this client. Please contact your administrator.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var protocol in _response.Protocols)
            {
                @foreach (var endpoint in protocol.Endpoints)
                {
                    var key = $"{protocol.Protocol}:{endpoint.Address}";
                    <div class="list-group-item d-flex justify-content-between align-items-center gap-3">
                        <div class="text-break">
                            <div class="fw-semibold">@endpoint.Name</div>
                            <div class="text-muted small">@endpoint.Address</div>
                        </div>
                        @if (endpoint.Connection is WireGuardConnectionInfo wireGuard)
                        {
                            <a class="btn btn-outline-primary text-nowrap" download="shadowvpn.conf"
                               href="@CreateConfigDataUrl(wireGuard)">
                                <i class="bi bi-download me-1"></i>
                                Download
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary text-nowrap" type="button"
                                    @onclick="() => CopyConnectionAsync(protocol, endpoint, _response.ClientName)">
                                <i class="bi bi-clipboard me-1"></i>
                                @(key == _copiedKey ? "Copied" : "Copy")
                            </button>
                        }
                    </div>
                }
            }
        </div>

        <div class="text-center mt-4">
            <p class="text-muted small">
                Keep these details safe. Do not share your connection link with others.
            </p>
        </div>

        <ServerLatencyView Protocols="_response.Protocols"/>
    }
}

@code {
    [Parameter] public Guid SubscriptionId { get; set; }

    private SubscriptionResponse? _response;
    private bool _loading = true;
    private string? _copiedKey;

    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;

    private static string CreateConfigDataUrl(WireGuardConnectionInfo info)
    {
        return $"data:text/plain;charset=utf-8;base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(info.CreateConfig()))}";
    }

    private async Task CopyConnectionAsync(ProtocolSubscription protocol, SubscriptionEndpoint endpoint,
        string clientName)
    {
        var text = endpoint.Connection switch
        {
            Hysteria2ConnectionInfo info => info.CreateShareUrl(clientName),
            WireGuardConnectionInfo info => info.CreateShareUrl(),
            _ => throw new InvalidOperationException($"Unsupported protocol: {protocol.Protocol}")
        };
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        _copiedKey = $"{protocol.Protocol}:{endpoint.Address}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _response = await SubscriptionService.GetSubscriptionAsync(SubscriptionId);
        }
        finally
        {
            _loading = false;
        }
    }
}
