@page "/Account/DeviceLogin"
@layout AccountLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@using ShadowVPN2.Data
@using ShadowVPN2.Entities.Auth
@using ShadowVPN2.Infrastructure.Authentication
@implements IAsyncDisposable

<PageTitle>Device login</PageTitle>

<div class="text-center">
    <h1 class="mb-4">Log in with device code</h1>
    <div class="alert @(_errorMessage is null ? "alert-info" : "alert-danger")">@_statusMessage</div>
    @if (Authorization is not null)
    {
        <div>
            <p>Open this address on another device:</p>
            <p><a href="@(Authorization.VerificationUriComplete ?? Authorization.VerificationUri)" target="_blank"
                  rel="noopener">@Authorization.VerificationUri</a></p>
            <p class="mb-1">Enter this code:</p>
            <strong class="fs-3">@Authorization.UserCode</strong>
        </div>
    }
    <div class="mt-4">
        <a href="/Account/Login" data-enhance-nav="false" class="btn btn-link">Back to login</a>
    </div>
</div>

@code {
    [Inject] private DeviceAuthorizationService DeviceService { get; set; } = default!;
    [Inject] private DeviceAuthorizationNotificationService DeviceNotifications { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [SupplyParameterFromQuery] private string? TransactionId { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [PersistentState] public DeviceAuthorizationStartResponse? Authorization { get; set; }
    [PersistentState] public string? CorrelationSecret { get; set; }

    private string? _errorMessage;
    private string _statusMessage = "Preparing device authorization...";
    [PersistentState] public DateTime ExpiresAtUtc { get; set; }
    private IDisposable? _notificationSubscription;

    protected override async Task OnInitializedAsync()
    {
        if (Authorization is not null)
            return;

        if (string.IsNullOrWhiteSpace(TransactionId))
        {
            _errorMessage = "The device authorization transaction is missing.";
            _statusMessage = _errorMessage;
            return;
        }

        CorrelationSecret ??= HttpContext?.Request.Cookies[DeviceAuthorizationService.CorrelationCookie];
        if (string.IsNullOrWhiteSpace(CorrelationSecret))
        {
            _errorMessage = "The device authorization session is missing.";
            _statusMessage = _errorMessage;
            return;
        }

        try
        {
            Authorization = await DeviceService.GetStartResponseAsync(TransactionId, CorrelationSecret,
                CancellationToken.None);
            ExpiresAtUtc = DateTime.UtcNow.AddSeconds(Authorization.ExpiresIn);
            _statusMessage = "Waiting for confirmation...";
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            _statusMessage = _errorMessage;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Authorization is null || HttpContext is not null)
            return;

        _notificationSubscription = DeviceNotifications.Subscribe(Authorization.TransactionId,
            status => _ = InvokeAsync(() => HandleStatusAsync(status)));
        await DeviceService.BeginProcessingAsync(Authorization.TransactionId, CorrelationSecret!,
            CancellationToken.None);
        await HandleStatusAsync(await DeviceService.GetStatusAsync(Authorization.TransactionId,
                CorrelationSecret!, CancellationToken.None));
    }

    private async Task HandleStatusAsync(DeviceAuthorizationStatus status)
    {
        switch (status)
        {
            case DeviceAuthorizationStatus.Processing:
                _statusMessage = "Waiting for confirmation from the identity provider...";
                await InvokeAsync(StateHasChanged);
                break;
            case DeviceAuthorizationStatus.Completed:
                _statusMessage = "Login confirmed. Completing sign-in...";
                await InvokeAsync(() => NavigationManager.NavigateTo(
                        $"/api/auth/device/complete/{Authorization!.TransactionId}?returnUrl=" +
                    Uri.EscapeDataString(ReturnUrl ?? "/"), true));
                break;
            case DeviceAuthorizationStatus.Expired:
                _errorMessage = "The device authorization code expired.";
                _statusMessage = _errorMessage;
                await InvokeAsync(StateHasChanged);
                break;
            case DeviceAuthorizationStatus.Denied:
            case DeviceAuthorizationStatus.Failed:
                _errorMessage = "Device authorization failed.";
                _statusMessage = _errorMessage;
                await InvokeAsync(StateHasChanged);
                break;
        }
    }

    public ValueTask DisposeAsync()
    {
        _notificationSubscription?.Dispose();
        return ValueTask.CompletedTask;
    }

}
